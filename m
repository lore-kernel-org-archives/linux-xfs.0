+
+# Create and save sha256sum
+# arg1 FS to generate sha256
+# arg2 File name to save the sha256 output
+_save_checksum()
+{
+=09local i=3D0
+=09>$2
+=09cd $1
+=09for i in `find . -type f`; do sha256sum $i >> $2; done
+=09cd $OLDPWD
+}
+
+# Verify the sha256sum for a FS
+# arg1 FS to be tested
+# arg2 sha256 file
+_verify_checksum()
+{
+=09cd $1
+=09[ -f $2 ] || _fail "checksum file $2 not found"
+=09sha256sum -c $2 | grep "FAILED"
+=09cd $OLDPWD
+}
+
+# Create a snapshot
+# arg1 dest dir
+# Return snapshot name in the SNAPNAME
+_create_snap()
+{
+=09local x
+=09[ -d $1 ] || _fail "Destination dir $1 not present"
+=09SNAPNAME=3D`mktemp -u $SCRATCH_MNT/snap.XXXXXX`
+=09btrfs subvolume snapshot $1 $SNAPNAME > /dev/null || _fail "snapsho=
t create failed"
+}
+
+# Reads and writes new data but does not allocate new blocks
+# arg1 FS to be modified
+_read_modify_write()
+{
+=09local i
+=09local FSIZE
+=09for i in `find $1 -type f`
+=09do
+=09=09FSIZE=3D`stat -t $i | cut -d" " -f2`
+=09=09dd if=3D$i of=3D/dev/null obs=3D$FSIZE count=3D1 status=3Dnoxfer=
 2>/dev/null &
+=09=09dd if=3D/dev/urandom of=3D$i obs=3D$FSIZE count=3D1 status=3Dnox=
fer 2>/dev/null &
+=09done
+=09wait $!
+}
+
+# Fills the allocated blocks
+# arg1 FS in question
+_fill_blk()
+{
+=09local FSIZE
+=09local BLKS
+=09local NBLK
+=09local FALLOC
+=09local WS
+
+=09for i in `find /$1 -type f`
+=09do
+=09=09FSIZE=3D`stat -t $i | cut -d" " -f2`
+=09=09BLKS=3D`stat -c "%B" $i`
+=09=09NBLK=3D`stat -c "%b" $i`
+=09=09FALLOC=3D$(($BLKS * $NBLK))
+=09=09WS=3D$(($FALLOC - $FSIZE))
+=09=09dd if=3D/dev/urandom of=3D$i oseek=3D$FSIZE obs=3D$WS count=3D1 =
status=3Dnoxfer 2>/dev/null &
+=09done
+=09wait $!
+}
+
+
+# Append a random size to the files
+# arg1 : FS in question
+_append_file()
+{
+=09local FSIZE
+=09local X
+=09local N
+=09local i
+=09N=3D0
+=09for i in `find $1 -type f`
+=09do
+=09=09if [ $N =3D=3D 0 ]; then
+=09=09=09X=3D$i
+=09=09=09FSIZE=3D`stat -t $X | cut -d" " -f2`
+=09=09=09dd if=3D$X of=3D$X seek=3D1 bs=3D$FSIZE obs=3D$FSIZE count=3D=
1 status=3Dnoxfer 2>/dev/null &
+=09=09=09N=3D$(($N+1))
+=09=09=09continue
+=09=09fi
+=09=09FSIZE=3D`stat -t $i | cut -d" " -f2`
+=09=09dd if=3D$X of=3D$i seek=3D1 bs=3D$FSIZE obs=3D$FSIZE count=3D1 s=
tatus=3Dnoxfer 2>/dev/null &
+=09=09X=3D$i
+=09done
+=09wait $!
+}
