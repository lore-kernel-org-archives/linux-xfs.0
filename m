+#! /bin/bash
+# FS QA Test No. 032
+#
+# cross check mkfs detection of foreign filesystems
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2000-2002 Silicon Graphics, Inc.  All Rights Reserved.
