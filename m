+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux XFS
+_require_scratch
+
+populate()
+{
+=09# "faststart" lets us effectively skip (re-)population
+=09[ "X$faststart" !=3D "X" ] && rm -f $SCRATCH_MNT/F*
+
+=09# create many small files using most available space
+=09echo "creating small files..."
+=09i=3D0
+=09while [ $i -le $files -a "X$faststart" =3D "X" ]; do
+=09=09file=3D$SCRATCH_MNT/f$i
+=09=09xfs_io -f -d -c 'pwrite -b 64k 0 64k' $file >/dev/null
+=09=09let i=3D$i+1
+=09done
+
+=09# remove every second file, freeing up lots of space
+=09echo "removing small files..."
+=09i=3D1
+=09while [ $i -le $files -a "X$faststart" =3D "X" ]; do
+=09=09rm $SCRATCH_MNT/f$i
+=09=09let i=3D$i+2
+=09done
+
+=09echo "flushing changes via umount/mount."
+=09umount $SCRATCH_DEV
+=09_scratch_mount
+}
+
+allocate()
+{
+=09# now try to hit the deadlock
+=09echo "starting parallel allocators..."
+=09i=3D0
+=09while [ $i -le 10 ]; do
+=09=09file=3D$SCRATCH_MNT/F$i
+=09=09{
+=09=09=09j=3D0
+=09=09=09while [ $j -lt 100 ]; do
+=09=09=09=09xfs_io -f -c 'pwrite -b 64k 0 16m' $file \
+=09=09=09=09=09>/dev/null 2>&1
+=09=09=09=09rm $file
+=09=09=09=09let j=3D$j+1
+=09=09=09done
+=09=09} &
+=09=09let i=3D$i+1
+=09done
+
+=09wait
+=09echo "all done!"
+}
+
+# real QA test starts here
+umount $SCRATCH_DEV 2>/dev/null
+_scratch_mount
+
+# see if faststart is possible (and requested)
+files=3D2000
+faststart=3D""
+if [ -n "$FASTSTART" -a -f $SCRATCH_MNT/f0 ]; then
+=09faststart=3D"-N"=09# causes us to skip the mkfs step
+fi
+umount $SCRATCH_DEV
+
+_scratch_mkfs_xfs -dsize=3D160m,agcount=3D4 $faststart | _filter_mkfs =
2>$tmp.mkfs
+cat $tmp.mkfs >>$seq.full
+_scratch_mount
+
+populate
+allocate
+status=3D0
+exit
