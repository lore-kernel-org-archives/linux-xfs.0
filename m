+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+rm -f $seq.full
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux
+
+_require_nobigloopfs
+_require_scratch
+
+echo "Silence is golden."
+for fs in `echo ${MKFS_PROG}.* | sed -e 's/.sbin.mkfs.//g'`
+do
+=09preop=3D""=09# for special input needs
+=09preargs=3D""=09# for any special pre-device options
+=09postargs=3D""=09# for any special post-device options
+
+=09# minix, msdos and vfat mkfs fails for large devices, restrict to 2=
000 blocks
+=09[ $fs =3D minix ] && postargs=3D2000
+=09[ $fs =3D msdos ] && postargs=3D2000
+=09[ $fs =3D vfat ] && postargs=3D2000
+=09# these folks prompt before writing
+=09[ $fs =3D jfs ] && preop=3D"echo Y |"
+=09[ $fs =3D gfs ] && preop=3D"echo y |" && preargs=3D"-p lock_nolock =
-j 1"
+=09[ $fs =3D gfs2 ] && preop=3D"echo y |" && preargs=3D"-p lock_nolock=
 -j 1"
+=09[ $fs =3D reiserfs ] && preop=3D"echo y |" && preargs=3D"-f"
+=09# cramfs mkfs requires a directory argument
+=09[ $fs =3D cramfs ] && preargs=3D/proc/fs/xfs
+=09[ $fs =3D ext2 ] && preargs=3D"-F"
+=09[ $fs =3D ext3 ] && preargs=3D"-F"
+=09[ $fs =3D ext4 ] && preargs=3D"-F"
+=09[ $fs =3D ext4dev ] && preargs=3D"-F"
+
+=09# overwite the first few Kb - should blow away superblocks
+=09src/devzero -n 20 $SCRATCH_DEV >/dev/null
+
+=09# create a filesystem of this type
+=09echo "=3D=3D=3D Creating $fs filesystem..." >>$seq.full
+=09echo "    ( $preop mkfs -t $fs $preargs $SCRATCH_DEV $postargs )" >=
>$seq.full
+=09eval $preop mkfs -t $fs $preargs $SCRATCH_DEV $postargs >>$seq.full=
 2>&1
+
+=09if [ $? -eq 0 ] ; then
+=09=09# next, ensure we don't overwrite it
+=09=09echo "=3D=3D=3D Attempting XFS overwrite of $fs..." >>$seq.full
+=09=09${MKFS_PROG}.xfs $SCRATCH_DEV >>$seq.full 2>&1
+
+=09=09[ $? -eq 0 ] && echo "Failed - overwrote fs type ${fs}!"
+=09else
+=09=09echo "mkfs of type ${fs} failed" >>$seq.full
+=09fi
+done
+
+# success, all done
+status=3D0
+exit
