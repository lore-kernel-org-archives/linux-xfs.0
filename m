-# real QA test starts here
-_supported_fs xfs
-_supported_os Linux
-
-[ "$USE_EXTERNAL" =3D yes ] && _notrun "Cannot xfs_copy with external =
devices"
-[ -n "$XFS_COPY_PROG" ] || _notrun "xfs_copy binary not yet installed"
-
-_require_scratch
-_require_loop
-
-_scratch_mkfs_xfs -dsize=3D41m,agcount=3D2 | _filter_mkfs 2>/dev/null
-_scratch_mount 2>/dev/null || _fail "initial scratch mount failed"
-
-echo
-echo =3D=3D=3D populating scratch device
-_populate_scratch
-umount $SCRATCH_MNT 2>/dev/null
-
-echo
-echo =3D=3D=3D copying scratch device to single target
-$XFS_COPY_PROG $SCRATCH_DEV $imgs.image | _filter_copy '#' $imgs.image=
 '#' '#'
-_verify_copy $imgs.image $SCRATCH_DEV $SCRATCH_MNT
-
-echo
-echo =3D=3D=3D copying scratch device to single target, duplicate UUID
-$XFS_COPY_PROG -d $SCRATCH_DEV $imgs.image | _filter_copy '#' $imgs.im=
age '#' '#'
-_verify_copy $imgs.image $SCRATCH_DEV $SCRATCH_MNT
-
-echo=20
-echo =3D=3D=3D copying scratch device to single target, large ro devic=
e
-${MKFS_PROG}.xfs -dfile,name=3D$imgs.source,size=3D100g | _filter_mkfs=
 2>/dev/null
-rmdir $imgs.source_dir 2>/dev/null
-mkdir $imgs.source_dir
-
-mount -t xfs -o loop $imgs.source $imgs.source_dir
-loop2=3D`mount | grep $imgs.source | grep -o -e 'loop=3D.*[^),]' | gre=
p -o -e '/.*$'`
-cp -a $here $imgs.source_dir
-mount -t xfs -o remount,ro $imgs.source $imgs.source_dir
-$XFS_COPY_PROG $imgs.source $imgs.image | _filter_copy '#' $imgs.image=
 '#' '#'
-_verify_copy $imgs.image $imgs.source $imgs.source_dir
-
-# HACK WARNING:
-#
-# We're done with the nested loop mount, now we have to clean
-# up the pieces that mount is incapable of doing.
-losetup -d $loop2 > /dev/null 2>&1
-
-echo
-echo =3D=3D=3D copying scratch device to multiple targets
-$XFS_COPY_PROG -L$imgs.log -b $SCRATCH_DEV $imgs.image1 $imgs.image2 \
-=09| _filter_copy '#' $imgs.image1 '#' $imgs.image2
-_verify_copy $imgs.image1 $SCRATCH_DEV $SCRATCH_MNT
-_verify_copy $imgs.image2 $SCRATCH_DEV $SCRATCH_MNT
-
-# success, all done
-status=3D0
-exit
