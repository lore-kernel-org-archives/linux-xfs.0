+=09. $tmp.mkfs
+=09_scratch_mount
+=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/foo count=3D200 bs=3D4096 >/dev=
/null 2>&1 &
+=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/goo count=3D400 bs=3D4096 >/dev=
/null 2>&1 &
+=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/moo count=3D800 bs=3D4096 >/dev=
/null 2>&1 &
+=09wait
+=09umount $SCRATCH_MNT=09=09=09# flush everything
+=09_scratch_mount=09=09=09=09# and then remount
+}
+
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os IRIX Linux
+
+_need_to_be_root
