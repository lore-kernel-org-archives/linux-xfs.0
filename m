+=09FSSTRESS_ARGS=3D`_scale_fsstress_args -d $SCRATCH_MNT -w -p $procs =
-n $nops $FSSTRESS_AVOID`
+=09$FSSTRESS_PROG $FSSTRESS_ARGS >>$seq.full
+=09_check_scratch_fs
+}
