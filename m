@@ -0,0 +1,342 @@
+#! /bin/bash
+# FS QA Test No. 099. Modified from UDFQA test 036.
+#
+# ACL test
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2000-2004 Silicon Graphics, Inc.  All Rights Reserved.
