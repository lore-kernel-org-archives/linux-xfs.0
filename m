+#! /bin/bash
+# FS QA Test No. 050
+#
+# Exercises basic XFS quota functionality
+#       uquota, gquota, uqnoenforce, gqnoenforce, pquota, pqnoenforce
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2000-2002 Silicon Graphics, Inc.  All Rights Reserved.
+#
