-=09=09touch $_file.$i
-=09done
-=09for i in `seq 0 63 1000`; do
-=09=09mv $_file.$i $_dir
-=09done
-=09for i in `seq 0 1 1000`; do
-=09=09rm -f $_file.$i
-=09done
-
-=09$XFS_IO_PROG -fs -c "resvsp 0 40000k" $_file > /dev/null 2>&1
-
-=09for i in `seq 0 8 40000`; do
-=09=09$XFS_IO_PROG -f -c "unresvsp ${i}k 4k" $_file \
-=09=09=09=09=09> /dev/null 2>&1
-=09done
-=09for i in `seq 0 28 40000`; do
-=09=09$XFS_IO_PROG -f -c "unresvsp ${i}k 4k" $_file \
-=09=09=09=09=09> /dev/null 2>&1
-=09done
-=09sync
-
-=09# and now use up all the remaining extents larger than 3 blocks
-=09$XFS_IO_PROG -fs -c "resvsp 0 4m" $_file.large > /dev/null 2>&1
-}
