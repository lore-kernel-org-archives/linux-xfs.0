+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+_cleanup()
+{
+    cd /
+    rm -f $tmp.*
+}
+
+
+_check_paths()
+{
+=09_path=3D$1 # might want to only check this path
+
+=09sync; sleep 1
+=09echo ""
+=09echo "Check parent"
+=09if ! xfs_io -x -c 'parent -c' $SCRATCH_MNT | _filter_num; then
+=09=09exit 1
+=09fi
+}
+
+_print_names()
+{
+=09echo ""
+=09echo "Print out hardlink names for given path, $1"
+=09echo ""
+
+=09xfs_io -x -c parent $1 | awk '/p_ino.*=3D/ {$3 =3D "inodeXXX"; prin=
t; next} {print}'=20
+}
+
+_test_create()
+{
+=09echo ""
+=09echo "Testing create"
+=09echo ""
+
+=09# Test out some creations
+=09cd $SCRATCH_MNT
+=09touch file1
+
+=09mkdir dir2
+=09touch dir2/file2
+
+=09mkdir dir2/dir3
+=09touch dir2/dir3/file3
+
+=09mkdir dir2/dir3/dir4
+
+=09p=3Ddir2/dir3/dir4/file4
+=09touch $p
+
+=09#_print_names $p >>$here/$seq.full
+=09_print_names $p | tee -a $here/$seq.full
+
+=09_check_paths $SCRATCH_MNT/$p
+}
+
+_test_symlink()
+{
+=09echo ""
+=09echo "Testing symlink"
+=09echo ""
+
+=09d=3Dsym1/sym2/sym3
+=09f=3D$d/sym4_f
+
+=09mkdir -p $d
+        ln -s $f symlink1
+=09ln symlink1 hlink1
+=09ln symlink1 hlink2
+=09ln symlink1 hlink3
+=09_check_paths $SCRATCH_MNT/symlink1
+=09_check_paths $SCRATCH_MNT/hlink1
+=09_check_paths $SCRATCH_MNT/hlink2
+=09_check_paths $SCRATCH_MNT/hlink3
+}
+
+#
+# create hardlinks from the same dir
+# and some from different dirs
+#
+# test out removing hardlinks too
+#
+_test_hardlink()
+{
+=09echo ""
+=09echo "Testing hardlink"
+=09echo ""
+
+=09d=3Ddir2/dir3/dir4
+=09d2=3Ddir2/dir5/dir6
+=09mkdir -p $d
+=09mkdir -p $d2
+=09p=3D$d/file4
+=09touch $p
+
+=09# create hardlinks
+=09paths=3D"$d/l1 $d/l2 $d/l3 $d2/l4 $d2/l5 $d2/l6"
+=09for x in $paths; do
+=09=09ln $p $x
+=09done
+
+=09_print_names $p >>$here/$seq.full
+
+=09echo ""
+=09echo "print out names and check after created hardlinks"
+=09echo ""
+=09for x in $paths; do
+=09=09_print_names $x | tee -a $here/$seq.full
+=09=09_check_paths $SCRATCH_MNT/$x
+=09done
+
+
+=09echo ""
+=09echo "now try removing half of the hardlinks"
+=09echo ""
+=09paths=3D"$d/l1 $d/l2 $d/l3 $d2/l4 $d2/l5 $d2/l6"
+=09i=3D0
+=09for x in $paths; do
+=09=09let i=3D$i+1
+=09=09let j=3D$i%2
+=09=09if [ $j -eq 0 ]; then
+=09=09=09echo "rm'ing $x"
+=09=09=09rm $x
+=09=09fi
+=09done
+
+=09echo ""
+=09echo "print out names and check after removed hardlinks"
+=09echo ""
+=09for x in $paths; do
+=09=09if [ -e $x ]; then=20
+=09=09=09_print_names $x | tee -a $here/$seq.full
+=09=09=09_check_paths $SCRATCH_MNT/$x
+=09=09fi
+=09done
+
+}
+
+#
+# in dir, file1 to file2 where file2 does not exist
+# in dir, file1 to file2 where file2 does exist=20
+# dir/file1 to dir2/file2 where file2 does not exist
+# dir/file1 to dir2/file2 where file2 does exist
+# dir to dir2 where dir2 does not exist
+# dir to dir/dir3 - not allowed
+#
+#
+_test_rename()
+{
+=09echo ""
+=09echo "Testing rename"
+=09echo ""
+
+=09echo ""
+=09echo "1. in dir, file1 to file2 where file2 does not exist"=20
+=09echo ""
+=09d1=3D$SCRATCH_MNT/ren1/ren2/ren3/ren4
+=09mkdir -p $d1
+=09p1=3D$d1/f1
+=09p2=3D$d1/f2
+=09touch $p1
+=09mv $p1 $p2
+=09_check_paths $p2
+
+=09echo ""
+=09echo "2. in dir, file1 to file2 where file2 does exist"=20
+=09echo ""
+=09touch $p1
+=09mv $p1 $p2
+=09_check_paths $p2
+
+=09echo ""
+=09echo "3. dir/file1 to dir2/file2 where file2 does not exist"
+=09echo ""
+=09d2=3D$SCRATCH_MNT/ren1/ren2/ren3/ren5
+=09mkdir -p $d2
+=09p3=3D$d2/f3
+=09touch $p1
+=09mv $p1 $p3
+=09_check_paths $p3
+
+=09echo ""
+=09echo "4. dir/file1 to dir2/file2 where file2 does exist"
+=09echo ""
+=09d2=3D$SCRATCH_MNT/ren1/ren2/ren3/ren5
+=09p3=3D$d2/f3
+=09touch $p1
+=09mv $p1 $p3
+=09_check_paths $p3
+
+=09echo ""
+=09echo "5. dir to dir2 where dir2 does not exist"
+=09echo ""
+=09d3=3D$SCRATCH_MNT/ren1/ren2/ren3/ren6
+=09mv $d1 $d3
+=09_check_paths $d3
+}
+
+_filter_num()
+{
+=09tee -a $here/$seq.full |\
+=09sed -e 's/[0-9][0-9]* inodes/I inodes/g' \
+=09    -e 's/[0-9][0-9]* paths/P paths/g' \
+=09    -e 's/seed =3D [0-9][0-9]*/seed =3D S/'
+}
+
+
+_test_fsstress()
+{
+=09echo ""
+=09echo "Testing fsstress"
+=09echo ""
+
+=09out=3D$SCRATCH_MNT/fsstress.$$
+=09count=3D1000
+=09args=3D`_scale_fsstress_args -z \
+-f rmdir=3D10 -f link=3D10 -f creat=3D10 \
+-f mkdir=3D10 -f rename=3D30 -f unlink=3D10 \
+-f symlink=3D10 \
+-n $count -d $out -p 3`
+
+=09echo "fsstress $args" | sed -e "s#$out#outdir#"
+=09if ! $FSSTRESS_PROG $args | _filter_num
+=09then
+=09=09echo "    fsstress $args returned $?"
+=09=09cat $tmp.out | tee -a $here/$seq.full
+=09=09status=3D1
+=09fi
+
+=09_check_paths
+}
+
+
+_test_dirstress()
+{
+=09echo ""
+=09echo "Testing dirstress"
+=09echo ""
+
+=09out=3D$SCRATCH_MNT/dirstress.$$
+=09count=3D1000
+
+=09if ! mkdir $out
+=09then
+=09    echo "!! couldn't mkdir $out"
+=09    status=3D1
+=09    exit
+=09fi
+
+=09args=3D"-d $out -f $count -k -p 3 -n 1"
+=09echo "dirstress $args" | sed -e "s#$out#outdir#"
+=09if ! $here/src/dirstress $args >$tmp.out 2>&1 | _filter_num
+=09then
+=09=09echo "    dirstress failed"
+=09=09echo "*** dirstress $args" | tee -a $here/$seq.full
+=09=09cat $tmp.out >>$here/$seq.full
+=09=09status=3D1
+=09=09exit
+=09fi
+
+=09args=3D"-d $out -f $count -k -p 3 -n 5"
+=09echo "dirstress $args" | sed -e "s#$out#outdir#"
+=09if ! $here/src/dirstress $args >$tmp.out 2>&1 | _filter_num
+=09then
+=09=09echo "    dirstress failed"
+=09=09echo "*** dirstress $args" | tee -a $here/$seq.full
+=09=09cat $tmp.out >>$here/$seq.full
+=09=09status=3D1
+=09=09exit
+=09fi
+
+=09_check_paths
+}
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.attr
+
+_supported_fs xfs
+_supported_os IRIX
+
+_require_scratch
+_require_attrs
+_need_to_be_root
+
+rm -f $here/$seq.full
+
+echo "mkfs"
+_scratch_mkfs_xfs >>$here/$seq.full 2>&1 \
+    || _fail "mkfs scratch failed"
+_scratch_mkfs_xfs -i parent=3D1 >>$here/$seq.full 2>&1 \
+    || _notrun "parent inodes not supported"
+
+echo "mount"
+_scratch_mount >>$here/$seq.full 2>&1 \
+    || _fail "mount failed: $MOUNT_OPTIONS"
+
+# real QA test starts here
+
+verbose=3Dfalse
+
+_test_create
+_test_hardlink
+_test_rename
+_test_symlink
+
+# stress testing with verification by parent checking programs
+_test_fsstress
+_test_dirstress
+
+# success, all done
+status=3D0
+exit
