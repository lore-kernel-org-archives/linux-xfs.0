+. ./common.attr
+
+# real QA test starts here
+
+#_notrun "Need to fix up filtering before checkin"=20
+
+# Modify as appropriate.
+_supported_fs xfs
+_supported_os IRIX Linux
+
+_require_scratch
+_require_attrs
+
+export MKFS_OPTIONS=3D"-i size=3D512,attr=3D2"
+_scratch_mkfs_xfs > /dev/null 2>&1
+_scratch_mount
+
+file=3D$SCRATCH_MNT/file
+touch $file
+inum=3D`ls -i $file | awk '{print $1}'`
+echo "inum=3D$inum"
+
+_filter()
+{
+    sed -e "s#$tmp#TMP#g"
+}
+
+add_eas()
+{
+    start=3D$1
+    end=3D$2
+    echo ""; echo "** add $start..$end EAs **"
+    i=3D$start
+    while [ $i -le $end ]; do=20
+=09${ATTR_PROG} -s name.$i -V value $file >/dev/null
+=09let i=3D$i+1
+    done
+}
+
+rm_eas()
+{
+    start=3D$1
+    end=3D$2
+    echo ""; echo "** rm $start..$end EAs **"
+    i=3D$start
+    while [ $i -le $end ]; do=20
+=09${ATTR_PROG} -r name.$i $file >/dev/null
+=09let i=3D$i+1
+    done
+}
+
+do_extents()
+{
+    num=3D$1
+    echo ""; echo "** $num extents **"
+    src/makeextents -v -p -w -n $num $file
+}
+
+_print_inode()
+{
+    umount $SCRATCH_MNT
+    xfs_db -r -c "inode $inum" -c "print" $SCRATCH_DEV |\
+    awk '
+=09/nextents/ { print; next }
+=09/naextents/ { print; next }
+=09/u\./ { print; next }
+=09/a\./ { print; next }
+=09/forkoff/ { printf("core.forkoff =3D %d (%d bytes)\n", $3, $3*8); n=
ext }
+=09/format/ { print; next }
+=09/size/ { print; next }
+    '
+    _scratch_mount
+}
+
+_print_inode_u()
+{
+    umount $SCRATCH_MNT
+    xfs_db -r -c "inode $inum" -c "print u" $SCRATCH_DEV
+    _scratch_mount
+}
+
+_print_inode_a()
+{
+    umount $SCRATCH_MNT
+    xfs_db -r -c "inode $inum" -c "print a" $SCRATCH_DEV
+    _scratch_mount
+}
