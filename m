H_DEV \
+=09=09>> $seq.full 2>&1; then
+=09echo "FAIL: projid32bit disabled: setting 32bit projid succeeded"
+=09echo "      while it should fail"
+=09status=3D1
+fi
+
+# over 32bit value, should fail
+touch $dir/over32bit
+if $XFS_QUOTA_PROG -x -c "project -s -p $dir/over32bit 5344967296" $SC=
RATCH_DEV >> $seq.full 2>&1; then
+=09echo "FAIL: projid32bit disabled: setting over 32bit projid succeed=
ed"
+=09echo "      while it should fail"
+=09status=3D1
+fi
+
+#  Do testing on filesystem with projid32bit feature enabled
+umount $SCRATCH_DEV 2>/dev/null
+_scratch_mkfs_xfs -i projid32bit=3D1 >> $seq.full || _fail "mkfs faile=
d"
+_qmount
+mkdir $dir
+
+touch $dir/below16bit
+# below 16bit value, should succeed
+$XFS_QUOTA_PROG -x -c "project -s -p $dir/below16bit 3422" $SCRATCH_DE=
V \
+=09=09>> $seq.full
+projid=3D$($XFS_IO_PROG -r -c "lsproj" $dir/below16bit)
+if [ "projid =3D 3422" !=3D "$projid" ]; then
+=09echo "FAIL: projid32bit enabled: returned projid value ($projid)"
+=09echo "      doesn't match set one (projid =3D 3422)"
+=09status=3D1
+fi
+
+# 32bit value, should succeed
+touch $dir/over16bit
+if $XFS_QUOTA_PROG -x -c "project -s -p $dir/over16bit 108545" $SCRATC=
H_DEV \
+=09=09>> $seq.full 2>&1; then
+=09projid=3D$($XFS_IO_PROG -r -c "lsproj" $dir/over16bit)
+=09if [ "projid =3D 108545" !=3D "$projid" ]; then
+=09=09echo "FAIL: projid32bit enabled: returned projid value ($projid)=
"
+=09=09echo "      doesn't match set one (projid =3D 108545)"
+=09=09status=3D1
+=09fi
+else
+=09echo "FAIL: projid32bit enabled: setting 32bit projid failed"
+=09echo "      while it should succeed"
+=09status=3D1
+fi
+
+# over 32bit value, should fail
+touch $dir/over32bit
+if $XFS_QUOTA_PROG -x -c "project -s -p $dir/over32bit 5344967296" $SC=
RATCH_DEV \
+=09=09>> $seq.full 2>&1; then
+=09echo "FAIL: projid32bit enabled: setting over 32bit projid succeede=
d"
+=09echo "      while it should fail"
+=09status=3D1
+fi
