-seq=3D`basename $0`
-echo "QA output created by $seq"
-
-here=3D`pwd`
-tmp=3D/tmp/$$
-status=3D1=09# failure is the default!
-trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
-
-# get standard environment, filters and checks
-. ./common.rc
-. ./common.filter
-. ./common.quota
-
-# real QA test starts here
-_supported_fs xfs
-_supported_os Linux #IRIX
-_require_scratch
-_require_xfs_quota
-
-test_files()
-{
-=09echo; echo "### create files, setting up ownership (type=3D$type)"
-=09rm -f $SCRATCH_MNT/{buffer,direct,mmap}
-=09$XFS_IO_PROG -fc "chproj $prid" $SCRATCH_MNT/{buffer,direct,mmap}
-=09chown $uid $SCRATCH_MNT/{buffer,direct,mmap}
-=09chgrp $gid $SCRATCH_MNT/{buffer,direct,mmap}
-=09for file in $SCRATCH_MNT/{buffer,direct,mmap}; do
-=09=09$here/src/lstat64 $file | head -3 | _filter_scratch
-=09=09$XFS_IO_PROG -c lsproj $file
-=09done
-}
-
-test_accounting()
-{
-=09echo "### some controlled buffered, direct and mmapd IO (type=3D$ty=
pe)"
-=09echo "--- initiating parallel IO..." >>$seq.full
-=09$XFS_IO_PROG -c 'pwrite -b 1m 0 16m' -c 'fsync' \
-=09=09=09=09=09$SCRATCH_MNT/buffer >>$seq.full 2>&1 &
-=09$XFS_IO_PROG -c 'pwrite -b 1m 0 16m' -d \
-=09=09=09=09=09$SCRATCH_MNT/direct >>$seq.full 2>&1 &
-=09$XFS_IO_PROG -c 't 16m' -c 'mm -rw 0 16m' -c 'mw 0 16m' -c 'ms -s' =
\
-=09=09=09=09=09$SCRATCH_MNT/mmap   >>$seq.full 2>&1 &
-=09wait
-=09echo "--- completed parallel IO ($type)" >>$seq.full
-
-=09for file in $SCRATCH_MNT/{buffer,direct,mmap}; do
-=09=09$here/src/lstat64 $file | head -3 | _filter_scratch
-=09done
-=09xfs_quota -c "quota -hnb -$type $id" $QARGS | _filter_scratch | _fi=
lter_spaces
-=09xfs_quota -c "quota -hni -$type $id" $QARGS | _filter_scratch | _fi=
lter_spaces
-=09xfs_quota -c "quota -hnr -$type $id" $QARGS | _filter_scratch | _fi=
lter_spaces
-}
-
-export MOUNT_OPTIONS=3D"-opquota"
-_qmount
-_require_prjquota $SCRATCH_DEV
-
-# real QA test starts here
-rm -f $tmp.projects $seq.full
-umount $SCRATCH_DEV 2>/dev/null
-_scratch_mkfs_xfs | _filter_mkfs 2>$tmp.mkfs
-cat $tmp.mkfs >>$seq.full
-_scratch_mount
-
-uid=3D1
-gid=3D2
-prid=3D3
-export QARGS=3D"-x -D /dev/null -P /dev/null $SCRATCH_MNT"
-umount $SCRATCH_DEV
-
-echo; echo "### test user accounting"
-export MOUNT_OPTIONS=3D"-ouquota"
-_qmount
-type=3Du
-id=3D$uid
-test_files
-test_accounting
-umount $SCRATCH_DEV 2>/dev/null
-
-echo; echo "### test group accounting"
-export MOUNT_OPTIONS=3D"-ogquota"
-_qmount
-type=3Dg
-id=3D$gid
-test_files
-test_accounting
-umount $SCRATCH_DEV 2>/dev/null
