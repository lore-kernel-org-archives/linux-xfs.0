+=09echo "Error: $SCRATCH_DEV: freesp mismatch: $ans"
+=09echo "xfs_db output ..."
+=09cat $tmp.xfs_db
+=09status=3D1
+fi
+
+# check the 'pct' field from freesp command is good
+perl -ne '
+=09    BEGIN=09{ $percent =3D 0; }
+=09    /free/=09&& next;=09# skip over free extent size number
+=09    if (/\s+(\d+\.\d+)$/) {
+=09=09$percent +=3D $1;
+=09    }
+=09    END=09{ $percent +=3D 0.5; print int($percent), "\n" }=09# roun=
d up
+' <$tmp.xfs_db >$tmp.ans
+ans=3D"`cat $tmp.ans`"
+echo "Checking percent column yields 100: $ans"
+if [ "$ans" !=3D 100 ]
+then
+=09echo "Error: $SCRATCH_DEV: pct mismatch: $ans (expected 100)"
+=09echo "xfs_db output ..."
+=09cat $tmp.xfs_db
+=09status=3D1
+fi
+
+exit
