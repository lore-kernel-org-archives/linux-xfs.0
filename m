-
-echo ""
-echo "=3D=3D=3D Test Default ACLs =3D=3D=3D"
-# make test clearer by testing with and without umask
-umask 0
-
-mkdir acldir
-chacl -b "u::rwx,g::rwx,o::rwx" "u::r-x,g::r--,o::---" acldir 2>&1
-_acl_list acldir
-cd acldir
-
-touch file2
-_acl_ls file2
-_acl_list file2
-
-#ensure that umask is not having an effect=20
-#so set it and see
-umask 722
-touch file3
-_acl_ls file3
-_acl_list file3
-
-cd ..
-umask 022
-
-
-#-------------------------------------------------------
-
-echo ""
-echo "=3D=3D=3D Removing ACLs =3D=3D=3D"
-_acl_list file1
-_acl_list acldir
-_acl_list acldir/file2
-echo "Remove ACLs..."
-chacl -R file1
-chacl -B acldir
-chacl -R acldir/file2
-echo "Note: IRIX interface would mean empty ACLs - Linux would show mo=
de ACLs"=20
-_acl_list file1
-_acl_list acldir
-_acl_list acldir/file2
-
-#-------------------------------------------------------
-
-echo ""
-echo "=3D=3D=3D Test out error messages for ACL text parsing  =3D=3D=
=3D"
-
-touch file1
-set -x
-chacl u file1
-chacl u: file1
-chacl u:rumpledumpleunknownuser file1
-chacl u:rumpledumpleunknownuser: file1
-chacl g:rumpledumpleunknowngrp file1
-chacl g:rumpledumpleunknowngrp: file1
-chacl o:user1:rwx file1
-chacl m:user1:rwx file1
-chacl a::rwx file1
-set +x
-
-#-------------------------------------------------------
-
-echo ""
-echo "=3D=3D=3D Test out large ACLs  =3D=3D=3D"
-touch largeaclfile
-XFS_ACL_MAX_ENTRIES=3D25
-num_aces_pre=3D`expr $XFS_ACL_MAX_ENTRIES - 1`
-num_aces_post=3D`expr $XFS_ACL_MAX_ENTRIES + 1`
-
-acl1=3D`_create_n_aces $num_aces_pre`
-acl2=3D`_create_n_aces $XFS_ACL_MAX_ENTRIES`
-acl3=3D`_create_n_aces $num_aces_post`
-
-echo "1 below xfs acl max"
-chacl $acl1 largeaclfile
-_acl_list largeaclfile | _filter_aces_notypes
-
-echo "xfs acl max"
-chacl $acl2 largeaclfile
-_acl_list largeaclfile | _filter_aces_notypes
-
-echo "1 above xfs acl max"
-chacl $acl3 largeaclfile
-_acl_list largeaclfile | _filter_aces_notypes
-
-#-------------------------------------------------------
-
-if [ "$FSTYP" =3D=3D "udf" ]; then
-    cd /
-    umount $TARGET_DIR
-    # Check the filesystem
-    _check_scratch_fs
-fi
-# success, all done
-status=3D0
-exit
