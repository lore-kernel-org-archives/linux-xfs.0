+}
+
+_process_args()
+{
+    while getopts "l:n:N:?" c $@
+    do
+        case $c
+        in
+            l)
+                filelen=3D$OPTARG
+=09=09param_type=3D"$param_type, overidde -l"
+                ;;
+            N)
+                numops2=3D$OPTARG
+=09=09param_type=3D"$param_type, overidde -N"
+                ;;
+            n)
+                numops1=3D$OPTARG
+=09=09param_type=3D"$param_type, overidde -n"
+                ;;
+=09    ?)
+=09=09_usage
+=09=09exit=09
+=09=09;;
+=09esac
+    done
+}
