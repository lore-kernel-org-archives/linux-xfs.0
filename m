-=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
-=09=09for j in `seq 5 1 20`; do
-=09=09=09create_target_attr_last $i $j $targ.$i.$j >> $seq.full 2>&1
-=09=09done
-=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
-=09=09FSRXFSTEST=3Dtrue xfs_fsr -d -v -C $n $targ.$i.* >> $seq.full 2>=
&1
-=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
-=09done
-done
