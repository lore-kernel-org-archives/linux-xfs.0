-=09=09_scratch_mkfs_xfs -dsize=3D$fsz,agcount=3D$ags  >>$seq.full 2>&1=
 \
-=09=09=09|| _fail "size=3D$fsz,agcount=3D$ags mkfs failed"
-=09else
-=09=09_scratch_mkfs_sized $fsz >>$seq.full 2>&1 \
