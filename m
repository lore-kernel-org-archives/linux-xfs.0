-_filter_report()
-{
-=09tr -s '[:space:]' | \
-=09perl -npe '
-=09=09s/^\#'$id' /[NAME] /g;
-=09=09s/^\#0 \d+ /[ROOT] 0 /g;
-=09=09s/6 days/7 days/g'
-}
-
-# The actual point at which limit enforcement takes place for the
-# hard block limit is variable depending on filesystem blocksize,
-# and iosize.  What we want to test is that the limit is enforced
-# (ie. blksize less than limit but not unduly less - ~85% is kind)
-# nowadays we actually get much closer to the limit before EDQUOT.
-#
-_filter_and_check_blks()
-{
-=09perl -npe '
-=09=09if (/^\#'$id'\s+(\d+)/ && '$enforce') {
-=09=09=09$maximum =3D '$bhard';
-=09=09=09$minimum =3D '$bhard' * 85/100;
-=09=09=09if (($1 < $minimum || $1 > $maximum) && '$noextsz') {
-=09=09=09=09printf(" URK %d: %d is out of range! [%d,%d]\n",
-=09=09=09=09=09'$id', $1, $minimum, $maximum);
-=09=09=09}
-=09=09=09s/^(\#'$id'\s+)(\d+)/\1 =3DOK=3D/g;
-=09=09}
-=09' | _filter_report
-}
