+
+echo "Params are for $param_type" >>$seq.full
+echo "Params: n =3D $numops1 N =3D $numops2 l =3D $filelen" >>$seq.ful=
l
+
+_setup_testdir
+
+rm -f $here/$seq.full
+echo "brevity is wit..."
+
