+# This program is distributed in the hope that it would be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+
+_cleanup()
+{
+    rm -f $tmp.*
+}
+
+trap "_cleanup ; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux
+_require_scratch
+
+rm -f $seq.full
+
+[ "$XFS_FSR_PROG" =3D "" ] && _notrun "xfs_fsr not found"
+
+# create freespace holes of 1-3 blocks in length
+#
+# This is done to ensure that defragmented files have roughly 1/3 the
+# number of extents they started with. This will ensure we get
+# transistions from btree format (say 15 extents) to extent format
+# (say 5 extents) and lots of variations around that dependent on the
+# number of attributes in the files being defragmented.
+#
+# We have to make sure there are enough free inodes for the test to
+# pass without needing to allocate new clusters during the test.
+# With such fragemented free space, that will fail.
+#
+fragment_freespace()
+{
+=09_file=3D"$SCRATCH_MNT/not_free"
+=09_dir=3D"$SCRATCH_MNT/saved"
+
+=09# allocate inode space
+=09mkdir -p $_dir
+=09for i in `seq 0 1 1000`; do
+=09=09touch $_file.$i
+=09done
+=09for i in `seq 0 63 1000`; do
+=09=09mv $_file.$i $_dir
+=09done
+=09for i in `seq 0 1 1000`; do
+=09=09rm -f $_file.$i
+=09done
+
+=09$XFS_IO_PROG -fs -c "resvsp 0 40000k" $_file > /dev/null 2>&1
+
+=09for i in `seq 0 8 40000`; do
+=09=09$XFS_IO_PROG -f -c "unresvsp ${i}k 4k" $_file \
+=09=09=09=09=09> /dev/null 2>&1
+=09done
+=09for i in `seq 0 28 40000`; do
+=09=09$XFS_IO_PROG -f -c "unresvsp ${i}k 4k" $_file \
+=09=09=09=09=09> /dev/null 2>&1
+=09done
+=09sync
+
+=09# and now use up all the remaining extents larger than 3 blocks
+=09$XFS_IO_PROG -fs -c "resvsp 0 4m" $_file.large > /dev/null 2>&1
+}
+
+create_attrs()
+{
+=09for foo in `seq 0 1 $1`; do
+=09=09$SETFATTR_PROG -n user.$foo -v 0xbabe $2
+=09done
+}
+
+create_data()
+{
+=09size=3D`expr \( $1 + 1 \) \* 4096`
+=09$XFS_IO_PROG -f -c "truncate $size" $2 > /dev/null 2>&1
+=09for foo in `seq $1 -1 0`; do
+=09=09let offset=3D$foo*4096
+=09=09$XFS_IO_PROG -f -c "resvsp $offset 4096" $2 > /dev/null 2>&1
+=09done
+}
+
+# create the designated file with a certain number of attributes and a=
 certain
+# number of data extents. Reverse order synchronous data writes are us=
ed to
+# create fragmented files, though with the way the filesystem freespac=
e is
+# fragmented, this is probably not necessary. Create the attributes fi=
rst so
+# that they cause the initial fork offset pressure to move it about.
+#
+create_target_attr_first()
+{
+=09nattrs=3D$1
+=09file_blocks=3D$2
+=09target=3D$3
+
+=09rm -f $target
+=09touch $target
+=09create_attrs $nattrs $target
+=09create_data $file_blocks $target
+}
+
+# Same as create_target_attr_first, but this time put the attributes o=
n after
+# the data extents have been created. This puts different pressure on =
the
+# inode fork offset, so should exercise the kernel code differently an=
d give us
+# a different pattern of fork offsets to work with compared to creatin=
g the
+# attrs first.
+#
+create_target_attr_last()
+{
+=09nattrs=3D$1
+=09file_blocks=3D$2
+=09target=3D$3
+
+=09rm -f $target
+=09touch $target
+=09create_data $file_blocks $target
+=09create_attrs $nattrs $target
+}
+
+rm -f $seq.full
+
+# use a small filesystem so we can control freespace easily
+_scratch_mkfs_sized $((50 * 1024 * 1024)) >> $seq.full 2>&1
+_scratch_mount
+fragment_freespace
+
+# unmount and remount to reset all allocator indexes
+umount $SCRATCH_MNT
+_scratch_mount
+
+# create a range of source files, then fsr them to a known size
+#
+# This assumes 256 byte inodes.
+#
+# n =3D number of target fragments for xfs_fsr
+#=09- only a guideline, but forces multiple fragments via sync writes
+#=09- start at 4 as that typically covers all extent format situations
+#=09- end at 12 as that is beyond the maximum that canbe fit in extent
+#=09  format
+# i =3D number of 2 byte attributes on the file
+#=09- it takes 6 attributes to change the fork offset from the start v=
alue
+#=09  of 120 bytes to 112 bytes, so we start at 5.
+#=09- 15 is enough to push to btree format, so we stop there.
+# j =3D number of data extents on the file
+#=09- start in extent format, but we also want btree format as well, s=
o
+#=09  start at 5 so that the number of attributes determines the start=
ing
+#=09  format.
+#=09- need enough extents that if they are all 3 blocks in length the =
final
+#=09  format will be dependent on the number of attributes on the inod=
e. 20
+#=09  initial single block extents gives us 6-8 extents after defrag w=
hich
+#=09  puts us right on the threshold of what the extent format can hol=
d.
+
+targ=3D$SCRATCH_MNT/fsr_test_file.$$
+for n in `seq 4 1 12`; do
+=09echo "*** n =3D=3D $n ***" >> $seq.full
+=09for i in `seq 5 1 15`; do
+=09=09for j in `seq 5 1 20`; do
+=09=09=09create_target_attr_first $i $j $targ.$i.$j >> $seq.full 2>&1
+=09=09done
+=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
+=09=09FSRXFSTEST=3Dtrue xfs_fsr -d -v -C $n $targ.$i.* >> $seq.full 2>=
&1
+=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
+=09=09for j in `seq 5 1 20`; do
+=09=09=09create_target_attr_last $i $j $targ.$i.$j >> $seq.full 2>&1
+=09=09done
+=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
+=09=09FSRXFSTEST=3Dtrue xfs_fsr -d -v -C $n $targ.$i.* >> $seq.full 2>=
&1
+=09=09xfs_bmap -vp $targ.$i.* >> $seq.full 2>&1
+=09done
+done
+
+umount $SCRATCH_MNT
+echo "--- silence is golden ---"
+status=3D0 ; exit
