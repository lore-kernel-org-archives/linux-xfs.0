-#
-
-seq=3D`basename $0`
-echo "QA output created by $seq"
-
-here=3D`pwd`
-tmp=3D/tmp/$$
-status=3D1=09# failure is the default!
-trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
-
-# get standard environment, filters and checks
-. ./common.rc
-. ./common.filter
-. ./common.quota
-
-filter_xfs_quota()
-{
-=09perl -ne "
-s,$target,[TARGET],;
-s,$tmp.projects,[PROJECTS_FILE],;
-s,$SCRATCH_MNT,[SCR_MNT],;
-s,$SCRATCH_DEV,[SCR_DEV],;
-s/Inode: \#\d+ \(0 blocks, 0 extents\)/Inode: #[INO] (0 blocks, 0 exte=
nts)/;
-s/Inode: \#\d+ \(\d+ blocks, \d+ extents\)/Inode: #[INO] (X blocks, Y =
extents)/;
-=09print;"
-}
-
-_supported_fs xfs
-_supported_os Linux #IRIX
-_require_scratch
-_require_xfs_quota
-
-# real QA test starts here
-_scratch_mkfs_xfs | _filter_mkfs 2>$tmp.mkfs
-cat $tmp.mkfs >$seq.full
-. $tmp.mkfs
-
-# setup a default run
-if [ -z "$MOUNT_OPTIONS" ]; then
-=09export MOUNT_OPTIONS=3D"-o pquota,sync"
-else
-=09export MOUNT_OPTIONS=3D"$MOUNT_OPTIONS -o sync"
-fi
-
-_qmount
-_require_prjquota $SCRATCH_DEV
-
-echo "### create projects file"
-rm -f $tmp.projects
-target=3D$SCRATCH_MNT/project
-echo "6:$target" | tee -a $seq.full > $tmp.projects
-
-echo "### populate filesystem"
-mkdir $target=09=09|| exit
-$FSSTRESS_PROG -z -s 65261 -m 8 -n 1000 -p 4 \
--f allocsp=3D1 \
--f chown=3D3 \
--f creat=3D4 \
--f dwrite=3D4 \
--f fallocate=3D1 \
--f fdatasync=3D1 \
--f fiemap=3D1 \
--f freesp=3D1 \
--f fsync=3D1 \
--f link=3D1 \
--f mkdir=3D2 \
--f punch=3D1 \
--f rename=3D2 \
--f resvsp=3D1 \
--f rmdir=3D1 \
--f setxattr=3D1 \
--f sync=3D1 \
--f truncate=3D2 \
--f unlink=3D1 \
--f unresvsp=3D1 \
--f write=3D4 \
--d $target
-
-$FSSTRESS_PROG -z -s 47806 -m 8 -n 500 -p 4 \
--f chown=3D250 \
--f setxattr=3D250 \
--d $target
-
-
-QARGS=3D"-x -D $tmp.projects -P /dev/null $SCRATCH_MNT"
-
-echo "### initial report"
-xfs_quota -c 'quot -p' -c 'quota -ip 6' $QARGS | filter_xfs_quota
-
-echo "### check the project, should give warnings"
-xfs_quota -c 'project -c 6' $QARGS | LC_COLLATE=3DPOSIX sort | filter_=
xfs_quota
-
-echo "### recursively setup the project"
-xfs_quota -c 'project -s 6' $QARGS | LC_COLLATE=3DPOSIX sort | filter_=
xfs_quota
-xfs_quota -c 'quota -ip 6' $QARGS | filter_xfs_quota
-
-echo "### check the project, should give no warnings now"
-xfs_quota -c 'project -c 6' $QARGS | LC_COLLATE=3DPOSIX sort | filter_=
xfs_quota
-
-echo "### deny a hard link - wrong project ID"
-rm -f $SCRATCH_MNT/outer $target/inner
-$XFS_IO_PROG -f -c 'chproj 789' $SCRATCH_MNT/outer
-ln $SCRATCH_MNT/outer $target/inner 2>/dev/null
-if [ $? -eq 0 ]; then
-=09echo hard link succeeded
-=09ls -ld $SCRATCH_MNT/outer $target/inner
-else
-=09echo hard link failed
-fi
-xfs_quota -c 'quota -ip 6' $QARGS | filter_xfs_quota
-
-echo "### allow a hard link - right project ID"
-$XFS_IO_PROG -c 'chproj 6' $SCRATCH_MNT/outer
-ln $SCRATCH_MNT/outer $target/inner
-if [ $? -eq 0 ]; then
-=09echo hard link succeeded
-else
-=09echo hard link failed
-=09ls -ld $SCRATCH_MNT/outer $target/inner
-fi
-xfs_quota -c 'quota -ip 6' $QARGS | filter_xfs_quota
-
-echo "### recursively clear the project"
-xfs_quota -c 'project -C 6' $QARGS | LC_COLLATE=3DPOSIX sort | filter_=
xfs_quota
-#no output...
-xfs_quota -c 'quota -ip 6' $QARGS | filter_xfs_quota
-
-status=3D0
-exit
