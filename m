-
-_cleanup()
-{
-    cd /
-    rm -f $tmp.*
-}
-
-_create_file()
-{
-=09if [ $1 -ne 2 ]; then
-=09=09tmpfile=3D"$SCRATCH_MNT/tmp_file"
-=09else
-=09=09mkdir -p $SCRATCH_MNT/tmp_dir
-=09=09tmpfile=3D"$SCRATCH_MNT/tmp_dir/tmp_file"
-=09fi
-=09=09
-=09for i in `seq $cnt -1 0`; do
-=09=09dd if=3D/dev/zero of=3D$tmpfile bs=3D4k count=3D1 \
-=09=09 conv=3Dnotrunc seek=3D$i oflag=3Dsync &>/dev/null
-=09done
-=09# get md5sum
-=09md5sum $tmpfile > /tmp/checksum
-}
-
-_btrfs_online_defrag()
-{
-=09str=3D""
-=09if [ "$2" =3D "2" ];then
-=09=09str=3D"$str -s -1 -l $((filesize / 2)) "
-=09elif [ "$2" =3D "3" ];then
-=09=09str=3D"$str -s $((filesize + 1)) -l $((filesize / 2)) "
-=09=09HAVE_DEFRAG=3D1
-=09elif [ "$2" =3D "4" ];then
-=09=09str=3D"$str -l -1 "
-=09elif [ "$2" =3D "5" ];then
-=09=09str=3D"$str -l $((filesize + 1)) "
-=09elif [ "$2" =3D "6" ];then
-=09=09str=3D"$str -l $((filesize / 2)) "
-=09fi
-
-=09if [ "$3" =3D "2" ];then
-=09=09str=3D"$str -c "
-=09fi
-
-=09if [ "$str" !=3D "" ]; then
-=09=09btrfs filesystem defragment $str $SCRATCH_MNT/tmp_file
-=09else
-=09=09if [ "$1" =3D "1" ];then
-=09=09=09btrfs filesystem defragment $SCRATCH_MNT/tmp_file
-=09=09elif [ "$1" =3D "2" ];then
-=09=09=09btrfs filesystem defragment $SCRATCH_MNT/tmp_dir
-=09=09elif [ "$1" =3D "3" ];then
-=09=09=09btrfs filesystem defragment $SCRATCH_MNT
-=09=09fi
-=09fi
-=09ret_val=3D$?
-=09_scratch_remount
-=09if [ $ret_val -ne 20 ];then
-=09=09echo "btrfs filesystem defragment failed! err is $ret_val"
-=09fi
-}
-
-_checksum()
-{
-=09md5sum -c /tmp/checksum > /dev/null 2>&1
-=09if [ $? -ne 0 ]; then
-=09=09echo "md5 checksum failed!"
-=09fi
-}
-
-_cleanup_defrag()
-{
-=09umount $SCRATCH_MNT > /dev/null 2>&1
-}
-
-_setup_defrag()
-{
-=09umount $SCRATCH_MNT > /dev/null 2>&1
