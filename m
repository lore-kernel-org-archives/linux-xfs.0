+chmod 777 $SCRATCH_MNT
+
+block_size=3D`stat -f $SCRATCH_DEV | grep "Block size" | cut -d " " -f=
3`
+_test_full_fs_punch $(( $block_size * 2 )) $block_size 500 $SCRATCH_MN=
T/252.$$ $block_size
+
+status=3D0 ; exit
