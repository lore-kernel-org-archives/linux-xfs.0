+	agfctl_cmd.flags =3D CMD_FLAG_GLOBAL;
+	agfctl_cmd.oneline =3D _("AGF state control");
+	agfctl_cmd.help =3D agfctl_help;
+
+	add_command(&agfctl_cmd);
+}
