+    echo "iter $iter" >> $here/$seq.full
+    _chain
+    _check
+    if [ -f $tmp.bad ]
+    then
+=09echo "Fatal error: test abandoned without changes"
+=09exit 1
+    fi
+done
+
+status=3D0
+exit
