+
+# xfsprogs 2.9.8: sb_bad_features2 in pv 978822
+if [ $XFSPROGS_VERSION -lt 20908 ]; then
+=09echo 'offsetof(xfs_sb_t, sb_bad_features2 ) =3D 204' >>$progout
+fi
