+#! /bin/bash
+# FSQA Test No. 190
+#
+# This test uses xfs_io to unreserve space in a file at various differ=
ent
+# offsets and sizes. The script then verifies the holes are in the cor=
rect
+# location.
+#
+# PV 985792
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2008 Silicon Graphics, Inc.  All Rights Reserved.
+#
+# This program is free software; you can redistribute it and/or
+# modify it under the terms of the GNU General Public License as
+# published by the Free Software Foundation.
+#
+# This program is distributed in the hope that it would be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+#This is the list of holes to punch in the file limited to $filesize
+#NOTE holes cannot overlap or this script will fail.
+holes=3D"4096:4096 303104:4096 1048576:512 1051648:8192 1065984:8192 1=
085440:7168"
+#filesize in MB
+filesize=3D10
+#Name of file to perform the test on
+filename=3Dtest-190
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D0    # success is the default!
+rm -f $seq.full
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux
+
+_require_scratch
+_scratch_mkfs_xfs >/dev/null 2>&1
+_scratch_mount
+fsblocksize=3D`xfs_info $SCRATCH_MNT|sed 's/=3D/ /g'|awk '/^data / { p=
rint $3 }'`
+
+dd if=3D/dev/zero of=3D$SCRATCH_MNT/$filename bs=3D1024k count=3D10 >>=
 $seq.full 2>&1
+
+# run DMAPI test using verbose output
+echo Punching holes in file
+echo Punching holes in file >> $seq.full
+for i in $holes ; do
+=09echo xfs_io -c "unresvsp `echo $i |$SED_PROG 's/:/ /g'`" $SCRATCH_M=
NT/$filename >> $seq.full
+=09xfs_io -c "unresvsp `echo $i |$SED_PROG 's/:/ /g'`" $SCRATCH_MNT/$f=
ilename ;
+done
+
+echo Verifying holes are in the correct spots:
+
+xfs_bmap=3D`xfs_bmap $SCRATCH_MNT/$filename`
+xfs_bmap $SCRATCH_MNT/$filename >> $seq.full
+for i in $holes ; do
+=09holeStart=3D$[`echo $i|$SED_PROG 's/:/ /g'|awk '{print $1}'`];
+=09holeEnd=3D$[`echo $i|$SED_PROG 's/:/ /g'|awk '{print $2}'`];
+
+=09#Round hole size down to a multiple of $fsblocksize
+=09holeEnd=3D$[(($holeStart+$holeEnd)/$fsblocksize)*$fsblocksize]
+
+=09#Round hole start up to a multiple of $fsblocksize
+=09if [ $[$holeStart % $fsblocksize] -gt 0 ] ; then
+=09=09holeStart=3D$[($holeStart/$fsblocksize +1) * $fsblocksize]
+=09fi
+=09#xfs_bmap prints holes in the following format
+=09#                1: [8..15]: hole
+=09bmap=3D"\[$[$holeStart/512]..$[($holeEnd/512) -1]\]";
+=09echo $bmap >> $seq.full
+=09if [ $holeEnd =3D=3D $holeStart ] ; then
+=09=09continue #there is no hole
+=09fi
+=09if ! echo $xfs_bmap|grep -q $bmap; then
+=09=09echo Offset $holeStart to $holeEnd  basic blocks failed;
+=09=09status=3D1;
+=09fi
+done
+if [ $status =3D=3D 0 ] ; then
+=09echo Test $seq Passed.
+fi
+
+exit
