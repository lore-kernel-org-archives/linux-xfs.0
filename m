--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+rm -f $seq.full
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.repair
+. ./common.filter
+
+[ -z "$XFS_PARALLEL_REPAIR_PROG" ] && _notrun "parallel repair binary =
xfs_prepair is not installed"
+
+# force use of parallel repair
+export XFS_REPAIR_PROG=3D$XFS_PARALLEL_REPAIR_PROG
+
+_check_repair()
+{
+=09echo "Repairing, round 0" >> $seq.full
+=09_scratch_xfs_repair 2>&1 | _filter_repair | tee -a $seq.full >$tmp.=
0
+=09for i in 1 2 3 4
+=09do
+=09=09echo "Repairing, iteration $i" | tee -a $seq.full
+=09=09_scratch_xfs_repair 2>&1 | _filter_repair >$tmp.$i
+=09=09diff $tmp.0 $tmp.$i >> $seq.full
+=09=09if [ $? -ne 0 ]; then
+=09=09=09echo "ERROR: repair round $i differs to round 0 (see $seq.ful=
l)" | tee -a $seq.full
+=09=09=09break
+=09=09fi
+=09=09# echo all interesting stuff...
+=09=09perl -ne '
+=09=09=09s/(rebuilding directory inode) (\d+)/\1 INO/g;
+=09=09=09s/internal log/<TYPEOF> log/g;
+=09=09=09s/external log on \S+/<TYPEOF> log/g;
+=09=09=09/^\S+/ && print;
+=09=09' $tmp.$i
+=09done
+=09echo
+}
+
+# prototype file to create various directory forms
+_create_proto()
+{
+=09total=3D$1
+=09count=3D0
+
+=09# take inode size into account for non-shortform directories...
+=09[ $total -gt 0 ] && total=3D`expr $total \* $isize / 512`
+
+=09cat >$tmp.proto <<EOF
+DUMMY1
+0 0
+: root directory
+d--777 3 1
+lost+found d--755 3 1
+$
+EOF
+
+=09while [ $count -lt $total ]
+=09do
+=09=09let count=3D$count+1
+=09=09cat >>$tmp.proto <<EOF
+${count}_of_${total}_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx ---755 3 1=
 /bin/true
+EOF
+=09done
+=09echo '$' >>$tmp.proto
+}
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os IRIX Linux
+
+_require_nobigloopfs
+_require_scratch
+
+# sanity test - default + one root directory entry
+# Note: must do this proto/mkfs now for later inode size calcs
+_create_proto 0
+echo "=3D=3D=3D one entry (shortform)"
+_scratch_mkfs_xfs -p $tmp.proto >$tmp.mkfs0 2>&1
+_filter_mkfs <$tmp.mkfs0 >/dev/null 2>$tmp.mkfs
+. $tmp.mkfs
+_check_repair
+
+# block-form root directory & repeat
+_create_proto 20
+echo "=3D=3D=3D twenty entries (block form)"
+_scratch_mkfs_xfs -p $tmp.proto | _filter_mkfs >/dev/null 2>&1
+_check_repair
+
+# leaf-form root directory & repeat
+_create_proto 1000
+echo "=3D=3D=3D thousand entries (leaf form)"
+_scratch_mkfs_xfs -p $tmp.proto | _filter_mkfs >/dev/null 2>&1
+_check_repair
+
+# success, all done
+status=3D0
+exit
