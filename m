+#!/bin/bash
+# FS QA Test No. 251
+#
+# This test was created in order to verify filesystem FITRIM implement=
ation.
+# By many concurrent copy and remove operations and checking that file=
s
+# does not change after copied into SCRATCH_MNT test if FITRIM impleme=
ntation
+# corrupts the filesystem (data/metadata).
+#
+#---------------------------------------------------------------------=
--
+# Copyright 2010 (C) Red Hat, Inc., Lukas Czerner <lczerner@redhat.com=
>
+#
+# This program is free software; you can redistribute it and/or
+# modify it under the terms of the GNU General Public License as
+# published by the Free Software Foundation.
+#
+# This program is distributed in the hope that it would be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#---------------------------------------------------------------------=
--
+
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D`mktemp -d`
+status=3D1    # failure is the default!
+trap "_cleanup; exit \$status" 0 1 3
+trap "_destroy; exit \$status" 2 15
+chpid=3D0
+mypid=3D$$
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs generic
+_supported_os Linux
+_require_scratch
+_require_fstrim
+_scratch_mkfs >/dev/null 2>&1
+_scratch_mount
+
+_cleanup()
+{
+=09rm -rf $tmp
+}
+
+_destroy()
+{
+=09kill $pids $fstrim_pid 2> /dev/null
+=09wait $pids $fstrim_pid 2> /dev/null
+=09rm -rf $tmp
+}
+
+_destroy_fstrim()
+{
+=09kill $fpid 2> /dev/null
+=09wait $fpid 2> /dev/null
+}
+
+_fail()
+{
+=09echo "$1"
+=09kill $mypid 2> /dev/null
+}
+
+_guess_max_minlen()
+{
+=09mmlen=3D100000
+=09while [ $mmlen -gt 1 ]; do
+=09=09$FSTRIM_PROG -l $(($mmlen*2))k -m ${mmlen}k $SCRATCH_MNT &> /dev=
/null && break
+=09=09mmlen=3D$(($mmlen/2))
+=09done
+=09echo $mmlen
+}
+
+##
+# Background FSTRIM loop. We are trimming the device in the loop and f=
or
+# test coverage, we are doing whole device trim followed by several sm=
aller
+# trims.
+##
+fstrim_loop()
+{
+=09trap "_destroy_fstrim; exit \$status" 2 15
+=09fsize=3D$(df | grep $SCRATCH_MNT | grep $SCRATCH_DEV  | awk '{print=
 $2}')
+=09mmlen=3D$(_guess_max_minlen)
+
+=09while true ; do
+=09=09step=3D$((RANDOM*$RANDOM+4))
+=09=09minlen=3D$(((RANDOM*($RANDOM%2+1))%$mmlen))
+=09=09start=3D$RANDOM
+=09=09if [ $((RANDOM%10)) -gt 7 ]; then
+=09=09=09$FSTRIM_PROG $SCRATCH_MNT &
+=09=09=09fpid=3D$!
+=09=09=09wait $fpid
+=09=09fi
+=09=09while [ $start -lt $fsize ] ; do
+=09=09=09$FSTRIM_PROG -m ${minlen}k -o ${start}k -l ${step}k $SCRATCH_=
MNT &
+=09=09=09fpid=3D$!
+=09=09=09wait $fpid
+=09=09=09start=3D$(( $start + $step ))
+=09=09done
+=09done
+}
+
+function check_sums() {
+=09(
+=09cd $SCRATCH_MNT/$p
+=09find -P . -xdev -type f -print0 | xargs -0 md5sum | sort -o $tmp/st=
ress.$$.$p
+=09)
+
+=09diff $tmp/content.sums $tmp/stress.$$.$p
+=09if [ $? -ne 0 ]; then
+=09=09_fail "!!!Checksums has changed - Filesystem possibly corrupted!=
!!\n"
+=09fi
+=09rm -f $tmp/stress.$$.$p
+}
+
+function run_process() {
+=09local p=3D$1
+=09repeat=3D10
+
+=09sleep $((5*$p))s &
+=09export chpid=3D$! && wait $chpid &> /dev/null
+=09chpid=3D0
+
+=09while [ $repeat -gt 0 ]; do
+
+=09=09# Remove old directories.
+=09=09rm -rf $SCRATCH_MNT/$p
+=09=09export chpid=3D$! && wait $chpid &> /dev/null
+
+=09=09# Copy content -> partition.
+=09=09mkdir $SCRATCH_MNT/$p
+=09=09cp -axT $content/ $SCRATCH_MNT/$p/
+=09=09export chpid=3D$! && wait $chpid &> /dev/null
+
+=09=09check_sums
+=09=09repeat=3D$(( $repeat - 1 ))
+=09done
+}
+
+nproc=3D20
+content=3D$here
+
+# Check for FITRIM support
+echo -n "Checking FITRIM support: "
+_test_batched_discard $SCRATCH_MNT || _notrun "FITRIM not supported on=
 $SCRATCH_DEV"
+echo "done."
+
+mkdir -p $tmp
+
+(
+cd $content
+find -P . -xdev -type f -print0 | xargs -0 md5sum | sort -o $tmp/conte=
nt.sums
+)
+
+echo -n "Running the test: "
+pids=3D""
+fstrim_loop &
+fstrim_pid=3D$!
+p=3D1
+while [ $p -le $nproc ]; do
+=09run_process $p &
+=09pids=3D"$pids $!"
+=09p=3D$(($p+1))
+done
+echo "done."
+
+wait $pids
+kill $fstrim_pid
+wait $fstrim_pid
+
+status=3D0
+
+exit
