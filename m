+=09=09tr ',' '\n' | $SED_PROG 's/^ //' | \
+=09=09$AWK_PROG -v spb=3D$sectors_per_block 'BEGIN{FS=3D"-"};
+=09=09     NF {
+=09=09=09if($2 !=3D "") # range of blocks
+=09=09=09=09print spb * $1, spb * ($2 + 1) - 1;
+=09=09=09else=09=09# just single block
+=09=09=09=09print spb * $1, spb * ($1 + 1) - 1;
+=09=09     }'
+=09;;
+=09xfs)
+=09agsize=3D`xfs_info $loop_mnt | $SED_PROG -n 's/.*agsize=3D\(.*\) bl=
ks.*/\1/p'`
+=09# Convert free space (agno, block, length) to (start sector, end se=
ctor)
+=09$UMOUNT_PROG $loop_mnt
+=09$XFS_DB_PROG -c "freesp -d" $img_file | $SED_PROG '/^.*from/,$d'| \
+=09=09 $AWK_PROG -v spb=3D$sectors_per_block -v agsize=3D$agsize \
+=09=09'{ print spb * ($1 * agsize + $2), spb * ($1 * agsize + $2 + $3)=
 - 1 }'
+=09;;
+=09esac
+}
+
+merge_ranges()
+{
+=09# Merges consecutive ranges from two input files
+=09file1=3D$1
+=09file2=3D$2
+
+=09tmp_file=3D$tmp/sectors.tmp
+
+=09cat $file1 $file2 | sort -n > $tmp_file
+
+=09read line < $tmp_file
+=09start=3D${line% *}
+=09end=3D${line#* }
+
+=09# Continue from second line
+=09sed -i "1d" $tmp_file
+=09while read line; do
+=09=09curr_start=3D${line% *}
+=09=09curr_end=3D${line#* }
+
+=09=09if [ `expr $end + 1` -ge $curr_start ]; then
+=09=09=09if [ $curr_end -gt $end ]; then
+=09=09=09=09end=3D$curr_end
+=09=09=09fi
+=09=09else
+=09=09=09echo $start $end
+=09=09=09start=3D$curr_start
+=09=09=09end=3D$curr_end
+=09=09fi
+=09done < $tmp_file
+
+=09# Print last line
+=09echo $start $end
+
+=09rm $tmp_file
+}
+
+here=3D`pwd`
+tmp=3D`mktemp -d`
+
+img_file=3D$TEST_DIR/$$.fs
+dd if=3D/dev/zero of=3D$img_file bs=3D1M count=3D300 &> /dev/null
+
+loop_dev=3D$(_create_loop_device $img_file)
+loop_mnt=3D$tmp/loop_mnt
+
+fiemap_ref=3D"$tmp/reference"
+fiemap_after=3D"$tmp/after"
+free_sectors=3D"$tmp/free_sectors"
+merged_sectors=3D"$tmp/merged_free_sectors"
+
+mkdir $loop_mnt
+
+[ "$FSTYP" =3D "xfs" ] && MKFS_OPTIONS=3D"-f $MKFS_OPTIONS"
+
+$MKFS_PROG -t $FSTYP $MKFS_OPTIONS $loop_dev &> /dev/null
+$MOUNT_PROG $loop_dev $loop_mnt
+
+echo -n "Generating garbage on loop..."
+for i in `seq 1 10`; do
+=09mkdir $loop_mnt/$i
+=09cp -r $here/* $loop_mnt/$i
+done
+
+# Get reference fiemap, this can contain i.e. uninitialized inode tabl=
e
+sync
+get_holes $img_file > $fiemap_ref
+
+# Delete some files
+find $loop_mnt -type f -print | $AWK_PROG \
+=09'BEGIN {srand()}; {if(rand() > 0.7) print $1;}' | xargs rm
+echo "done."
+
+echo -n "Running fstrim..."
+$FSTRIM_PROG $loop_mnt &> /dev/null
+echo "done."
+
+echo -n "Detecting interesting holes in image..."
+# Get after-trim fiemap
+sync
+get_holes $img_file > $fiemap_after
+echo "done."
+
+echo -n "Comparing holes to the reported space from FS..."
+# Get block size
+block_size=3D$(stat -f -c "%S" $loop_mnt/)
+sectors_per_block=3D`expr $block_size / 512`
+
+# Obtain free space from filesystem
+get_free_sectors > $free_sectors
+# Merge original holes with free sectors
+merge_ranges $fiemap_ref $free_sectors > $merged_sectors
+
+# Check that all holes after fstrim call were already present before o=
r
+# that they match free space reported from FS
+while read line; do
+        from=3D${line% *}
+        to=3D${line#* }
+=09if ! $AWK_PROG -v s=3D$from -v e=3D$to \
+=09=09'{ if ($1 <=3D s && e <=3D $2) found =3D 1};
+=09=09END { if(found) exit 0; else exit 1}' $merged_sectors
+=09then
+=09=09echo "Sectors $from-$to are not marked as free!"
+=09=09exit
+=09fi
+done < $fiemap_after
+echo "done."
+
+status=3D0
+exit
