+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.attr
+
+_cleanup()
+{
+        cd /
+=09echo; echo "*** unmount"
+=09umount $SCRATCH_MNT 2>/dev/null
+=09rm -f $tmp.*
+}
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+getfattr()
+{
+    $GETFATTR_PROG --absolute-names -dh $@ 2>&1 | _filter_scratch
+}
+
+setfattr()
+{
+    $SETFATTR_PROG $@ 2>&1 | _filter_scratch
+}
+
+_create_test_bed()
+{
+=09echo "*** create test bed"
+=09touch $SCRATCH_MNT/reg
+=09mkdir -p $SCRATCH_MNT/dir
+=09ln -s $SCRATCH_MNT/dir $SCRATCH_MNT/lnk
+=09mkdir $SCRATCH_MNT/dev
+=09mknod $SCRATCH_MNT/dev/b b 0 0
+=09mknod $SCRATCH_MNT/dev/c c 0 0
+=09mknod $SCRATCH_MNT/dev/p p
+=09# sanity check
+=09find $SCRATCH_MNT | LC_COLLATE=3DPOSIX sort | _filter_scratch | gre=
p -v "lost+found"
+}
+
+# real QA test starts here
+_supported_fs generic
+_supported_os Linux
+
+_require_scratch
+_require_attrs
+
+rm -f $tmp.backup1 $tmp.backup2 $seq.full
+
+# real QA test starts here
+_scratch_mkfs > /dev/null 2>&1 || _fail "mkfs failed"
+_scratch_mount || _fail "mount failed"
+_create_test_bed
+
+# In kernels before 3.0, getxattr() fails with EPERM for an attribute =
which
+# cannot exist.  Later kernels fail with ENODATA.  Accept both results=
.
+invalid_attribute_filter() {
+=09sed -e "s:\(No such attribute\|Operation not permitted\):No such at=
tribute or operation not permitted:"
+}
+
+if [ "$USE_ATTR_SECURE" =3D yes ]; then
+    ATTR_MODES=3D"user security trusted"
+else
+    ATTR_MODES=3D"user trusted"
+fi
+for nsp in $ATTR_MODES; do
+=09for inode in reg dir lnk dev/b dev/c dev/p; do
+
+=09=09echo; echo "=3D=3D=3D TYPE $inode; NAMESPACE $nsp"; echo
+=09=09echo "*** set/get one initially empty attribute"
+   =20
+=09=09setfattr -h -n $nsp.name $SCRATCH_MNT/$inode
+=09=09getfattr -m $nsp $SCRATCH_MNT/$inode
+
+=09=09echo "*** overwrite empty, set several new attributes"
+=09=09setfattr -h -n $nsp.name -v 0xbabe $SCRATCH_MNT/$inode
+=09=09setfattr -h -n $nsp.name2 -v 0xdeadbeef $SCRATCH_MNT/$inode
+=09=09setfattr -h -n $nsp.name3 -v 0xdeface $SCRATCH_MNT/$inode
+
+=09=09echo "*** fetch several attribute names and values (hex)"
+=09=09getfattr -m $nsp -e hex $SCRATCH_MNT/$inode
+
+=09=09echo "*** fetch several attribute names and values (base64)"
+=09=09getfattr -m $nsp -e base64 $SCRATCH_MNT/$inode
+=09=09
+=09=09echo "*** shrink value of an existing attribute"
+=09=09setfattr -h -n $nsp.name2 -v 0xdeaf $SCRATCH_MNT/$inode
+=09=09getfattr -m $nsp -e hex $SCRATCH_MNT/$inode
+
+=09=09echo "*** grow value of existing attribute"
+=09=09setfattr -h -n $nsp.name2 -v 0xdecade $SCRATCH_MNT/$inode
+=09=09getfattr -m $nsp -e hex $SCRATCH_MNT/$inode
+=09=09
+=09=09echo "*** set an empty value for second attribute"
+=09=09setfattr -h -n $nsp.name2 $SCRATCH_MNT/$inode
+=09=09getfattr -m $nsp -n $nsp.name2 $SCRATCH_MNT/$inode 2>&1 | invali=
d_attribute_filter
+
+=09=09echo "*** overwrite empty value"
+=09=09setfattr -h -n $nsp.name2 -v 0xcafe $SCRATCH_MNT/$inode
+=09=09getfattr -m $nsp -e hex -n $nsp.name2 $SCRATCH_MNT/$inode 2>&1 |=
 invalid_attribute_filter
+
+=09=09echo "*** remove attribute"
+=09=09setfattr -h -x $nsp.name2 $SCRATCH_MNT/$inode
+=09=09getfattr -m $nsp -e hex -n $nsp.name2 $SCRATCH_MNT/$inode 2>&1 |=
 invalid_attribute_filter
+
+=09=09echo "*** final list (strings, type=3D$inode, nsp=3D$nsp)"
+=09=09getfattr -m '.' -e hex $SCRATCH_MNT/$inode
+=09
+=09done
+done
+
+
+#=20
+# Test the directory descent code
+#=20
+echo; echo
+
+_extend_test_bed()
+{
+=09echo "*** extend test bed"
+=09# must set some descents' attributes to be useful
+=09mkdir -p $SCRATCH_MNT/here/up/ascend
+=09mkdir -p $SCRATCH_MNT/descend/down/here
+=09find $SCRATCH_MNT/descend | xargs setfattr -n user.x -v yz
+=09find $SCRATCH_MNT/descend | xargs setfattr -n user.1 -v 23
+=09find $SCRATCH_MNT/here | xargs setfattr -n trusted.a -v bc
+=09find $SCRATCH_MNT/here | xargs setfattr -n trusted.9 -v 87
+=09# whack a symlink in the middle, just to be difficult
+=09ln -s $SCRATCH_MNT/here/up $SCRATCH_MNT/descend/and
+=09# dump out our new starting point
+=09find $SCRATCH_MNT | LC_COLLATE=3DPOSIX sort | _filter_scratch | gre=
p -v "lost+found"
+}
+
+_extend_test_bed
+
+echo
+echo "*** directory descent with us following symlinks"
+getfattr -h -L -R -m '.' -e hex $SCRATCH_MNT | _sort_getfattr_output
+
+echo
+echo "*** directory descent without following symlinks"
+getfattr -h -P -R -m '.' -e hex $SCRATCH_MNT | _sort_getfattr_output
+
+
+#=20
+# Test the backup/restore code
+#=20
+echo; echo
+
+_backup()
+{
+=09# NB: no filtering of scratch here... (need to restore too)
+=09$GETFATTR_PROG --absolute-names -dh -R -m '.' $SCRATCH_MNT >$1
+=09echo BACKUP $1 >>$seq.full
+=09cat $1 >> $seq.full
+=09[ ! -s $1 ] && echo "warning: $1 (backup file) is empty"
+}
+
+echo "*** backup everything"
+_backup $tmp.backup1
+
+echo "*** clear out the scratch device"
+rm -fr $SCRATCH_MNT/*
+echo "AFTER REMOVE" >>$seq.full
+getfattr -L -R -m '.' $SCRATCH_MNT >>$seq.full
+
+echo "*** reset test bed with no extended attributes"
+_create_test_bed
+_extend_test_bed
+
+echo "*** restore everything"
+setfattr -h --restore=3D$tmp.backup1
+_backup $tmp.backup2
+
+echo "AFTER RESTORE" >>$seq.full
+getfattr -L -R -m '.' $SCRATCH_MNT >>$seq.full
+
+echo "*** compare before and after backups"
+diff $tmp.backup1 $tmp.backup2
+if [ $? -ne 0 ]; then
+=09echo "urk, failed - creating $seq.backup1 and $seq.backup2"
+=09cp $tmp.backup1 $seq.backup1 && cp $tmp.backup2 $seq.backup2
+=09status=3D1
+=09exit
+fi
+
+# success, all done
+status=3D0
+exit
