-_scratch_mkfs >/dev/null 2>&1
-_scratch_mount
-
-# Initialize and mount the scratch filesystem, then create a bunch
-# of files that exercise the original problem.
-#
-# The problem arose when a file name produced a hash that contained
-# either 0x00 (string terminator) or 0x27 ('/' character) in a
-# spot used to determine a character in an obfuscated name.  This
-# occurred in one of 5 spots at the end of the name, at position
-# (last-4), (last-3), (last-2), (last-1), or (last).
-
-rm -f "${METADUMP_FILE}"
-
-mkdir -p "${OUTPUT_DIR}"
-
-cd "${OUTPUT_DIR}"
-# Start out with some basic test files
-create_file 'abcde'=09=09# hash 0x1c58f263 ("normal" name)
-
-create_file 'f'=09=09=09# hash 0x00000066 (1-byte name)
-create_file 'gh'=09=09# hash 0x000033e8 (2-byte name)
-create_file 'ijk'=09=09# hash 0x001a756b (3-byte name)
-create_file 'lmno'=09=09# hash 0x0d9b776f (4-byte name)
-create_file 'pqrstu'=09=09# hash 0x1e5cf9f2 (6-byte name)
-create_file 'abcdefghijklmnopqrstuvwxyz' # a most remarkable word (0x5=
5004ae3)
-
-# Create a short directory name; it won't be obfuscated.  Populate
-# it with some longer named-files.  The first part of the obfuscated
-# filenames should use printable characters.
-mkdir foo
-create_file 'foo/longer_file_name_1'=09# hash 0xe83634ec
-create_file 'foo/longer_file_name_2'=09# hash 0xe83634ef
-create_file 'foo/longer_file_name_3'=09# hash 0xe83634ee
-
-# Now create a longer directory name
-mkdir longer_directory_name
-create_file 'longer_directory_name/f1'=09# directory hash 0x9c7accdd
-create_file 'longer_directory_name/f2'=09# filenames are short, no has=
h
-create_file 'longer_directory_name/f3'
-
-# The problematic name originally reported by Arkadiusz Mi=C5=9Bkiewic=
z
-
-create_file 'R\323\257NE'=09# hash 0x3a4be740, forces  (last-3) =3D 0x=
2f
-
-# Other names that force a 0x00 byte
-create_file 'Pbcde'=09=09# hash 0x0c58f260, forces  (last-4) =3D 0x00
-create_file 'a\001\203de'=09# hash 0x1000f263, forces  (last-3) =3D 0x=
00
-create_file 'ab\001\344e'=09# hash 0x1c403263, forces  (last-2) =3D 0x=
00
-create_file 'abc\200e'=09=09# hash 0x1c588063, forces  (last-1) =3D 0x=
00
-create_file 'abcd\006'=09=09# hash 0x1c58f200, forces    (last) =3D 0x=
00
-
-# Names that force a 0x2f byte; note no name will ever force (last-4) =
=3D 0x2f
-create_file 'a.\343de'=09=09# hash 0x15f8f263 forces   (last-3) =3D 0x=
00
-create_file 'ac\257de'=09=09# hash 0x1c4bf263, forces  (last-2) =3D 0x=
2f
-create_file 'abe\257e'=09=09# hash 0x1c5917e3, forces  (last-1) =3D 0x=
2f
-create_file 'abcd)'=09=09# hash 0x1c58f22f, forces    (last) =3D 0x2f
-
-# The following names are possible results of obfuscating the name
-# "abcde".  Previously, xfs_metadump could get hung up trying to
-# obfuscate names when too many of the same length had the same hash
-# value.
-create_file '!bcda'=09=09# essentially a dup of 'abcde'
-create_file 'Abcdg'=09=09# essentially a dup of 'abcde'
-create_file 'qbcdd'=09=09# essentially a dup of 'abcde'
-create_file '1bcd`'=09=09# essentially a dup of 'abcde'
-create_file 'Qbcdf'=09=09# essentially a dup of 'abcde'
-create_file '\001bcdc'=09=09# essentially a dup of 'abcde'
-create_file 'Qbce\346'=09=09# essentially a dup of 'abcde'
-create_file 'abb\344e'=09=09# essentially a dup of 'abcde'
-
-# The orphanage directory (lost+found) should not be obfuscated.
-# Files thereunder can be, but not if their name is the same as
-# their inode number.  Test this.
-
-cd "${SCRATCH_MNT}"
-mkdir -p "${ORPHANAGE}"
-
-TEMP_ORPHAN=3D"${ORPHANAGE}/__orphan__"
-NON_ORPHAN=3D"${ORPHANAGE}/__should_be_obfuscated__"
-
-# Create an orphan, whose name is the same as its inode number
-touch "${TEMP_ORPHAN}"
-INUM=3D$(ls -i "${TEMP_ORPHAN}" | awk '{ print $1; }')
-ORPHAN=3D"${SCRATCH_MNT}/lost+found/${INUM}"
-mv "${TEMP_ORPHAN}" "${ORPHAN}"
-
-# Create non-orphan, which *should* be obfuscated
-touch "${NON_ORPHAN}"
-
-# Get a listing of all the files before obfuscation
-ls -R >> "${seq}.full"
-ls -R | od -c >> "${seq}.full"
-
-# Now unmount the filesystem and create a metadump file
-cd /; sync; sync=09=09# Old school
-
-_scratch_unmount
-
-xfs_metadump -f "${SCRATCH_DEV}" "${METADUMP_FILE}"
-
-# Now restore the obfuscated one back and take a look around
-xfs_mdrestore "${METADUMP_FILE}" "${SCRATCH_DEV}"
-
-_scratch_mount
-
-# Get a listing of all the files after obfuscation
-cd "${SCRATCH_MNT}"
-ls -R >> "${seq}.full"
-ls -R | od -c >> "${seq}.full"
-
-# Finally, re-make the filesystem since to ensure we don't
-# leave a directory with duplicate entries lying around.
-cd /
-_scratch_unmount
-_scratch_mkfs >/dev/null 2>&1
-
-# all done
-status=3D0
-exit
