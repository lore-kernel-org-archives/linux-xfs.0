-. ./common.repair
-
-# link correct .out file
-_link_out_file $seq.out
-
-# nuke the superblock, AGI, AGF, AGFL; then try repair the damage
-#
-_check_ag()
-{
-=09for structure in 'sb 0' 'agf 0' 'agi 0' 'agfl 0'
-=09do
-=09=09echo "Corrupting $structure - setting bits to $1"
-=09=09_check_repair $1 "$structure" |
-=09=09=09sed -e '/^error following ag 0 unlinked list$/d'
-=09done
-}
-
-# real QA test starts here
-_supported_fs xfs
-_supported_os IRIX Linux
-
-_require_nobigloopfs
-_require_scratch
-
-DSIZE=3D"-dsize=3D100m,agcount=3D6"
-
-# first we need to ensure there are no bogus secondary
-# superblocks between the primary and first secondary
-# superblock (hanging around from earlier tests)...
-#
-
-_scratch_mkfs_xfs $DSIZE >/dev/null 2>&1
-if [ $? -ne 0 ]=09=09# probably don't have a big enough scratch
-then
-=09_notrun "SCRATCH_DEV too small, results would be non-deterministic"
-else
-=09_scratch_mount
-=09src/feature -U $SCRATCH_DEV && \
-=09=09_notrun "UQuota are enabled, test needs controlled sb recovery"
-=09src/feature -G $SCRATCH_DEV && \
-=09=09_notrun "GQuota are enabled, test needs controlled sb recovery"
-=09src/feature -P $SCRATCH_DEV && \
-=09=09_notrun "PQuota are enabled, test needs controlled sb recovery"
-=09umount $SCRATCH_DEV
-fi
-clear=3D""
-eval `xfs_db -r -c "sb 1" -c stack $SCRATCH_DEV | perl -ne '
-=09if (/byte offset (\d+), length (\d+)/) {
-=09=09print "clear=3D", $1 / 512, "\n"; exit
-=09}'`
-[ -z "$clear" ] && echo "Cannot calculate length to clear"
-src/devzero -v -1 -n "$clear" $SCRATCH_DEV >/dev/null
-
-# now kick off the real repair test...
-#
-_scratch_mkfs_xfs $DSIZE | _filter_mkfs 2>$tmp.mkfs
-. $tmp.mkfs
-_check_ag 0
-_check_ag -1
-
-
-# success, all done
-status=3D0
-exit
