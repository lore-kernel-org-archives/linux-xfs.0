+	xfs_agnumber_t	agno;
+	int		gflag =3D 0;
+	int		c;
+
+	while ((c =3D getopt(argc, argv, "gs")) !=3D EOF) {
+		switch (c) {
+		case 'g':
+			gflag =3D 1;
+			break;
+		default:
