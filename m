-
-echo ""
-echo "=3D=3D=3D Test can read ACLs without access permissions =3D=3D=
=3D"
-# This was a bug in kernel code where syscred wasn't being used
-# to override the capabilities
-chacl o::---,g::---,u::--- file1 2>&1
-_acl_list file1
-
