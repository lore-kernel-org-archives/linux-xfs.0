-_cleanup()
-{
-=09cd /
-=09umount $SCRATCH_MNT 2>/dev/null
-=09umount -d $imgs.loop 2>/dev/null
-=09[ -d $imgs.loop ] && rmdir $imgs.loop
-=09umount -d $imgs.source_dir 2>/dev/null
-=09[ -d $imgs.source_dir ] && rm -rf $imgs.source_dir
-=09rm -f $imgs.* $tmp.* /var/tmp/xfs_copy.log.*
-}
-trap "_cleanup; exit \$status" 0 1 2 3 15
