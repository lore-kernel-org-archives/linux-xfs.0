diff --git a/tests/xfs/087 b/tests/xfs/087
new file mode 100755
index 0000000..3cb6990
--- /dev/null
+++ b/tests/xfs/087
@@ -0,0 +1,152 @@
+#! /bin/bash
+# FS QA Test No. 087
+#
+# * like 086 but want to create more/different kinds of metadata
+#   and so will use fsstress
+# * also can interrupt metadata with godown
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2000-2004 Silicon Graphics, Inc.  All Rights Reserved.
+#
+# This program is free software; you can redistribute it and/or
+# modify it under the terms of the GNU General Public License as
+# published by the Free Software Foundation.
+#
+# This program is distributed in the hope that it would be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.log
+. ./common.quota
+
+_do_meta()
+{
+    out=3D$SCRATCH_MNT/fsstress
+    count=3D10000
+    param=3D"-p 4 -z -f rmdir=3D10 -f link=3D10 -f creat=3D10 -f mkdir=
=3D10 \
+           -f rename=3D30 -f stat=3D30 -f unlink=3D30 -f truncate=3D20=
"
+    _echofull "calling fsstress $param -m8 -n $count"
+    FSSTRESS_ARGS=3D`_scale_fsstress_args $param $FSSTRESS_AVOID -m 8 =
-n $count -d $out`
+    if ! $FSSTRESS_PROG $FSSTRESS_ARGS >>$seq.full 2>&1
+    then
+=09_echofull "fsstress failed"
+    fi
+}
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os IRIX Linux
+
+rm -f $seq.full $tmp.*
+_require_scratch
+_require_v2log=20
+_require_xfs_quota
+
+echo "*** init FS"
+umount $SCRATCH_DEV >/dev/null 2>&1
+
+cat >$tmp.seq.params <<EOF
+# mkfs-opt             mount-opt
+# ------------------------------
+  version=3D2            logbsize=3D32k
+  version=3D2,su=3D4096    logbsize=3D32k
+  version=3D2,su=3D32768   logbsize=3D32k
+  version=3D2            logbsize=3D64k
+  version=3D2,su=3D64k     logbsize=3D64k
+  version=3D2            logbsize=3D128k
+  version=3D2,su=3D128k    logbsize=3D128k
+  version=3D2            logbsize=3D256k
+  version=3D2,su=3D256k    logbsize=3D256k
+EOF
+
+cat $tmp.seq.params \
+| while read mkfs mnt restofline
+do
+    if [ "$mkfs" =3D "#" ]; then=20
+=09continue
+    fi
+
+    echo "--- mkfs=3D$mkfs, mnt=3D$mnt ---"
+    export MKFS_OPTIONS=3D"-l $mkfs"
+    export MOUNT_OPTIONS=3D"-o $mnt"
+
+    # mkfs the FS
+    _echofull "mkfs"
+    _scratch_mkfs_xfs >>$seq.full 2>&1
+    if [ $? -ne 0 ] ; then=20
+=09_echofull "mkfs failed: $MKFS_OPTIONS"
+=09continue
+    fi
+
+    # mount the FS
+    _echofull "mount"
+    if ! _scratch_mount -o uquota >>$seq.full 2>&1; then
+=09_echofull "mount failed: $MOUNT_OPTIONS"
+=09continue
+    fi
+
+    # create the metadata
+    _do_meta
+
+    # check before on what FS should look like
+    _echofull "ls -RF SCRATCH_MNT"
+    ls -RF $SCRATCH_MNT >$tmp.ls1
+
+    _echofull "godown"
+    src/godown -v -f $SCRATCH_MNT >> $seq.full
+
+    _echofull "unmount"
+    umount $SCRATCH_DEV >>$seq.full 2>&1 \
+=09|| _fail "umount failed"
+
+    _echofull "logprint after going down..."
+    _print_logstate
+
+    _full "logprint headers"
+    _scratch_xfs_logprint -n >>$seq.full 2>&1
+
+    _echofull "mount with replay"
+    _scratch_mount -o uquota >>$seq.full 2>&1 \
+=09|| _fail "mount failed: $MOUNT_OPTIONS"
+
+    # check on what FS looks like after log recovery
+    _echofull "ls -RF SCRATCH_MNT"
+    ls -RF $SCRATCH_MNT >$tmp.ls2
+
+    _echofull "diff ls before and after"
+    diff -us $tmp.ls1 $tmp.ls2 | sed "s#$tmp#TMP#g"
+
+    _echofull "unmount"
+    umount $SCRATCH_MNT
+
+    _echofull "logprint after mount and replay..."
+    _print_logstate
+
+    if _check_scratch_fs; then
+=09_echofull "filesystem is checked ok"
+    else
+=09_echofull "filesystem is NOT ok"
+    fi
+done
+
+status=3D0=20
+exit
