+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+
+_supported_fs generic
+_supported_os Linux IRIX
+_require_scratch
+
+# real QA test starts here
+rm -f $seq.full
+
+umount $SCRATCH_DEV 2>/dev/null
+echo "--> mkfs 256m filesystem"
+_scratch_mkfs_sized `expr 256 \* 1024 \* 1024` >> $seq.full 2>&1
+_scratch_mount
+
+loops=3D16
+
+# Buffer size argument supplied to xfs_io "pwrite" command
+buffer=3D"-b $(expr 512 \* 1024)"
+
+echo "--> $loops buffered 64m writes in a loop"
+for I in `seq 1 $loops`; do
+=09echo -n "$I "
+=09xfs_io -F -f \
+=09=09-c "pwrite ${buffer} 0 64m" $SCRATCH_MNT/test >> $seq.full
+=09rm -f $SCRATCH_MNT/test
+done
+
+echo
+umount $SCRATCH_DEV
+_scratch_mount
+
+echo "--> $loops direct 64m writes in a loop"
+for I in `seq 1 $loops`; do
+=09echo -n "$I "
+=09xfs_io -F -f -d \
+=09=09-c "pwrite ${buffer} 0 64m" $SCRATCH_MNT/test >> $seq.full
+=09rm -f $SCRATCH_MNT/test=20
+done
+
+echo
+umount $SCRATCH_DEV
+
+status=3D0
+exit
