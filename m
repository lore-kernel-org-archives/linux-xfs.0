+=09sed -e '/secure =3D /d' | sed -e '/parent =3D /d'
+
+echo "*** dump attributes (2)"
+
+xfs_db -r -c "inode $inum_2" -c "a a.bmx[0].startblock" -c print $SCRA=
TCH_DEV \
+=09| perl -ne '
+s/,secure//;
+s/,parent//;
+s/^(hdr.firstused =3D) (\d+)/\1 FIRSTUSED/;
+s/^(hdr.freemap\[0-2] =3D \[base,size]).*/\1 [FREEMAP..]/;
+s/^(entries\[0-2] =3D \[hashval,nameidx,incomplete,root,local]).*/\1 [=
ENTRIES..]/;
+=09print;'
+
+echo "*** done"
+exit
