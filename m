+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+# creator
+owner=3Ddmonakhov@openvz.org
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs generic
+_supported_os Linux
+_need_to_be_root
+_require_scratch
+
+NUM_JOBS=3D$((4*LOAD_FACTOR))
+BLK_DEV_SIZE=3D`blockdev --getsz $SCRATCH_DEV`
+FILE_SIZE=3D$((BLK_DEV_SIZE * 512))
+
+cat >$tmp-$seq.fio <<EOF
+###########
+# $seq test fio activity
+# Filenames derived from jobsname and jobid like follows:
+# ${JOB_NAME}.${JOB_ID}.${ITERATION_ID}
+[global]
+ioengine=3Dlibaio
+bs=3D128k
+directory=3D${SCRATCH_MNT}
+filesize=3D${FILE_SIZE}
+size=3D999G
+iodepth=3D128*${LOAD_FACTOR}
+continue_on_error=3Dwrite
+ignore_error=3D,ENOSPC
+error_dump=3D0
+create_on_open=3D1
+fallocate=3Dnone
+exitall=3D1
+
+## Perform direct aio, to files which may be truncated
+## by external task
+[direct_aio]
+direct=3D1
+buffered=3D0
+numjobs=3D${NUM_JOBS}
+rw=3Drandwrite
+runtime=3D100*${TIME_FACTOR}
+time_based
+
+# Perform direct aio and verify data
+# This test case should check use-after-free issues
+[aio-dio-verifier]
+numjobs=3D1
+verify=3Dcrc32c-intel
+verify_fatal=3D1
+verify_dump=3D1
+verify_backlog=3D1024
+verify_async=3D4
+verifysort=3D1
+direct=3D1
+bs=3D4k
+rw=3Drandrw
+filename=3Daio-dio-verifier
+
+# Perform buffered aio and verify data
+# This test case should check use-after-free issues
+[buffered-aio-verifier]
+numjobs=3D1
+verify=3Dcrc32c-intel
+verify_fatal=3D1
+verify_dump=3D1
+verify_backlog=3D1024
+verify_async=3D4
+verifysort=3D1
+direct=3D0
+buffered=3D1
+bs=3D4k
+rw=3Drandrw
+filename=3Dbuffered-aio-verifier
+EOF
+
+_require_fio $tmp-$seq.fio
+
+_workout()
+{
+=09echo ""
+=09echo "Run fio with random aio-dio pattern"
+=09echo ""
+=09cat $tmp-$seq.fio >>  $seq.full
+=09run_check $FIO_PROG $tmp-$seq.fio &
+=09pid=3D$!
+=09echo "Start fallocate/truncate loop"
+
+=09for ((i=3D0; ; i++))
+=09do
+=09    for ((k=3D1; k <=3D NUM_JOBS; k++))
+=09    do
+=09=09fallocate -l $FILE_SIZE $SCRATCH_MNT/direct_aio.$k.0 \
+=09=09=09>> $seq.full 2>&1
+=09    done
+=09    for ((k=3D1; k <=3D NUM_JOBS; k++))
+=09    do
+=09=09truncate -s 0 $SCRATCH_MNT/direct_aio.$k.0
+=09    done
+=09    # Following like will check that pid is still run.
+=09    # Once fio exit we can stop fallocate/truncate loop
+=09    kill -0 $pid > /dev/null 2>&1 || break
+=09done
+=09wait $pid
+}
+
+_scratch_mkfs >> $seq.full 2>&1
+_scratch_mount
+
+if ! _workout; then
+=09umount $SCRATCH_DEV 2>/dev/null
+=09exit
+fi
+
+if ! _scratch_unmount; then
+=09echo "failed to umount"
+=09status=3D1
+=09exit
+fi
+_check_scratch_fs
+status=3D$?
+exit
