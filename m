+=09rm -f $tmp.*
+}
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs generic
+_supported_os IRIX Linux
+
+_require_scratch
+_require_nobigloopfs
+
+rm -f $seq.full
+
+workout()
+{
+=09fsz=3D$1
+=09ags=3D$2
+=09procs=3D$3
+=09nops=3D$4
+
+=09umount $SCRATCH_DEV >/dev/null 2>&1
+=09echo "*** mkfs -dsize=3D$fsz,agcount=3D$ags"    >>$seq.full
+=09echo ""                                     >>$seq.full
+=09if [ $FSTYP =3D xfs ]
+=09then
+=09=09_scratch_mkfs_xfs -dsize=3D$fsz,agcount=3D$ags  >>$seq.full 2>&1=
 \
+=09=09=09|| _fail "size=3D$fsz,agcount=3D$ags mkfs failed"
+=09else
