-_link_out_file $seq.out
-
-# nuke the root, rt bitmap, and rt summary inodes
-#=20
-_check_root_inos()
-{
-=09echo "Corrupting root inode - setting bits to $1"
-=09_check_repair $1 "inode $rootino"
-=09echo "Corrupting rt bitmap inode - setting bits to $1"
-=09_check_repair $1 "inode $rbmino"
-=09echo "Corrupting rt summary inode - setting bits to $1"
-=09_check_repair $1 "inode $rsumino"
-}
-
-#
-# pv#909621
-# IRIX checks for valid user and group ids as we have a=20
-# limit of MAXID
-# As it is unsigned on Linux, this test is not done
-# (i.e. -1 is a valid id on Linux but not on IRIX)
-# So we make the output the same for both OS's.
-#
-_filter_bad_ids()
-{
-=09egrep -v 'bad user id 0xffffffff|bad group id 0xffffffff'
-}
