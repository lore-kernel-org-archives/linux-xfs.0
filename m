-{
-=09fsz=3D$1
-=09ags=3D$2
-=09procs=3D$3
-=09nops=3D$4
-
-=09umount $SCRATCH_DEV >/dev/null 2>&1
-=09echo "*** mkfs -dsize=3D$fsz,agcount=3D$ags"    >>$seq.full
