+
+# seek_copy_test_01: tests file with holes and written data extents.
+# verify results:
+# 1. file size is identical.
+# 2. perform cmp(1) to compare SRC and DEST file byte by byte.
+test01()
+{
+=09rm -f $src $dest
+
+=09write_cmd=3D"-c \"truncate 100m\""
+=09for i in $(seq 0 5 100); do
+=09=09offset=3D$(($i * $((1 << 20))))
+=09=09write_cmd=3D"$write_cmd -c \"pwrite $offset 1m\""
+=09done
+
+=09echo "*** test01() create sparse file ***" >>$seq.full
+=09eval ${XFS_IO_PROG} -F -f "${write_cmd}" $src >>$seq.full 2>&1 ||
+=09=09_fail "create sparse file failed!"
+=09echo "*** test01() create sparse file done ***" >>$seq.full
+=09echo >>$seq.full
+
+=09$here/src/seek_copy_test $src $dest
+=09
+=09test $(stat --printf "%s" $src) =3D $(stat --printf "%s" $dest) ||
+=09=09_fail "TEST01: file size check failed"
+
+=09cmp $src $dest || _fail "TEST01: file bytes check failed"
+}
+
+# seek_copy_test_02 - tests file with holes, written and unwritten ext=
ents.
+# verify results:
+# 1. file size is identical.
+# 2. perform cmp(1) to compare SRC and DEST file byte by byte.
+test02()
+{
+=09rm -rf $src $dest
+
+=09write_cmd=3D"-c \"truncate 200m\""
+=09for i in $(seq 0 10 100); do
+=09=09offset=3D$(($((6 << 20)) + $i * $((1 << 20))))
+=09=09write_cmd=3D"$write_cmd -c \"falloc $offset 3m\" -c \"pwrite $of=
fset 1m\""
+=09done
+
+=09echo "*** test02() create sparse file ***" >>$seq.full
+=09eval ${XFS_IO_PROG} -F -f "${write_cmd}" $src >>$seq.full 2>&1 ||
+=09=09_fail "create sparse file failed!"
+=09echo "*** test02() create sparse file done ***" >>$seq.full
+=09echo >>$seq.full
+
+=09$here/src/seek_copy_test $src $dest
+
+=09test $(stat --printf "%s" $src) =3D $(stat --printf "%s" $dest) ||
+=09=09_fail "TEST02: file size check failed"
+
+=09cmp $src $dest || _fail "TEST02: file bytes check failed"
+}
+
+# seek_copy_test_03 - tests file with unwritten with data, repeated un=
written
+# without data, as well as data extents mapping.
+# verify results:
+# 1. file size is identical.
+# 2. perform cmp(1) to compare SRC and DEST file byte by byte.
+test03()
+{
+=09rm -rf $src $dest
+
+=09write_cmd=3D"-c \"truncate 200m\""
+
+=09#
+=09# Firstly, make the file with allocated && reserved extents
+=09# mapping without real data wrote.
+=09#
+=09for i in $(seq 0 10 180); do
+=09=09offset=3D$(($((10 << 20)) + $i * $((1 << 20))))
+=09=09write_cmd=3D"$write_cmd -c \"falloc $offset 10m\""
+=09done
+
+=09#
+=09# Secondly, write data to some unwritten extents, hence we
+=09# have a test file will extents mapping as:
+=09# |data|multiple unwritten_without_data|data| repeat...
+=09for i in $(seq 0 60 180); do
+=09=09offset=3D$(($((20 << 20)) + $i * $((1 << 20))))
+=09=09write_cmd=3D"$write_cmd -c \"pwrite $offset 10m\""
+=09done
+
+=09echo "*** test03() create sparse file ***" >>$seq.full
+=09eval ${XFS_IO_PROG} -F -f "${write_cmd}" $src >>$seq.full 2>&1 ||
+=09=09_fail "create sparse file failed!"
+=09echo "*** test03() create sparse file done ***" >>$seq.full
+=09echo >>$seq.full
+=09$here/src/seek_copy_test $src $dest
+
+=09test $(stat --printf "%s" $src) =3D $(stat --printf "%s" $dest) ||
+=09=09_fail "TEST03: file size check failed"
+
+=09cmp $src $dest || _fail "TEST03: file bytes check failed"
+}
+
+# seek_copy_test_04 - tests file with hole, repeated unwritten
+# without data, as well as data extents mapping.
+# verify results:
+# 1. file size is identical.
+# 2. perform cmp(1) to compare SRC and DEST file byte by byte.
+test04()
+{
+=09rm -rf $src $dest
+
+=09write_cmd=3D"-c \"truncate 200m\""
+
+=09#
+=09# Firstly, make the file with allocated && reserved extents
+=09# mapping without real data wrote.
+=09#
+=09for i in $(seq 30 30 180); do
+=09=09offset=3D$(($((30 << 20)) + $i * $((1 << 20))))
+=09=09write_cmd=3D"$write_cmd -c \"falloc $offset 5m\""
+=09done
+
+=09#
+=09# Secondly, write data to some unwritten extents, hence we
+=09# have a test file will extents mapping as:
+=09# |hole|multiple unwritten_without_data|hole|data| repeat...
+=09for i in $(seq 30 90 180); do
+=09=09offset=3D$(($((30 << 20)) + $i * $((1 << 20))))
+=09=09write_cmd=3D"$write_cmd -c \"pwrite $offset 2m\""
+=09done
+
+=09echo "*** test04() create sparse file ***" >>$seq.full
+=09eval ${XFS_IO_PROG} -F -f "${write_cmd}" $src >>$seq.full 2>&1 ||
+=09=09_fail "create sparse file failed!"
+=09echo "*** test04() create sparse file done ***" >>$seq.full
+=09echo >>$seq.full
+=09$here/src/seek_copy_test $src $dest
+
+=09test $(stat --printf "%s" $src) =3D $(stat --printf "%s" $dest) ||
+=09=09_fail "TEST04: file size check failed"
+
+=09cmp $src $dest || _fail "TEST04: file bytes check failed"
+}
+
+rm -f $seq.full
+test01
+test02
+test03
+test04
+
+status=3D0
+exit
