+_require_scratch
+_require_xfs_io_falloc
+
+echo "------------------------------"
+echo "preallocation test"
+echo "------------------------------"
+
+rm -f $seq.full
+
+umount $SCRATCH_DEV 2>/dev/null
+_scratch_mkfs_sized $((1 * 1024 * 1024 * 1024)) >>$seq.full 2>&1
+_scratch_mount
+
+# Create a 4k file and Allocate 4M past EOF on that file
+xfs_io -F -f -c "pwrite 0 4k" -c "falloc -k 4k 4m" $SCRATCH_MNT/test \
+=09>>$seq.full 2>&1 || _fail "failed to create test file"
+
+# Fill the rest of the fs completely
+# Note, this will show ENOSPC errors in $seq.full, that's ok.
+echo "Fill fs with 1M IOs; ENOSPC expected" >> $seq.full
+dd if=3D/dev/zero of=3D$SCRATCH_MNT/tmp1 bs=3D1M >>$seq.full 2>&1
+echo "Fill fs with 4K IOs; ENOSPC expected" >> $seq.full
+dd if=3D/dev/zero of=3D$SCRATCH_MNT/tmp2 bs=3D4K >>$seq.full 2>&1
+sync
+# Last effort, use O_SYNC
+echo "Fill fs with 4K DIOs; ENOSPC expected" >> $seq.full
+dd if=3D/dev/zero of=3D$SCRATCH_MNT/tmp3 bs=3D4K oflag=3Dsync >>$seq.f=
ull 2>&1
+# Save space usage info
+echo "Post-fill space:" >> $seq.full
+df $SCRATCH_MNT >>$seq.full 2>&1
+
+# Now attempt a write into all of the preallocated space -
+# in a very nasty way, badly fragmenting it and then filling it in.
+echo "Fill in prealloc space; fragment at offsets:" >> $seq.full
+for i in `seq 1 2 1023`; do
+=09echo -n "$i " >> $seq.full
+=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/test seek=3D$i bs=3D4K count=3D=
1 conv=3Dnotrunc \
+=09=09>>$seq.full 2>/dev/null || _fail "failed to write to test file"
+done
+sync
+echo >> $seq.full
+echo "Fill in prealloc space; fill holes at offsets:" >> $seq.full
+for i in `seq 2 2 1023`; do
+=09echo -n "$i " >> $seq.full
+=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/test seek=3D$i bs=3D4K count=3D=
1 conv=3Dnotrunc \
+=09=09>>$seq.full 2>/dev/null || _fail "failed to fill test file"
+done
+sync
+echo >> $seq.full
+
+echo "done"
+exit
