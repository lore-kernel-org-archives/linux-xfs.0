-=09-c 'pwrite 256 1'=09\
-=09-c 'pread -v 0 512'=09\
-=09$TEST_DIR/test214-3 | _filter_xfs_io_unique
-
-# Same but write the end of the region
-echo "=3D=3D=3D falloc, write end, read =3D=3D=3D"
-$XFS_IO_PROG -F -f=09=09\
-=09-c 'falloc 0 512'=09\
-=09-c 'pwrite 511 1'=09\
-=09-c 'pread -v 0 512'=09\
-=09$TEST_DIR/test214-4 | _filter_xfs_io_unique
-
-# Reported by IBM on ext4.
-#
-# Fixed by commit a41f20716975910d9beb90b7efc61107901492b8
-#
-# The file was previously preallocated, and then initialized the middl=
e of
-# the preallocation area using Direct IO write, then overwrite part of
-# initialized area. Later after truncate the file (to the middle of th=
e
-# initialized data), the initialized data *before* the new file size w=
as
-# gone after remount the filesystem.
-
-echo "=3D=3D=3D falloc, write, sync, truncate, read =3D=3D=3D"
-# Allocate, write, sync, truncate (buffered)
-$XFS_IO_PROG -F -f=09=09=09=09\
-=09-c 'falloc         0x0     0x65C00'=09\
-=09-c 'pwrite -S 0xAA 0x12000 0x10000'=09\
-=09-c 'fsync'=09=09=09=09\
-=09-c 'truncate 0x16000'=09=09=09\
-=09$TEST_DIR/test214-5 | _filter_xfs_io_unique
-
-# now do a direct read and see what's on-disk
-$XFS_IO_PROG -F -f -d=09=09=09=09\
-=09-c 'pread -v 0 0x16000'=09=09=09\
-=09$TEST_DIR/test214-5 | _filter_xfs_io_unique
