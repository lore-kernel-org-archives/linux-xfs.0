+#! /bin/bash
+# FS QA Test No. 193
+#
+# Test permission checks in ->setattr
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2008 Christoph Hellwig.
+#
+# This program is free software; you can redistribute it and/or
