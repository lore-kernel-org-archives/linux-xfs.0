-
-_require_scratch
-_require_xfs_quota
-_require_nobody
-
-# setup a default run
-_qmount_option uquota
-
-_scratch_mkfs_xfs | _filter_mkfs 2>$tmp.mkfs
-cat $tmp.mkfs >>$seq.full
-chmod a+w $seq.full     # arbitrary users will write here
-
-# keep the blocksize from mkfs ($dbsize)
-. $tmp.mkfs
-
-_qmount
-
-# setup user/group to test
-if src/feature -U $SCRATCH_DEV ; then
-=09type=3Du; eval `_choose_uid`
-elif src/feature -G $SCRATCH_DEV ; then
-=09type=3Dg; eval `_choose_gid`
-elif src/feature -P $SCRATCH_DEV ; then
-=09type=3Dp; eval `_choose_prid`
-else
-=09_notrun "No quota support at mount time"
-fi
-
-# create 100 (fs-blocksize) blocks
-_file_as_id $SCRATCH_MNT/foo $id $type $dbsize 220
-sync
-
-# set limit at 1001 (1k) blocks
-bsoft=3D1001
-bhard=3D1001
-isoft=3D10
-ihard=3D10
-xfs_quota -x \
-=09-c "limit -$type bsoft=3D${bsoft}k bhard=3D${bhard}k $id" \
-=09-c "limit -$type isoft=3D$isoft ihard=3D$ihard $id" \
-=09$SCRATCH_DEV
-
-# cross check blks, softblks, hardblks <-> quota, xfs_db
-xfs_quota -c "quota -$type -birnN $id" $SCRATCH_DEV |
-=09=09=09tr -d '\n' | tr -s '[:space:]' | tee -a $seq.full |
-=09perl -ne 'if (m[^\s*'$SCRATCH_DEV'\s+(\d+)\s+(\d+)\s+(\d+)]) {
-=09=09print "used_blocks=3D", $1, "\n";
-=09=09print "soft_blocks=3D", $2, "\n";
-=09=09print "hard_blocks=3D", $3, "\n";
-=09=09$next =3D 0;
-=09}' | LC_COLLATE=3DPOSIX sort >$tmp.quota
-
-echo =3D=3D=3Dquota output >> $seq.full
-cat $tmp.quota >> $seq.full
-[ ! -s $tmp.quota ] && echo "warning: quota output file is empty"
-
-umount $SCRATCH_MNT
-
-# note - does (insitu) conversion from fs blocks to 1K blocks
-xfs_db -rc "dquot -$type $id" -c p $SCRATCH_DEV | tee -a $seq.full | p=
erl -ne '
-=09if (/^diskdq.bcount =3D (\d+)$/) {
-=09=09 print "used_blocks=3D", $1 * '$dbsize' / 1024, "\n";
-=09}
-=09elsif (/^diskdq.blk_hardlimit =3D (\d+)$/) {
-=09=09 print "hard_blocks=3D", $1 * '$dbsize' / 1024, "\n";
-=09}
-=09elsif (/^diskdq.blk_softlimit =3D (\d+)$/) {
-=09=09print "soft_blocks=3D", $1 * '$dbsize' / 1024, "\n";
-=09}' | LC_COLLATE=3DPOSIX sort >$tmp.xfs_db
-
-echo =3D=3D=3Dxfs_db output >> $seq.full
-cat $tmp.xfs_db >> $seq.full
-[ ! -s $tmp.xfs_db ] && echo "warning: xfs_db output file is empty"
-
-echo Comparing out of xfs_quota and xfs_db
-diff $tmp.quota $tmp.xfs_db
-[ $? -eq 0 ] && echo OK.
-
-# success, all done
-status=3D0
-exit
