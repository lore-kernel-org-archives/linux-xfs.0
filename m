+#! /bin/bash
+# FS QA Test No. 195
+#
+# Make sure the chattr dump flag gets picked up by xfsdump without a s=
ync
+#
+# http://oss.sgi.com/bugzilla/show_bug.cgi?id=3D340
+#
+#---------------------------------------------------------------------=
--
