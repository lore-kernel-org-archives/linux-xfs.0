-_filter_copy()
-{
-=09sed -e "s,$1,<DEVIMAGE>,g" -e "s,$2,<FSIMAGE1>,g" \
-=09    -e "s,$3,<DEVIMAGE>,g" -e "s,$4,<FSIMAGE2>,g"
-}
-
-_filter_path()
-{
-=09sed -e "s,$1,<MNTPATH>,g" | LC_COLLATE=3DPOSIX sort
-}
-
-_populate_scratch()
-{
-=09POSIXLY_CORRECT=3Dyes \
-=09=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/big+attr count=3D1000 bs=3D4=
096
-=09[ "$FAST_POPULATE" =3D true ] && return
-=09echo $SCRATCH_MNT/big+attr | $here/src/fill2attr
-=09$here/src/fill2fs --bytes=3D1048576 --filesize=3D4096 --stddev=3D0 =
--force \
-=09=09--dir=3D$SCRATCH_MNT/fill --list=3D- > $tmp.manifest
-}
-
-_verify_copy()
-{
-=09target=3D$1
-=09target_dir=3D$imgs.loop
-=09source=3D$2
-=09source_dir=3D$3
-
-=09[ $source =3D $SCRATCH_DEV ] && _scratch_mount
-
-=09echo checking new image
-=09_check_xfs_filesystem $target none none
-
-=09echo mounting new image on loopback
-=09rmdir $target_dir 2>/dev/null
-=09mkdir $target_dir
-
-=09mount -t xfs -o loop $target $target_dir 2>/dev/null
-=09if [ $? -ne 0 ]; then
-=09=09echo retrying mount with nouuid option
-=09=09mount -t xfs -o loop -o nouuid $target $target_dir
-=09=09if [ $? -ne 0 ]; then
-=09=09=09echo mount failed - evil!
-=09=09=09return
-=09=09fi
-=09fi
-
-=09echo comparing new image files to old
-=09diff -Naur $source_dir $target_dir
-
-=09echo comparing new image directories to old
-=09find $source_dir | _filter_path $source_dir > $tmp.manifest1
-=09find $target_dir | _filter_path $target_dir > $tmp.manifest2
-=09[ -s $tmp.manifest1 ] || echo no directory output
-=09diff -u $tmp.manifest1 $tmp.manifest2
-
-=09echo comparing new image geometry to old
-=09xfs_info $source_dir \
-=09=09| _filter_copy $source $source_dir '/dev/loop.' '#' \
-=09=09| tr -s ' ' \
-=09=09> $tmp.geometry1
-=09xfs_info $target_dir \
-=09=09| _filter_copy $target $target_dir '/dev/loop.' '#' \
-=09=09| tr -s ' ' \
-=09=09> $tmp.geometry2
-=09[ -s $tmp.geometry1 ] || echo no geometry output
-=09diff -u $tmp.geometry1 $tmp.geometry2
-
-=09echo unmounting and removing new image
-=09umount $source_dir
-=09umount -d $target_dir > /dev/null 2>&1
-=09rm -f $target
-}
