+#
+
+# xfs_sb_t
+cat /usr/include/xfs/xfs*.h | indent |\
+awk '
+   /typedef struct xfs_sb/ { structon =3D 1; next }
+   structon && $2 ~ /^sb_/ { sub(/[;,]/,"",$2)
+                             print "printf(\"offsetof(xfs_sb_t,", $2, =
") =3D %d\\n\", offsetof(xfs_sb_t,", $2, "));"; next}
+   structon && /}/ { structon =3D 0; next}
+'>>$cprog
+
+echo 'return 0; }' >>$cprog
