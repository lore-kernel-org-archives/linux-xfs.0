+#! /bin/bash
+# FS QA Test No. 067
+#
+# Test out acl/dacls which fit in shortform in the inode
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2000-2002 Silicon Graphics, Inc.  All Rights Reserved.
