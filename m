+    BLK_DEV_SIZE=3D1048576
+fi
+FS_SIZE=3D$((BLK_DEV_SIZE * 512))
+
+cat >$tmp-$seq.fio <<EOF
+###########
+# $seq test fio activity
+# Run DIO, fallocate and punch_hole threads on a single in parallel
+#
+# If race exist old dio request may rewrite punched block after it was
+# allocated to another file, we will catch that by verifying blocks co=
ntent
+#
+[global]
+directory=3D${SCRATCH_MNT}
+filesize=3D${FS_SIZE}
+size=3D999G
+continue_on_error=3Dwrite
+ignore_error=3D,ENOSPC
+error_dump=3D0
+
+create_on_open=3D1
+fallocate=3Dnone
+exitall=3D1
+
+## Perform direct aio, to files which may be truncated
+## by external task
+[direct_aio_raicer]
+ioengine=3Dlibaio
+iodepth=3D128*${LOAD_FACTOR}
+bs=3D128k
+direct=3D1
+numjobs=3D${NUM_JOBS}
+rw=3Drandwrite
+runtime=3D100*${TIME_FACTOR}
+time_based
+filename=3Dracer
+
+# Run falloc and punch_hole threads in parallel
+# After activity file will be highly fragmented
+[falloc_raicer]
+ioengine=3Dfalloc
+runtime=3D100*${TIME_FACTOR}
+iodepth=3D1
+bssplit=3D128k/80:512k/10:32k/10
+rw=3Drandwrite
+numjobs=3D1
+filename=3Dracer
+
+[punch_hole_raicer]
+ioengine=3Dfalloc
+runtime=3D100*${TIME_FACTOR}
+bs=3D4k
+time_based=3D10
+rw=3Drandtrim
+numjobs=3D2
+filename=3Dracer
+time_based
+
+# Verifier thread continiously write to newly allcated blocks
+# and veryfy written content
+[aio-dio-verifier]
+ioengine=3Dlibaio
+iodepth=3D128*${LOAD_FACTOR}
+numjobs=3D1
+verify=3Dcrc32c-intel
+verify_fatal=3D1
+verify_dump=3D1
+verify_backlog=3D1024
+verify_async=3D4
+verifysort=3D1
+direct=3D1
+bs=3D4k
+rw=3Drandwrite
+filename=3Daio-dio-verifier
+EOF
+
+_workout()
+{
+=09echo ""
+=09echo "Run fio with random aio-dio pattern"
+=09echo ""
+=09cat $tmp-$seq.fio >>  $seq.full
+=09run_check $FIO_PROG $tmp-$seq.fio
+}
+
+_require_fio $tmp-$seq.fio
+
+_scratch_mkfs_sized $FS_SIZE >> $seq.full 2>&1
+_scratch_mount
+
+if ! _workout; then
+=09umount $SCRATCH_DEV 2>/dev/null
+=09exit
+fi
+
+if ! _scratch_unmount; then
+=09echo "failed to umount"
+=09status=3D1
+=09exit
+fi
