+}
+
+_test_add_extents()
+{
+=09# now do the extents
+
+=09#build up
+=09j=3D1
+=09while [ $j -le 30 ]; do
+=09    do_extents $j
+=09    _print_inode
+=09    let j=3D$j+2
+=09done
+
+=09#scale down
+=09j=3D30
+=09while [ $j -ge 1 ]; do
+=09    do_extents $j
+=09    _print_inode
+=09    let j=3D$j-2
+=09done
+
+=09#build up
+=09j=3D1
+=09while [ $j -le 30 ]; do
+=09    do_extents $j
+=09    _print_inode
+=09    let j=3D$j+2
+=09done
+}
+
+#
+# Using a nested loop,
+# for various number of data extents,
+# try adding EAs and then removing EAs
+# Check that when we play with the EAs that we don't mess with the ext=
ents
+#
+_test_extents_eas()
+{
+=09# now do the EAs with the extents
+
+=09extents_max=3D400
+=09extents_inc=3D10
+=09EAs_max=3D100
+=09EAs_inc=3D5
+=09for i in `seq 1 $extents_inc $extents_max`; do
+=09    do_extents $i
+=09    echo "--- extents: $i ---"
+=09    _print_inode
+=09    _print_inode_u > $tmp.u1
+=09    for j in `seq 1 $EAs_inc $EAs_max`; do
+=09=09let k=3D$k+$EAs_inc-1
+=09=09add_eas $j $k
+=09    done
+=09    # should have same extents
+=09    _print_inode
+=09    _print_inode_u > $tmp.u2
+            rm_eas 1 $EAs_max
+=09    _print_inode_u > $tmp.u3
+
+=09    echo ""
+=09    echo "*** Extent differences before and after EAs added ***"
+=09    diff -s $tmp.u1 $tmp.u2 | _filter
+=09    echo ""
+=09    if ! diff $tmp.u1 $tmp.u2 >/dev/null; then=20
+=09=09echo "Data extents magically changed"
+=09=09exit
+=09    fi
+
+=09    echo ""
+=09    echo "*** Extent differences before and after EAs removed ***"
+=09    diff -s $tmp.u2 $tmp.u3 | _filter
+=09    echo ""
+=09    if ! diff $tmp.u2 $tmp.u3 >/dev/null; then=20
+=09=09echo "Data extents magically changed"
+=09=09exit
+=09    fi
+=09done
+}
+
+#
+# The counterpart of _test_extents_eas
+# with the nested loops reversed.
+# For various number of EAs, try adding extents
+# Check that when we play with the data extents that we don't mess wit=
h the EAs
+#
+_test_eas_extents()
+{
+=09# now do the EAs with the extents
+
+=09extents_max=3D400
+=09extents_inc=3D10
+=09EAs_max=3D100
+=09EAs_inc=3D5
+=09for j in `seq 1 $EAs_inc $EAs_max`; do
+
+=09    let k=3D$k+$EAs_inc-1
+=09    add_eas $j $k
+=09    echo "--- EAs: $j ---"
+
+=09    _print_inode
+=09    _print_inode_a > $tmp.a1
+=09    for i in `seq 1 $extents_inc $extents_max`; do
+=09=09do_extents $i
+=09    done
+
+=09    # should have same EAs
+=09    _print_inode
+=09    _print_inode_a > $tmp.a2
+=09    >$file=20
+=09    _print_inode_a > $tmp.a3
+
+=09    echo ""
+=09    echo "*** EA differences before and after extents added ***"
+=09    diff -s $tmp.a1 $tmp.a2 | _filter
+=09    echo ""
+=09    if ! diff $tmp.a1 $tmp.a2 >/dev/null; then=20
+=09=09echo "EAs magically changed"
+=09=09exit
+=09    fi
+
+=09    echo ""
+=09    echo "*** EA differences before and after extents removed ***"
+=09    diff -s $tmp.a2 $tmp.a3 | _filter
+=09    echo ""
+=09    if ! diff $tmp.a2 $tmp.a3 >/dev/null; then=20
+=09=09echo "EAs magically changed"
+=09=09exit
+=09    fi
+=09done
+}
