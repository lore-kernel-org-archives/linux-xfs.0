+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# don't put fs images in /tmp
+imgs=3D$TEST_DIR/$$
+
+_cleanup()
+{
+=09cd /
+=09umount $SCRATCH_MNT 2>/dev/null
+=09umount -d $imgs.loop 2>/dev/null
+=09[ -d $imgs.loop ] && rmdir $imgs.loop
+=09umount -d $imgs.source_dir 2>/dev/null
+=09[ -d $imgs.source_dir ] && rm -rf $imgs.source_dir
+=09rm -f $imgs.* $tmp.* /var/tmp/xfs_copy.log.*
+}
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+_filter_copy()
+{
+=09sed -e "s,$1,<DEVIMAGE>,g" -e "s,$2,<FSIMAGE1>,g" \
+=09    -e "s,$3,<DEVIMAGE>,g" -e "s,$4,<FSIMAGE2>,g"
+}
+
+_filter_path()
+{
+=09sed -e "s,$1,<MNTPATH>,g" | LC_COLLATE=3DPOSIX sort
+}
+
+_populate_scratch()
+{
+=09POSIXLY_CORRECT=3Dyes \
+=09=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/big+attr count=3D1000 bs=3D4=
096
+=09[ "$FAST_POPULATE" =3D true ] && return
+=09echo $SCRATCH_MNT/big+attr | $here/src/fill2attr
+=09$here/src/fill2fs --bytes=3D1048576 --filesize=3D4096 --stddev=3D0 =
--force \
+=09=09--dir=3D$SCRATCH_MNT/fill --list=3D- > $tmp.manifest
+}
+
+_verify_copy()
+{
+=09target=3D$1
+=09target_dir=3D$imgs.loop
+=09source=3D$2
+=09source_dir=3D$3
+
+=09[ $source =3D $SCRATCH_DEV ] && _scratch_mount
+
+=09echo checking new image
+=09_check_xfs_filesystem $target none none
+
+=09echo mounting new image on loopback
+=09rmdir $target_dir 2>/dev/null
+=09mkdir $target_dir
+
+=09mount -t xfs -o loop $target $target_dir 2>/dev/null
+=09if [ $? -ne 0 ]; then
+=09=09echo retrying mount with nouuid option
+=09=09mount -t xfs -o loop -o nouuid $target $target_dir
+=09=09if [ $? -ne 0 ]; then
+=09=09=09echo mount failed - evil!
+=09=09=09return
+=09=09fi
+=09fi
+
+=09echo comparing new image files to old
+=09diff -Naur $source_dir $target_dir
+
+=09echo comparing new image directories to old
+=09find $source_dir | _filter_path $source_dir > $tmp.manifest1
+=09find $target_dir | _filter_path $target_dir > $tmp.manifest2
+=09[ -s $tmp.manifest1 ] || echo no directory output
+=09diff -u $tmp.manifest1 $tmp.manifest2
+
+=09echo comparing new image geometry to old
+=09xfs_info $source_dir \
+=09=09| _filter_copy $source $source_dir '/dev/loop.' '#' \
+=09=09| tr -s ' ' \
+=09=09> $tmp.geometry1
+=09xfs_info $target_dir \
+=09=09| _filter_copy $target $target_dir '/dev/loop.' '#' \
+=09=09| tr -s ' ' \
+=09=09> $tmp.geometry2
+=09[ -s $tmp.geometry1 ] || echo no geometry output
+=09diff -u $tmp.geometry1 $tmp.geometry2
+
+=09echo unmounting and removing new image
+=09umount $source_dir
+=09umount -d $target_dir > /dev/null 2>&1
+=09rm -f $target
+}
+
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux
+
+[ "$USE_EXTERNAL" =3D yes ] && _notrun "Cannot xfs_copy with external =
devices"
+[ -n "$XFS_COPY_PROG" ] || _notrun "xfs_copy binary not yet installed"
+
+_require_scratch
+_require_loop
+
+_scratch_mkfs_xfs -dsize=3D41m,agcount=3D2 | _filter_mkfs 2>/dev/null
+_scratch_mount 2>/dev/null || _fail "initial scratch mount failed"
+
+echo
+echo =3D=3D=3D populating scratch device
+_populate_scratch
+umount $SCRATCH_MNT 2>/dev/null
+
+echo
+echo =3D=3D=3D copying scratch device to single target
+$XFS_COPY_PROG $SCRATCH_DEV $imgs.image | _filter_copy '#' $imgs.image=
 '#' '#'
+_verify_copy $imgs.image $SCRATCH_DEV $SCRATCH_MNT
+
+echo
+echo =3D=3D=3D copying scratch device to single target, duplicate UUID
+$XFS_COPY_PROG -d $SCRATCH_DEV $imgs.image | _filter_copy '#' $imgs.im=
age '#' '#'
+_verify_copy $imgs.image $SCRATCH_DEV $SCRATCH_MNT
+
+echo=20
+echo =3D=3D=3D copying scratch device to single target, large ro devic=
e
+${MKFS_PROG}.xfs -dfile,name=3D$imgs.source,size=3D100g | _filter_mkfs=
 2>/dev/null
+rmdir $imgs.source_dir 2>/dev/null
+mkdir $imgs.source_dir
+
+mount -t xfs -o loop $imgs.source $imgs.source_dir
+loop2=3D`mount | grep $imgs.source | grep -o -e 'loop=3D.*[^),]' | gre=
p -o -e '/.*$'`
+cp -a $here $imgs.source_dir
+mount -t xfs -o remount,ro $imgs.source $imgs.source_dir
+$XFS_COPY_PROG $imgs.source $imgs.image | _filter_copy '#' $imgs.image=
 '#' '#'
+_verify_copy $imgs.image $imgs.source $imgs.source_dir
+
+# HACK WARNING:
+#
+# We're done with the nested loop mount, now we have to clean
+# up the pieces that mount is incapable of doing.
+losetup -d $loop2 > /dev/null 2>&1
+
+echo
+echo =3D=3D=3D copying scratch device to multiple targets
+$XFS_COPY_PROG -L$imgs.log -b $SCRATCH_DEV $imgs.image1 $imgs.image2 \
+=09| _filter_copy '#' $imgs.image1 '#' $imgs.image2
+_verify_copy $imgs.image1 $SCRATCH_DEV $SCRATCH_MNT
+_verify_copy $imgs.image2 $SCRATCH_DEV $SCRATCH_MNT
+
+# success, all done
+status=3D0
+exit
