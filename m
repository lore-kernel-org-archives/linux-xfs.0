+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux IRIX
+
+cp /dev/null $seq.full
+chmod ugo+rwx $seq.full
+
+_require_scratch
+_require_xfs_quota
+
+_filter_stat()
+{
+    sed "
+        /^Access:/d;
+        /^Modify:/d;
+        /^Change:/d;
+        s/Device: *[0-9][0-9]*,[0-9][0-9]*/Device: <DEVICE>/;
+        s/Inode: *[0-9][0-9]*/Inode: <INODE>/;
+        s,$SCRATCH_MNT,<MOUNT>,;
+    " | tr -s ' '
+}
+
+_exercise()
+{
+=09_scratch_mkfs_xfs >/dev/null 2>&1
+=09_qmount
+
+=09umask 022
+=09touch $SCRATCH_MNT/testfile
+=09if src/feature -c $SCRATCH_MNT/testfile; then
+=09=09:
+=09else
+=09=09_notrun "Installed fileutils doesn't support 32 bit uids/gids"
+=09fi
+
+=09chown 12345 $SCRATCH_MNT/testfile
+=09chgrp 54321 $SCRATCH_MNT/testfile
+=09src/lstat64 $SCRATCH_MNT/testfile | _filter_stat
+
+=09chown 34567 $SCRATCH_MNT/testfile
+=09chgrp 76543 $SCRATCH_MNT/testfile
+=09src/lstat64 $SCRATCH_MNT/testfile | _filter_stat
+
+=09chown 56789 $SCRATCH_MNT/testfile
+=09chgrp 98765 $SCRATCH_MNT/testfile
+=09src/lstat64 $SCRATCH_MNT/testfile | _filter_stat
+
+=09# finally give back to original owners
+=09chown 12345 $SCRATCH_MNT/testfile
+=09chgrp 54321 $SCRATCH_MNT/testfile
+=09src/lstat64 $SCRATCH_MNT/testfile | _filter_stat
+
+=09echo
+=09umount $SCRATCH_MNT 2>/dev/null
+}
+
+_scratch_mkfs_xfs >> $seq.full 2>&1 || _fail "mkfs failed!"
+
+_qmount_option "uquota,gquota"
+_qmount
+if src/feature -G $SCRATCH_DEV ; then
+=09:
+else
+=09_notrun "No quota support at mount time"
+fi
+umount $SCRATCH_MNT 2>/dev/null
+
+_qmount_option "rw" # no quota options
+echo "*** Default mount options"
+_exercise
+
+_qmount_option "uquota"
+echo "*** User quota mount option"
+_exercise
+
+export MOUNT_OPTIONS=3D"-o gquota"
+_qmount_option "gquota"
+echo "*** Group quota mount option"
+_exercise
+
+_qmount_option "uquota,gquota"
+echo "*** User and Group quota mount options"
+_exercise
+
+# success, all done
+status=3D0
+exit
