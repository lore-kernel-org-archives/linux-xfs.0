+=09    -e "s#$tmp[^ :]*#<TMPFILE>#g;" \
+=09=09$tmp.err 1>&2
+=09return $exit
+}
+
+_getfattr()
+{
+=09${GETFATTR_PROG} $* 2>$tmp.err >$tmp.out
+=09exit=3D$?
+=09sed \
+=09    -e "s#$SCRATCH_MNT[^ .:]*#<TESTFILE>#g" \
+=09    -e "s#$tmp[^ :]*#<TMPFILE>#g;" \
+=09=09$tmp.out
+=09sed \
