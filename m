+}
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+_full()
+{
+    echo ""            >>$seqfull
+    echo "*** $* ***"  >>$seqfull
+    echo ""            >>$seqfull
+}
+
+_filter_stat()
+{
+    sed '
+        /^Access:/d;
+        /^Modify:/d;
+        /^Change:/d;
+        s/Device: *[0-9][0-9]*,[0-9][0-9]*/Device: <DEVICE>/;
+        s/Inode: *[0-9][0-9]*/Inode: <INODE>/;
+        s/Size: *[0-9][0-9]* *Filetype: Dir/Size: <DSIZE> Filetype: Di=
r/;
+    ' | tr -s ' '
+}
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os IRIX Linux
+
+_require_scratch
+
+protofile=3D$tmp.proto
+tempfile=3D$tmp.file
+
+echo fish >$tempfile
+$here/src/devzero -b 2048 -n 2 -c -v 44 $tempfile.2=20
+
+cat >$protofile <<EOF
+DUMMY1
+0 0
+: root directory
+d--777 3 1
+: a directory
+directory d--755 3 1=20
+file_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_0 ---755 3 1 $tempfil=
e
+file_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_1 ---755 3 1 $tempfil=
e
+file_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_2 ---755 3 1 $tempfil=
e
+file_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_3 ---755 3 1 $tempfil=
e
+file_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_4 ---755 3 1 $tempfil=
e
+$
+: back in the root
+setuid -u-666 0 0 $tempfile
+setgid --g666 0 0 $tempfile
+setugid -ug666 0 0 $tempfile
+block_device b--012 3 1 161 162=20
+char_device c--345 3 1 177 178
+pipe p--670 0 0
+symlink l--123 0 0 bigfile
+: a file we actually read
+bigfile ---666 3 0 $tempfile.2
+: done
+$
+EOF
+
+if [ $? -ne 0 ]
+then
+    _fail "failed to create test protofile"
+fi
+
+_verify_fs()
+{
+=09echo "*** create FS version $1"
+=09VERSION=3D"-n version=3D$1"
+
+=09rm -f $seqfull
+=09umount $SCRATCH_DEV >/dev/null 2>&1
+
+=09_full "mkfs"
+=09_scratch_mkfs_xfs $VERSION -p $protofile >>$seqfull 2>&1 \
+=09=09|| _fail "mkfs failed"
+
+=09echo "*** check FS"
+=09_check_scratch_fs
+
+=09echo "*** mount FS"
+=09_full " mount"
+=09_scratch_mount >>$seqfull 2>&1 \
+=09=09|| _fail "mount failed"
+
+=09echo "*** verify FS"
+=09(cd $SCRATCH_MNT ; find . | LC_COLLATE=3DPOSIX sort \
+=09=09| xargs $here/src/lstat64 | _filter_stat)
+=09diff -q $SCRATCH_MNT/bigfile $tempfile.2 \
+=09=09|| _fail "bigfile corrupted"
+   =20
+=09echo "*** unmount FS"
+=09_full "umount"
+=09umount $SCRATCH_DEV >>$seqfull 2>&1 \
+=09=09|| _fail "umount failed"
+=09   =20
+=09echo "*** check FS"
+=09_check_scratch_fs
+}
+
+#_verify_fs 1
+_verify_fs 2
+
+echo "*** done"
+rm $seqfull
+status=3D0
+exit
