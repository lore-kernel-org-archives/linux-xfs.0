+status=3D0
+trap "exit \$status" 0 1 2 3 15
+chpid=3D0
+mypid=3D$$
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs generic
+_supported_os Linux
+_require_math
+_require_fstrim
+
+_require_scratch
+_scratch_mkfs >/dev/null 2>&1
+_scratch_mount
+
+_test_batched_discard $SCRATCH_MNT || _notrun "FITRIM not supported on=
 $SCRATCH_DEV"
+
+fssize=3D$(df -k | grep "$SCRATCH_MNT" | grep "$SCRATCH_DEV"  | awk '{=
print $2}')
+
+beyond_eofs=3D$(_math "$fssize*2048")
+max_64bit=3D$(_math "2^64 - 1")
+
+# All these tests should return EINVAL
+# since the start is beyond the end of
+# the file system
+
+echo "[+] Start beyond the end of fs (should fail)"
+out=3D$($FSTRIM_PROG -o $beyond_eofs $SCRATCH_MNT 2>&1)
+[ $? -eq 0 ] && status=3D1
+echo $out | _filter_scratch
+
+echo "[+] Start beyond the end of fs with len set (should fail)"
+out=3D$($FSTRIM_PROG -o $beyond_eofs -l1M $SCRATCH_MNT 2>&1)
+[ $? -eq 0 ] && status=3D1
+echo $out | _filter_scratch
+
+echo "[+] Start =3D 2^64-1 (should fail)"
+out=3D$($FSTRIM_PROG -o $max_64bit $SCRATCH_MNT 2>&1)
+[ $? -eq 0 ] && status=3D1
+echo $out | _filter_scratch
+
+echo "[+] Start =3D 2^64-1 and len is set (should fail)"
+out=3D$($FSTRIM_PROG -o $max_64bit -l1M $SCRATCH_MNT 2>&1)
+[ $? -eq 0 ] && status=3D1
+echo $out | _filter_scratch
+
+_scratch_unmount
+_scratch_mkfs >/dev/null 2>&1
+_scratch_mount
+
+# All these tests should succeed
+# since the length should be truncated
+
+echo "[+] Default length (should succeed)"
+$FSTRIM_PROG $SCRATCH_MNT
+[ $? -ne 0 ] && status=3D1
+echo "[+] Default length with start set (should succeed)"
+$FSTRIM_PROG -o10M $SCRATCH_MNT
+[ $? -ne 0 ] && status=3D1
+echo "[+] Length beyond the end of fs (should succeed)"
+$FSTRIM_PROG -l $beyond_eofs $SCRATCH_MNT
+[ $? -ne 0 ] && status=3D1
+echo "[+] Length beyond the end of fs with start set (should succeed)"
+$FSTRIM_PROG -o10M -l $beyond_eofs $SCRATCH_MNT
+[ $? -ne 0 ] && status=3D1
+
+_scratch_unmount
+_scratch_mkfs >/dev/null 2>&1
+_scratch_mount
+
+# This is a bit fuzzy, but since the file system is fresh
+# there should be at least (fssize/2) free space to trim.
+# This is supposed to catch wrong FITRIM argument handling
+out=3D$($FSTRIM_PROG -v -o10M $SCRATCH_MNT)
+nopref=3D${out##*: }
+bytes=3D${nopref%% *}
+
+if [ $bytes -gt $(_math "$fssize*1024") ]; then
+=09status=3D1
+=09echo "After the full fs discard $bytes bytes were discarded"\
+=09     "however the file system is $(_math "$fssize*1024") bytes long=
."
+fi
+
+# Btrfs is special and this test does not apply to it
+# It is because btrfs does not have not-yet-used parts of the device
+# mapped and since we got here right after the mkfs, there is not
+# enough free extents in the root tree.
+if [ $bytes -le $(_math "$fssize*512") ] && [ $FSTYP !=3D "btrfs" ]; t=
hen
+=09status=3D1
+=09echo "After the full fs discard $bytes bytes were discarded"\
+=09     "however the file system is $(_math "$fssize*1024") bytes long=
."
+fi
+
+# Now to catch overflows due to fsblk->allocation group number convers=
ion
+# This is different for every file system and it also apply just to so=
me of
+# them. In order to add check specific for file system you're interest=
ed in
+# compute the arguments as you need and make the file system with prop=
er
+# alignment
+
+# (2^32-1) + 2 (this is set to overflow 32bit variable by 2)
+base=3D$(_math "2^32+1")
+
+case $FSTYP in
+=09ext[34])
+=09=09agsize=3D32768
+=09=09bsize=3D4096
+=09=09start=3D$(_math "$base*$agsize*$bsize")
+=09=09len=3D$start
+=09=09export MKFS_OPTIONS=3D"-F -b $bsize -g $agsize"
+=09=09;;
+=09xfs)
+=09=09agsize=3D65538
+=09=09bsize=3D4096
+=09=09start=3D$(_math "$base*$agsize*$bsize")
+=09=09len=3D$start
+=09=09export MKFS_OPTIONS=3D"-f -d agsize=3D$(_math "$agsize*$bsize") =
-b size=3D$bsize"
+=09=09;;
+=09*)
+=09=09# (2^32-1) * 4096 * 65536 =3D=3D 32bit max size * block size * a=
g size
+=09=09start=3D$(_math "(2^32 - 1) * 4096 * 65536")
+=09=09len=3D$start
+=09=09;;
+esac
+
+_scratch_unmount
+_scratch_mkfs >/dev/null 2>&1
+_scratch_mount
+# It should fail since $start is beyond the end of file system
+$FSTRIM_PROG -o$start -l10M $SCRATCH_MNT &> /dev/null
+if [ $? -eq 0 ]; then
+=09status=3D1
+=09echo "It seems that fs logic handling start"\
+=09     "argument overflows"
+fi
+
+_scratch_unmount
+_scratch_mkfs >/dev/null 2>&1
+_scratch_mount
+
+# len should be big enough to cover the whole file system, so if the
+# number of discarded bytes is smaller than file system size/2 then it
+# most likely overflowed
+# Btrfs is special and this test does not apply to it
+# It is because btrfs does not have not-yet-used parts of the device
+# mapped and since we got here right after the mkfs, there is not
+# enough free extents in the root tree.
+out=3D$($FSTRIM_PROG -v -l$len $SCRATCH_MNT)
+nopref=3D${out##*: }
+bytes=3D${nopref%% *}
+if [ $bytes -le $(_math "$fssize*512") ] && [ $FSTYP !=3D "btrfs" ]; t=
hen
+=09status=3D1
+=09echo "It seems that fs logic handling len argument overflows"
+fi
+
+echo "Test done"
+exit
