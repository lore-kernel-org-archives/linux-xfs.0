--
-#
-
-seq=3D`basename $0`
-echo "QA output created by $seq"
-
-here=3D`pwd`
-tmp=3D/tmp/$$
-status=3D1=09# failure is the default!
-trap "_cleanup; exit \$status" 0 1 2 3 15
-
-_cleanup()
-{
-    cd /
-    rm -f $tmp.*
-}
-
-_create_dirents()
-{
-=09start_num=3D$1
-=09end_num=3D$2
-=09cd $fork_dir
-=09for i in `seq $start_num $end_num`; do
-=09=09touch file.$i
-=09done
-}
-
-_create_eas()
-{
-=09start_num=3D$1
-=09end_num=3D$2
-=09for i in `seq $start_num $end_num`; do
-=09=09$SETFATTR_PROG -n user.$i -v 0xbabe $fork_dir
-=09done
-}
-
-_rmv_eas()
-{
-=09start_num=3D$1
-=09end_num=3D$2
-=09for i in `seq $start_num $end_num`; do
-=09=09$SETFATTR_PROG -x user.$i $fork_dir
-=09done
-}
-
-_filter_inode()
-{
-=09tee -a $here/$seq.full | \
-=09=09sed -e "s/core.forkoff/forkoff/g" | \
-=09=09egrep '^u.sfdir2|^a.sfattr|forkoff' | \
-=09=09egrep -v 'inumber|parent'
-}
-
-_filter_version()
-{
-=09tee -a $here/$seq.full | tr ',' '\n' | grep ATTR
-}
-
-_print_inode()
-{
-=09echo ""
-=09echo "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D"
-=09$XFS_DB_PROG -c "version" $SCRATCH_DEV 2>&1 | _filter_version
-=09$XFS_DB_PROG -c "inode $inum" -c p $SCRATCH_DEV 2>&1 | _filter_inod=
e
-=09echo "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D"
-}
-
-_do_eas()
-{
-=09echo ""
-=09_scratch_mount
-=09if [ $1 =3D "-r" ]; then=20
-=09=09echo "*** remove EAs start $2 end $3 ***"
-=09=09_rmv_eas $2 $3
-=09else
-=09=09echo "*** create EAs start $2 end $3 ***"
-=09=09_create_eas $2 $3
-=09fi
-=09echo ""
-=09cd /; $UMOUNT_PROG $SCRATCH_MNT
-=09_print_inode
-}
-
-_do_dirents()
-{
-=09num=3D`expr $2 - $1 + 1`
-=09echo ""
-=09echo "*** create $num dirents ***"
-=09echo ""
-=09_scratch_mount
-=09_create_dirents $1 $2
-=09cd /; $UMOUNT_PROG $SCRATCH_MNT
-=09_print_inode
-}
-
-_changeto_attr1()
-{
-=09echo ""
-=09echo "Try setting attr1 by db"
-=09echo ""
-=09$XFS_DB_PROG -x -c "version attr1" $SCRATCH_DEV | _filter_version
-}
-
-
-# get standard environment, filters and checks
-. ./common.rc
-. ./common.filter
-. ./common.attr
-
-# real QA test starts here
-
-# Modify as appropriate.
-_supported_fs xfs
-_supported_os Linux
-
-_require_scratch
-_require_attrs
-
-rm -f $seq.full
-
-_scratch_mkfs -i attr=3D2,size=3D512 -l lazy-count=3D1 >/dev/null 2>&1
-
-# set inum to root dir ino
-# we'll add in dirents and EAs into the root directory
-eval `$XFS_DB_PROG -r -c 'sb 0' -c 'p rootino' $SCRATCH_DEV | $SED_PRO=
G 's/ //g'`
-inum=3D$rootino
-fork_dir=3D$SCRATCH_MNT
-_print_inode
-
-# add enough dirents to be inline but more
-# than will fit for m_attroffset for 512b inodes
-# for attr2 this is not a problem
-_do_dirents 1 25=20
-
-# add 1 ea so we get our forkoff happening=20
-_do_eas -c 1 1
-
-# now change back to attr1 where forkoff is constant now
-_changeto_attr1
-
-# now add another EA
-# for a bug in xfs_add_shortform_bytesfit
-# where it resets the forkoff to m_attroffset>>3 instead of=20
-# leaving as di_forkoff
-# If it resets to m_attroffset which is in the middle of
-# the dirents then they will get corrupted
-_do_eas -c 2 2
-
-# success, all done
-status=3D0
-exit
