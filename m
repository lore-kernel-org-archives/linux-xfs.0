+static int crc32c_test(void)
+{
+	int i;
+	int errors =3D 0;
+	int bytes =3D 0;
+	struct timeval start, stop;
+	uint64_t usec;
+
+	/* keep static to prevent cache warming code from
+	 * getting eliminated by the compiler */
+	static u32 crc;
+
+	/* pre-warm the cache */
+	for (i =3D 0; i < 100; i++) {
+		bytes +=3D 2*test[i].length;
+
+		crc ^=3D crc32c_le(test[i].crc, test_buf +
+		    test[i].start, test[i].length);
+	}
+
+	gettimeofday(&start, NULL);
+	for (i =3D 0; i < 100; i++) {
+		if (test[i].crc32c_le !=3D crc32c_le(test[i].crc, test_buf +
+		    test[i].start, test[i].length))
+			errors++;
+	}
+	gettimeofday(&stop, NULL);
+
+	usec =3D stop.tv_usec - start.tv_usec +
+		1000000 * (stop.tv_sec - start.tv_sec);
+
+	if (errors)
+		printf("crc32c: %d self tests failed\n", errors);
+	else {
+		printf("crc32c: tests passed, %d bytes in %" PRIu64 " usec\n",
+			bytes, usec);
+	}
+
+	return errors;
+}
