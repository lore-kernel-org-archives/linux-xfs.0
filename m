+_cleanup()
+{
+    cd /
+    rm -f $tmp.*
+    _put_scsi_debug_dev
+}
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.scsi_debug
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux
+
+_require_scsi_debug
+
+rm -f $seq.full
+
+# Remove xfs signature so -f isn't needed to re-mkfs
+_wipe_device()
+{
+=09device=3D$1
+=09dd if=3D/dev/zero of=3D$device bs=3D4k count=3D1 &>/dev/null
+}
+
+_check_mkfs()
+{
+=09echo "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D"=20
+=09echo "mkfs with opts: $@" | sed -e "s,/dev/sd.,DEVICE,"
+=09/sbin/mkfs.xfs $@ 2>/dev/null > $tmp.mkfs.full
+=09if [ $? -ne 0 ]; then
+=09=09echo "Failed."
+=09=09return
+=09fi
+=09echo "Passed."
+=09cat $tmp.mkfs.full | _filter_mkfs >> $seq.full 2>$tmp.mkfs
+=09. $tmp.mkfs
+=09echo "Got sector size: $sectsz"
+=09device=3D`echo $@ | awk '{print $NF}'`
+=09_wipe_device $device
+}
+
+# =3D=3D=3D 4k physical 512b logical aligned
+(
+echo "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D"
+echo "4k physical 512b logical aligned"
+SCSI_DEBUG_DEV=3D`_get_scsi_debug_dev 4096 512 0 128`
+# sector size should default to 4k
+_check_mkfs $SCSI_DEBUG_DEV
+# blocksize smaller than physical sectorsize should revert to logical =
sectorsize
+_check_mkfs -b size=3D2048 -f $SCSI_DEBUG_DEV
+) | tee -a $seq.full
+_put_scsi_debug_dev
+
+# =3D=3D=3D 4k physical 512b logical unaligned
+(
+echo "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D"
+echo "4k physical 512b logical unaligned"
+SCSI_DEBUG_DEV=3D`_get_scsi_debug_dev 4096 512 1 128`
+# should fail on misalignment
+_check_mkfs $SCSI_DEBUG_DEV
+# should fall back to logical sector size with force
+_check_mkfs -f $SCSI_DEBUG_DEV
+# with 4k sector specified should fail without force
+_check_mkfs -s size=3D4096 $SCSI_DEBUG_DEV
+# with 4k sector specified should fall back to logical sector size wit=
h force
+_check_mkfs -s size=3D4096 -f $SCSI_DEBUG_DEV
+) | tee -a $seq.full
+_put_scsi_debug_dev
+
+# =3D=3D=3D hard 4k physical / 4k logical
+(
+echo "=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D"
+echo "hard 4k physical / 4k logical"
+SCSI_DEBUG_DEV=3D`_get_scsi_debug_dev 4096 4096 0 128`
+# block size smaller than sector size should fail=20
+_check_mkfs -b size=3D2048 $SCSI_DEBUG_DEV
+# sector size smaller than physical sector size should fail
+_check_mkfs -s size=3D512 $SCSI_DEBUG_DEV
+) | tee -a $seq.full
+_put_scsi_debug_dev
+
+status=3D0
+exit
