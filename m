-# _fill_fs()
-#
-# Fills a file system by repeatedly creating files in the given folder
-# starting with the given file size.  Files are reduced in size when
-# they can no longer fit untill no more files can be created.
-#
-# This routine is used by _test_full_fs_punch to test that a hole may
-# still be punched when the disk is full by borrowing reserved blocks.
-# All files are created as a non root user to prevent reserved blocks
-# from being consumed.
-#
-_fill_fs() {
-=09local file_size=3D$1
-=09local dir=3D$2
-=09local block_size=3D$3
-=09local file_count=3D1
-=09local bytes_written=3D0
-
-=09if [ $# -ne 3 ]
-=09then
-=09=09echo "USAGE: _fill_fs filesize dir block size"
-=09=09exit 1
-=09fi
-
-=09# Creation of files or folders
-=09# must not be done as root or
-=09# reserved blocks will be consumed
-=09_user_do "mkdir -p $dir &> /dev/null"
-=09if [ $? -ne 0 ] ; then
-=09=09return 0
-=09fi
-
-=09if [ $file_size -lt $block_size ]
-=09then
-=09=09$file_size =3D $block_size
-=09fi
-
-=09while [ $file_size -ge $block_size ]
-=09do
-=09=09bytes_written=3D0
-=09=09_user_do "$XFS_IO_PROG -F -f -c \"pwrite 0 $file_size\" $dir/$fi=
le_count.bin &> /dev/null"
-
-=09=09if [ -f $dir/$file_count.bin ]
-=09=09then
-=09=09=09bytes_written=3D`$XFS_IO_PROG -F -c "stat"  $dir/$file_count.=
bin | grep stat.size | cut -d ' ' -f3`
-=09=09fi
-
-=09=09# If there was no room to make the file,
-=09=09# then divide it in half, and keep going
-=09=09if [ $bytes_written -lt $file_size ]
-=09=09then
-=09=09=09file_size=3D$(( $file_size / 2 ))
-=09=09fi
-=09=09file_count=3D$(( $file_count + 1 ))
-
-=09done
-}
-
-# _test_full_fs_punch()
-#
-# This function will test that a hole may be punched
-# even when the file system is full.  Reserved blocks
-# should be used to allow a punch hole to proceed even
-# when there is not enough blocks to further fragment the
-# file. To test this, this function will fragment the file
-# system by punching holes in regular intervals and filling
-# the file system between punches.
-#
-_test_full_fs_punch()
-{
-=09local hole_len=3D$1      # The length of the holes to punch
-=09local hole_interval=3D$2 # The interval between the holes
-=09local iterations=3D$3    # The number of holes to punch
-=09local file_name=3D$4     # File to punch holes in
-=09local block_size=3D$5    # File system block size
-=09local file_len=3D$(( $(( $hole_len + $hole_interval )) * $iteration=
s ))
-=09local path=3D`dirname $file_name`
-=09local hole_offset=3D0
-
-=09if [ $# -ne 5 ]
-=09then
-=09=09echo "USAGE: _test_full_fs_punch hole_len hole_interval iteratio=
ns file_name block_size"
-=09=09exit 1
-=09fi
-
-=09rm -f $file_name &> /dev/null
-
-=09$XFS_IO_PROG -F -f -c "pwrite 0 $file_len" \
-=09=09-c "fsync" $file_name &> /dev/null
-=09chmod 666 $file_name
-
-=09_fill_fs $(( 1024 * 1024 * 1024 )) $path/fill $block_size
-
-=09for (( i=3D0; i<$iterations; i++ ))
-=09do
-=09=09# This part must not be done as root in order to
-=09=09# test that reserved blocks are used when needed
-=09=09_user_do "$XFS_IO_PROG -F -f -c \"fpunch $hole_offset $hole_len\=
" $file_name"
-=09=09rc=3D$?
-=09=09if [ $? -ne 0 ] ; then
-=09=09=09echo Punch hole failed
-=09=09=09break
-=09=09fi
-
-=09=09hole_offset=3D$(( $hole_offset + $hole_len + $hole_interval ))
-
-=09=09_fill_fs $hole_len $path/fill.$i $block_size
-
-=09done
-}
