-#
-
-seq=3D`basename $0`
-echo "QA output created by $seq"
-
-here=3D`pwd`
-tmp=3D/tmp/$$
-status=3D1=09# failure is the default!
-
-_cleanup()
-{
-=09rm -f $tmp.*
-=09rm -f $SCRATCH_MNT/testfile.*
-}
-
-trap "_cleanup ; exit \$status" 0 1 2 3 15
-
-# get standard environment, filters and checks
-. ./common.rc
-. ./common.filter
-
-# real QA test starts here
-_supported_fs generic
-_supported_os Linux
-
-_require_scratch
-
-# make a 1GB filesystem
-_scratch_mkfs_sized `expr 1024 \* 1024 \* 1024` > $seq.full 2>&1
-_scratch_mount >> $seq.full 2>&1
-
-# set the reserved block pool to almost empty for XFS
-if [ "$FSTYP" =3D "xfs" ]; then
-=09xfs_io -x -c "resblks 4" $SCRATCH_MNT >> $seq.full 2>&1
-fi
-
-FILES=3D1000
-for i in `seq 0 1 $FILES`; do
-
-=09# set the file size to be 10MB - that way the direct IO will always=
 try
-=09# to read at least 10MB even if only 4k was written. This allows
-=09# discarded delalloc pages that would have been beyond EOF to be
-=09# tripped over.
-        (
-=09=09sleep 5
-=09=09xfs_io -f -c "truncate 10485760" $SCRATCH_MNT/testfile.$i
-=09=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/testfile.$i bs=3D4k conv=3Dn=
otrunc
-=09) > /dev/null 2>&1 &
-done
-wait
-
-for i in `seq 0 1 $FILES`; do
-        dd of=3D/dev/null if=3D$SCRATCH_MNT/testfile.$i bs=3D512k ifla=
g=3Ddirect > /dev/null 2>&1 &
-done
-wait
-echo "*** Silence is golden ***"
-status=3D0
-exit
