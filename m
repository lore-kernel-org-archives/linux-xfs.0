+
+cd $SCRATCH_MNT
+
+sizes=3D"1 20 300 40000 3000000 12345"
+for size in $sizes ; do
+=09$here/src/append_writer $size &
+=09echo $! $size >> pids
+done
+
+cd $here
+
+wait
+ls -lh $SCRATCH_MNT >> $seq.full
+echo "*** PIDs file" >> $seq.full
+cat $SCRATCH_MNT/pids >> $seq.full
+
+cat $SCRATCH_MNT/pids | while read pid size
+do
+=09echo "*** checking file with $size integers"
