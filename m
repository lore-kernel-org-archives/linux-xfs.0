+
+#
+# filter out counts which will vary
+#   - extsz, blocks, agsize, agcount, device name, rtextents
+# filter out differences between linux and irix:
+#   - sectsz on Linux
+#   - mmr, mixed-case on IRIX
+#   - lazy-count on IRIX
+#   - inode-paths on IRIX
+#   - trailing spaces on Linux but not on IRIX
+#
+# Example output:
+#  meta-data=3DDEV isize=3D256    agcount=3DN, agsize=3DN blks
+#  data     =3D                       bsize=3D4096   blocks=3DN, imaxp=
ct=3D25
+#           =3D                       sunit=3D65     swidth=3D65 blks,=
 unwritten=3D1
+#  naming   =3Dversion 2              bsize=3D4096
+#  log      =3Dinternal log           bsize=3D4096   blocks=3DN, versi=
on=3D1
+#           =3D                       sunit=3D0 blks
+#  realtime =3Dnone                   extsz=3D65536  blocks=3DN, rtext=
ents=3DN
+#
+_mkfs_filter()
+{
+   tee -a $seq.full | \
+   sed \
+=09-e 's/extsz=3D[0-9][0-9]*[ ]*/extsz=3DN, /' \
+=09-e 's/blocks=3D[0-9][0-9]*/blocks=3DN/' \
+=09-e 's/imaxpct=3D[0-9][0-9]*/imaxpct=3DN/' \
+=09-e 's/agsize=3D[0-9][0-9]*/agsize=3DN/' \
+=09-e 's/agcount=3D[0-9][0-9]*/agcount=3DN/' \
+        -e 's/swidth=3D[0-9][0-9]* blks$/&, unwritten=3D1/' \
+=09-e 's/rtextents=3D[0-9][0-9]*/rtextents=3DN/' \
+=09-e 's/meta-data=3D[^ ]*/meta-data=3DDEV/' \
+        -e 's/ *isize/ isize/' \
+=09-e '/ *=3D *sectsz=3D[0-9][0-9]* *attr=3D[0-9][0-9]*.*$/d' \
+=09-e '/ *=3D *mmr=3D[0-9][0-9]* *$/d' \
+=09-e 's/ *mixed-case=3D[YN]//' \
+=09-e 's/ *ascii-ci=3D[01]//' \
+=09-e 's/sectsz=3D[0-9][0-9]* *//' \
+=09-e 's/, lazy-count.*//' \
+=09-e '/inode-paths/d' \
+=09-e 's/\(log[ =09]*=3D\).*bsize/\1LOG                    bsize/' \
+=09-e 's/\(realtime[ =09]*=3D\).*extsz/\1REALTIME               extsz/=
' \
+=09-e 's/ *$//' \
+   | grep -v parent
+}
