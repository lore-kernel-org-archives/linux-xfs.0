+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+# creator
+owner=3Ddmonakhov@openvz.org
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+_supported_fs ext3 ext4 xfs btrfs reiserfs
+_supported_os Linux
+_need_to_be_root
+_require_scratch
+_require_fail_make_request
+
+# TODO: Function are common enough to be moved to common.blkdev
+SCRATCH_REAL_DEV=3D`readlink -f $SCRATCH_DEV`
+SCRATCH_BDEV=3D`basename $SCRATCH_REAL_DEV`
+
+allow_fail_make_request()
+{
+    echo "Allow global fail_make_request feature"
+    echo 100 > $DEBUGFS_MNT/fail_make_request/probability
+    echo 9999999 > $DEBUGFS_MNT/fail_make_request/times
+    echo 0 >  /sys/kernel/debug/fail_make_request/verbose
+}
+
+disallow_fail_make_request()
+{
+    echo "Disallow global fail_make_request feature"
+    echo 0 > $DEBUGFS_MNT/fail_make_request/probability
+    echo 0 > $DEBUGFS_MNT/fail_make_request/times
+}
+
+start_fail_scratch_dev()
+{
+    echo "Force SCRATCH_DEV device failure"
+    echo " echo 1 > /sys/block/$SCRATCH_BDEV/make-it-fail" >> $here/$s=
eq.full
+    echo 1 > /sys/block/$SCRATCH_BDEV/make-it-fail
+
+}
+
+stop_fail_scratch_dev()
+{
+    echo "Make SCRATCH_DEV device operable again"
+    echo " echo 0 > /sys/block/$SCRATCH_BDEV/make-it-fail" >> $here/$s=
eq.full
+    echo 0 > /sys/block/$SCRATCH_BDEV/make-it-fail
+
+}
+
+_cleanup()
+{
+    poweron_scratch_dev
+    disallow_fail_make_request
+}
+trap "_cleanup; exit \$status" 1 2 3 15
+
+RUN_TIME=3D$((20+10*$TIME_FACTOR))
+NUM_JOBS=3D$((4*LOAD_FACTOR))
+BLK_DEV_SIZE=3D`blockdev --getsz $SCRATCH_DEV`
+FILE_SIZE=3D$((BLK_DEV_SIZE * 512))
+
+cat >$tmp-$seq.fio <<EOF
+###########
+# $seq test's fio activity
+# Filenames derived from jobsname and jobid like follows:
+# ${JOB_NAME}.${JOB_ID}.${ITERATION_ID}
+[global]
+ioengine=3Dlibaio
+bs=3D4k
+directory=3D${SCRATCH_MNT}
+filesize=3D${FILE_SIZE}
+size=3D9999T
+continue_on_error=3Dwrite
+ignore_error=3DEIO,ENOSPC:EIO
+error_dump=3D0
+
+[stress_dio_aio_activity]
+create_on_open=3D1
+fallocate=3Dnone
+iodepth=3D128*${LOAD_FACTOR}
+direct=3D1
+buffered=3D0
+numjobs=3D${NUM_JOBS}
+rw=3Drandwrite
+runtime=3D40+${RUN_TIME}
+time_based
+
+[stress_mmap_activity]
+ioengine=3Dmmap
+create_on_open=3D0
+fallocate=3D1
+fdatasync=3D40960
+filesize=3D8M
+size=3D9999T
+numjobs=3D${NUM_JOBS}
+rw=3Drandwrite
+runtime=3D40+${RUN_TIME}
+time_based
+
+EOF
+
+_require_fio $tmp-$seq.fio
+
+# Disable all sync operations to get higher load
+FSSTRESS_AVOID=3D"$FSSTRESS_AVOID -ffsync=3D0 -fsync=3D0 -ffdatasync=
=3D0 -f setattr=3D1"
+
+_workout()
+{
+=09out=3D$SCRATCH_MNT/fsstress.$$
+=09args=3D`_scale_fsstress_args -p 1 -n999999999 -f setattr=3D0 $FSSTR=
ESS_AVOID -d $out`
+=09echo ""
+=09echo "Start fsstress.."
+=09echo ""
+=09echo "fsstress $args" >> $here/$seq.full
+=09$FSSTRESS_PROG $args > /dev/null 2>&1 &
+=09fs_pid=3D$!
+=09echo "Start fio.."
+=09cat $tmp-$seq.fio >>  $seq.full
+=09$FIO_PROG $tmp-$seq.fio >> $here/$seq.full 2>&1 &
+=09fio_pid=3D$!
+
+=09# Let's it work for awhile, and force device failure
+=09sleep $RUN_TIME
+=09start_fail_scratch_dev
+=09# After device turns in to failed state filesystem may yet not know=
 about
+=09# that so buffered write(2) may succeed, but any integrity operatio=
ns
+=09# such as (sync, fsync, fdatasync, direct-io) should fail.
+=09dd if=3D/dev/zero of=3D$SCRATCH_MNT/touch_failed_filesystem count=
=3D1 bs=3D4k conv=3Dfsync \
+=09    >> $here/$seq.full 2>&1 && \
+=09    _fail "failed: still able to perform integrity fsync on $SCRATC=
H_MNT"
+
+=09kill $fs_pid
+=09wait $fs_pid
+=09wait $fio_pid
+
+=09# We expect that broken FS still can be umounted
+=09run_check umount $SCRATCH_DEV
+=09# Once filesystem was umounted no one is able to write to block dev=
ice
+=09# It is now safe to bring device back to normal state
+=09stop_fail_scratch_dev
+
+=09# In order to check that filesystem is able to recover journal on m=
ount(2)
+=09# perform mount/umount, after that all errors should be fixed
+=09run_check _scratch_mount
+=09run_check _scratch_unmount
+=09_check_scratch_fs
+}
+
+# real QA test starts here
+
+_scratch_mkfs >> $here/$seq.full 2>&1 || _fail "mkfs failed"
+_scratch_mount || _fail "mount failed"
+allow_fail_make_request
+_workout
+status=3D$?
+disallow_fail_make_request
+exit
