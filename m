-FILEFRAG_FILTER=3D'if (/, blocksize (\d+)/) {$blocksize =3D $1; next} =
($ext, '\
-'$logical, $physical, $expected, $length, $flags) =3D (/^\s*(\d+)\s+(\=
d+)'\
-'\s+(\d+)\s+(?:(\d+)\s+)?(\d+)\s+(.*)/) or next; $flags =3D~ '\
-'/(?:^|,)inline(?:,|$)/ and next; print $physical * $blocksize, "#", '=
\
