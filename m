-=09if ($7 >=3D 10000)
-=09=09unwritten_ext =3D 1;
-
-=09size =3D "RIGHT"
-=09flags =3D "GOOD"
-=09if (unwritten_ext) {
-=09=09if (unwritten1) {
-=09=09=09if ($6 !=3D unwritten1)
-=09=09=09=09size =3D "WRONG"
-=09=09=09unwritten1 =3D 0;
-=09=09} else if ($6 !=3D unwritten2) {
-=09=09=09size =3D "WRONG"
-=09=09}
-=09} else {
-=09=09if ($6 !=3D written_size)
-=09=09=09size =3D "WRONG"
-=09}
-=09print $1, "[AA..BB]", "XX..YY", "AG", "(AA..BB)", size, flags
-}'
