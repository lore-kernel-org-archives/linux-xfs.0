+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "_cleanup; exit \$status" 0 1 2 3 15
+tag=3D"added by qa $seq"
+
+_cleanup()
+{
+=09cd /
+=09umount $SCRATCH_MNT 2>/dev/null
+=09_putback_scratch_fstab
+=09rm -f $tmp.*
+}
+
+_scratch_filter()
+{
+=09sed -e "s#$SCRATCH_DEV#SCRATCH_DEV#" \
+=09    -e "s#$SCRATCH_MNT#SCRATCH_MNT#" \
+=09    -e "s#,context.*s0\"##"
+}
+
+_check_mount()
+{
+=09# assumes that we don't have extra ops in fstab
+=09_mount | grep $SCRATCH_MNT | _scratch_filter
+}
+
+#
+# mount(8) adds all options from mtab and fstab to the mount command
+# line.  So the filesystem either must not reject any option at all
+# if it can't change it, or compare the value on the command line
+# to the existing state and only reject it if it would change
+# something that can't be changed.
+#
+# Test this behaviour by mounting a filesystem read-only with a non-
+# default option and then try to remount it rw.
+#
+# note that mount(8) doesn't add the options when specifying both the
+# device node and mount point, so test out the various mounting
+# alternatives
+#
+_test_remount_rw()
+{
+=09# use filestreams as a hopefully never default option
+=09echo
+=09echo "try remount ro,filestreams -> rw,filestreams"
+=09echo
+=09_scratch_mount -o ro,filestreams
+=09[ $? -eq 0 ] || echo "ro,filestreams mount failed unexpectedly"
+=09_check_mount
+
+=09for dev_mnt in $SCRATCH_DEV $SCRATCH_MNT "$SCRATCH_DEV $SCRATCH_MNT=
"; do
+=09=09echo "mounting given: $dev_mnt" | _scratch_filter
+=09=09_mount -o remount,rw $dev_mnt
+=09=09[ $? -eq 0 ] || echo "remount rw failed"
+=09=09_check_mount
+=09done
+
+=09umount $SCRATCH_MNT
+
+=09echo
+=09echo "try remount ro,noattr2 -> rw,attr2"
+=09echo
+=09_scratch_mount -o ro,noattr2
+=09[ $? -eq 0 ] || echo "ro,noattr2 mount failed unexpectedly"
+=09_check_mount
+
+=09for dev_mnt in $SCRATCH_DEV $SCRATCH_MNT "$SCRATCH_DEV $SCRATCH_MNT=
"; do
+=09=09echo "mounting given: $dev_mnt" | _scratch_filter
+=09=09_mount -o remount,rw,attr2 $dev_mnt
+=09=09[ $? -eq 0 ] || echo "remount rw,attr2 failed"
+=09=09_check_mount
+=09done
+
+=09umount $SCRATCH_MNT
+}
+
+#
+# make sure we really can write to a filesystem after remount,rw
+#
+_test_remount_write()
+{
+=09echo
+=09echo "try touching file after remount ro -> rw with options"
+=09echo
+=09_scratch_mount
+=09[ $? -eq 0 ] || echo "mount (1) failed unexpectedly"
+
+=09touch $SCRATCH_MNT/foobar
+=09[ $? -eq 0 ] || echo "touch (1) failed unexpectedly"
+
+=09umount $SCRATCH_MNT
+
+=09_scratch_mount -o ro
+=09[ $? -eq 0 ] || echo "mount (2) failed unexpectedly"
+
+=09_mount -o remount,rw,filestreams $SCRATCH_MNT
+=09[ $? -eq 0 ] || echo "remount failed unexpectedly"
+
+=09touch $SCRATCH_MNT/foobar
+=09[ $? -eq 0 ] || echo "touch (2) failed unexpectedly"
+
+=09umount $SCRATCH_MNT
+}
+
+#
+# barrier is the only option we can change besides ro<->rw which is pa=
rtially
+# handled by the VFS and tested elsewhere.  Make sure mount accepts go=
ing
+# from barrier (which also is the default) to nobarrier and back.
+#
+_test_remount_barrier()
+{
+=09echo
+=09echo "Do remount barrier tests"
+=09echo
+
+=09# mention barrier explicitly even if it's currently the default jus=
t to be sure
+=09_scratch_mount -o barrier
+=09[ $? -eq 0 ] || echo "mount failed unexpectedly!"
+=09_check_mount
+
+=09_scratch_mount -o remount,nobarrier
+=09[ $? -eq 0 ] || _fail "remount nobarrier failed"
+=09_check_mount
+
+=09_scratch_mount -o remount,barrier
+=09[ $? -eq 0 ] || _fail "remount barrier failed"
+=09_check_mount
+
+=09umount $SCRATCH_MNT
+}
+
+
+#
+# Example fstab entry
+# /dev/sdb2            /mnt/scratch1        xfs       defaults 0 0
+#
+_add_scratch_fstab()
+{
+=09# comment out any existing SCRATCH_DEV
+=09$SED_PROG -i "s;$SCRATCH_DEV;#$SCRATCH_DEV;" /etc/fstab
+
+=09# add our fstab entry
+=09echo "$SCRATCH_DEV $SCRATCH_MNT xfs defaults 0 0 # $tag" >> /etc/fs=
tab
+}
+
+_modify_scratch_fstab()
+{
+=09opts=3D$1
+
+=09# modify our fstab entry that we added
+=09# modify opts by looking for last word which has non-space chars
+=09$SED_PROG -i "s; [^ ]* 0 0 # $tag; $opts 0 0 # $tag;" /etc/fstab
+}
+
+_putback_scratch_fstab()
+{
+=09# uncomment out any existing SCRATCH_DEV
+=09$SED_PROG -i "s;#$SCRATCH_DEV;$SCRATCH_DEV;" /etc/fstab
+
+=09# remove the one we added at the end
+=09$SED_PROG -i "/# $tag/d" /etc/fstab
+}
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux
+
+_need_to_be_root
+_require_scratch
+
+unset SCRATCH_RTDEV
+unset SCRATCH_LOGDEV
+
+_scratch_mkfs_xfs | _filter_mkfs 2>/dev/null
+
+_add_scratch_fstab
+_test_remount_rw
+_test_remount_write
+
+echo
+echo "add noikeep to fstab for scratch"
+_modify_scratch_fstab noikeep # noikeep is not default for non dmapi
+_test_remount_rw
+
+_putback_scratch_fstab
+_test_remount_barrier
+
+# success, all done
+echo "*** done"
+rm -f $seq.full
+status=3D0
