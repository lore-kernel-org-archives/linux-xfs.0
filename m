+    $AWK_PROG -v full_file=3D$here/$seq.full -v verify=3D$verify <$tmp=
.config '
+BEGIN=09{ nfile =3D 0 }
+/^\#/=09{ next }
+=09{ file[nfile] =3D $1
+=09  size[nfile] =3D $2
+=09  link[nfile] =3D 0
+=09  nfile++
+=09  total_size +=3D $2
+=09}
+END=09{ srand('$iter')
