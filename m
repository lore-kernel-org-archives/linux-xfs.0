/*
  * Run as "./repro outfile 1000", where "outfile" sits on an XFS filesystem.
  */

#include <stdlib.h>
#include <stdio.h>
#include <fcntl.h>
#include <signal.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/mman.h>

#define CHUNK (32768)

static const char crap[CHUNK];

int main(int argc, char **argv)
{
	int r, fd, i;
	size_t allocsize, count;
	void *p;

	if (argc != 3) {
		printf("Usage: %s filename count\n", argv[0]);
		return 1;
	}

	fd = open(argv[1], O_RDWR|O_CREAT, 0644);
	if (fd == -1) {
		perror("Can't open");
		return 1;
	}

	if (!fork()) {
		count = atol(argv[2]);

		while (1) {
			for (i = 0; i < count; i++)
				if (write(fd, crap, CHUNK) != CHUNK)
					perror("Eh?");

			fsync(fd);
			ftruncate(fd, 0);
		}
	}

	allocsize = 1UL << 40;
	while (allocsize)
		if (mmap(NULL, allocsize, PROT_READ|PROT_WRITE, MAP_ANON|MAP_PRIVATE|MAP_POPULATE, -1, 0) == MAP_FAILED)
			allocsize >>= 1;

	return kill(0, SIGKILL);
}
