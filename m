+#! /bin/bash
+# FS QA Test No. 104
+#
+# XFS online growfs-while-allocating tests (data subvol variant)
+#
+#---------------------------------------------------------------------=
--
+# Copyright (c) 2000-2004 Silicon Graphics, Inc.  All Rights Reserved.
