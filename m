+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.quota
+
+# real QA test starts here
+_supported_fs generic
+_supported_os Linux #IRIX
+_require_scratch
+_require_quota
+_require_user
+_need_to_be_root
+
+test_files()
+{
+=09echo; echo "### create files, setting up ownership (type=3D$type)"
+=09touch $SCRATCH_MNT/file{1,2} 2>/dev/null
+=09chown $qa_user $SCRATCH_MNT/file{1,2} 2>/dev/null
+=09chgrp $qa_user $SCRATCH_MNT/file{1,2} 2>/dev/null
+=09chmod 777 $SCRATCH_MNT 2>/dev/null
+}
+
+test_enforcement()
+{
+=09echo "### some buffered IO (type=3D$type)"
+=09echo "--- initiating IO..." >>$seq.full
+=09# Firstly fit below block soft limit
+=09echo "Write 900k..."
+=09su $qa_user -c "$XFS_IO_PROG -F -c 'pwrite 0 900k' -c fsync \
+=09=09$SCRATCH_MNT/file1" 2>&1 >>$seq.full | tee -a $seq.full
+=09repquota -$type $SCRATCH_MNT  | grep -v "^root" >>$seq.full 2>&1
+=09# Secondly overcome block soft limit
+=09echo "Rewrite 1001k..."
+=09su $qa_user -c "$XFS_IO_PROG -F -c 'pwrite 0 1001k' -c fsync \
+=09=09$SCRATCH_MNT/file1" 2>&1 >>$seq.full | tee -a $seq.full
+=09repquota -$type $SCRATCH_MNT  | grep -v "^root" >>$seq.full 2>&1
+=09# Now try to overcome block hardlimit
+=09echo "Write 1000k..."
+=09su $qa_user -c "$XFS_IO_PROG -F -c 'pwrite 0 1000k' -c fsync \
+=09=09$SCRATCH_MNT/file2" 2>&1 >>$seq.full | tee -a $seq.full
+=09repquota -$type $SCRATCH_MNT  | grep -v "^root" >>$seq.full 2>&1
+=09# Now sleep for grace time and check that softlimit got enforced
+=09sleep $((grace+1))
+=09echo "Write 4096..."
+=09su $qa_user -c "$XFS_IO_PROG -F -c 'truncate 0' -c 'pwrite 0 4096' =
\
+=09=09$SCRATCH_MNT/file2" 2>&1 >>$seq.full | tee -a $seq.full
+=09repquota -$type $SCRATCH_MNT  | grep -v "^root" >>$seq.full 2>&1
+=09# And now the softlimit test for inodes
+=09# First reset space limits so that we don't have problems with
+=09# space reservations on XFS
+=09setquota -$type $qa_user 0 0 3 5 $SCRATCH_MNT
+=09echo "Touch 3+4"
+=09su $qa_user -c "touch $SCRATCH_MNT/file3 $SCRATCH_MNT/file4" \
+=09=092>&1 >>$seq.full | _filter_scratch | tee -a $seq.full
+=09repquota -$type $SCRATCH_MNT  | grep -v "^root" >>$seq.full 2>&1
+=09# Try to exceed inode hardlimit
+=09echo "Touch 5+6"
+=09su $qa_user -c "touch $SCRATCH_MNT/file5 $SCRATCH_MNT/file6" \
