+# real QA test starts here
+rm -f $seq.full
+
+# Modify as appropriate.
+_supported_fs xfs
+_supported_os IRIX Linux
+_require_scratch
+_require_v2log
+
+# choose .out file based on internal/external log
+rm -f $seq.out
+if [ "$USE_EXTERNAL" =3D yes ]; then
+=09ln -s $seq.external $seq.out
