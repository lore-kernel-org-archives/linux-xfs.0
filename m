+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D$(basename $0)
+echo "QA output created by ${seq}"
+
+here=3D$(pwd)
+
+tmp=3D/tmp/$$
+my_mtab=3D${tmp}.mtab
+
+mtab=3D/proc/self/mounts
+
+status=3D1=09# failure is the default!
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+_cleanup()
+{
+    cd /
+    rm -f ${tmp}.*
+}
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.quota
+
+echo "Silence is golden."
+
+# real QA test starts here
+
+# Modify as appropriate.
+_supported_fs xfs
+_supported_os Linux
+
+_require_quota
+_require_scratch
+
+# Just use the current mount table as an example mtab file.  Odds
+# are good there's nothing wrong with it.
+_setup_my_mtab() {
+=09cp "${mtab}" "${my_mtab}"
+}
+
+# Any bogus entry in the mtab file is enough to trigger the problem.
+# So just append a bogus entry at the end of the private mtab file.
+# This matches an actually-observed entry in a mount table (with a
+# few characters in the paths changed to protect the innocent).
+_perturb_my_mtab() {
+=09cat <<-! >> "${my_mtab}"
+=09=09/dev/disk/by-id/scsi-3600508e000000000c329ba1d8b0c391b-part3 /tm=
p/autoY8qcJ9\040(deleted) xfs rw 0 0
+=09!
+}
+
+_check() {
+=09if [ $# -eq 0 ]; then
+=09=09export MOUNT_OPTIONS=3D""
+=09elif [ $# -eq 1 ]; then
+=09=09[ $1 =3D u -o $1 =3D g -o $1 =3D p ] || exit
+=09=09export MOUNT_OPTIONS=3D"-o${1}quota"
+=09else
+=09=09exit
+=09fi
+
+=09_qmount
+
+=09# Set up a private mount table file, then try out a simple quota
+=09# command to show mounts
+=09_setup_my_mtab
+=09echo print | xfs_quota=09-t "${my_mtab}" > /dev/null || exit
+
+=09# Do the same simple quota command after adding a bogus entry to th=
e
+=09# mount table.  Old code will bail on this because it has trouble
+=09# with the bogus entry.
+=09_perturb_my_mtab
+=09echo print | xfs_quota -t "${my_mtab}" > /dev/null || exit
+}
+
+#########
+
+# Mount SCRATCH with no quota options
+_check
+
+# user quota enabled
+_check u
+
+# group quota enabled
+_check g
+
+# user quota enabled
+_check p
+
+status=3D0=09# success, all done
