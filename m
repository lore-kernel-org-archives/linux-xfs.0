+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1    # failure is the default!
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+_cleanup()
+{
+    _cleanup_testdir
+}
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os Linux IRIX
+
+_setup_testdir
+_require_scratch
+_scratch_mkfs_xfs >/dev/null 2>&1
+_scratch_mount
+
+# create files
+i=3D1;
+while [ $i -lt 1000 ]
+do
+=09file=3D$SCRATCH_MNT/$i
+=09xfs_io -f -c "pwrite -b 64k -S 0xff 0 64k" $file > /dev/null
+=09if [ $? -ne 0 ]
+=09then
+=09=09echo error creating/writing file $file
+=09=09exit
+=09fi
+=09let i=3D$i+1
+done
+
+# give the system a chance to write something out
+sleep 10
+
+src/godown $SCRATCH_MNT
+
+umount $SCRATCH_MNT
+_scratch_mount
+umount $SCRATCH_MNT
+if [ ! _check_scratch_fs ]
+then
+=09echo error detected in filesystem
+=09exit
+fi
+_scratch_mount
+
+# check file size and contents
+i=3D1;
+while [ $i -lt 1000 ]
+do
+=09file=3D$SCRATCH_MNT/$i
+=09# if file does not exist, the create was not logged, skip it
+=09if [ -e $file ]
+=09then
+=09=09# if file size is zero it cannot be corrupt, skip it
+=09=09if [ -s $file ]
+=09=09then
+=09=09=09# if file has non-zero size but no extents then it's contents=
 will be NULLs, bad.
+=09=09=09if xfs_bmap $file | grep 'no extents' > /dev/null
+=09=09=09then
+=09=09=09=09echo corrupt file $file - non-zero size but no extents
+=09=09=09elif xfs_bmap $file | grep 'hole' > /dev/null
+=09=09=09then
+=09=09=09=09echo corrupt file $file - contains holes
+=09=09=09else
+=09=09=09=09rm -f $file
+=09=09=09fi
+=09=09else
+=09=09=09rm -f $file
+=09=09fi
+=09fi
+=09let i=3D$i+1
+done
+
+status=3D0
+exit=20
