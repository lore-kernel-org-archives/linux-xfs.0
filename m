+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1
+
+trap "_cleanup; rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+_cleanup()
+{
+    cd /
+    rm -f $tmp.*
+    umount -d $LOOP_MNT 2>/dev/null
+    rmdir $LOOP_MNT
+    _cleanup_testdir
+}
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# loop devices are available in Linux only
+_supported_fs xfs
+_supported_os Linux
+
+# Must have loop device
+_require_loop
+
+LOOP_IMG=3D$TEST_DIR/$seq.fs
+LOOP_MNT=3D$TEST_DIR/$seq.mnt
+
+_filter_io()
+{
+=09sed -e '/.* ops; /d'
+}
+
+# real QA test starts here
+
+echo "*** create loop mount point"
+rmdir $LOOP_MNT 2>/dev/null
+mkdir -p $LOOP_MNT || _fail "cannot create loopback mount point"
+
+_grow_loop()
+{
+=09original=3D$1
+=09new_size=3D$2
+=09bsize=3D$3
+=09check=3D$4
+=09agsize=3D$5
+
+=09dparam=3D"file,name=3D$LOOP_IMG,size=3D$original"
+=09if [ -n "$agsize" ]; then
+=09=09dparam=3D"$dparam,agsize=3D$agsize"
+=09fi
+
+=09echo
+=09echo "=3D=3D=3D GROWFS (from $original to $new_size, $bsize blocksi=
ze)"
+=09echo
+
+=09echo "*** mkfs loop file (size=3D$original)"
+=09$MKFS_XFS_PROG -b size=3D$bsize -d $dparam \
+=09=09| _filter_mkfs 2>/dev/null
+
+=09echo "*** extend loop file"
+=09$XFS_IO_PROG -c "pwrite $new_size $bsize" $LOOP_IMG | _filter_io
+=09echo "*** mount loop filesystem"
+=09mount -t xfs -o loop $LOOP_IMG $LOOP_MNT
+
+=09echo "*** grow loop filesystem"
+=09#xfs_growfs $LOOP_MNT 2>&1 | grep -e "^data" #| _filter_growfs 2>/d=
ev/null
+=09$XFS_GROWFS_PROG $LOOP_MNT 2>&1 |  _filter_growfs 2>&1
+
+=09echo "*** unmount"
+=09umount -d $LOOP_MNT > /dev/null 2>&1
+
+=09# Large grows takes forever to check..
+=09if [ "$check" -gt "0" ]
+=09then
+=09=09echo "*** check"
+=09=09LOOP_DEV=3D`losetup -f`
+=09=09losetup $LOOP_DEV $LOOP_IMG
+=09=09 _check_xfs_filesystem $LOOP_DEV none none
+=09=09losetup -d $LOOP_DEV
+=09fi
+
+=09rm -f $LOOP_IMG
+}
+
+# Wes' problem sizes...
+_grow_loop 168024b 1376452608 4096 1
+
+# Some other blocksize cases...
+_grow_loop 168024b 1376452608 2048 1
+_grow_loop 168024b 1376452608 512 1 16m
+_grow_loop 168024b 688230400 1024 1
+
+
+# Other corner cases suggested by dgc
+# also the following doesn't check if the filesystem is consistent.
+#  - grow 1TB by 1.5TB (control)
+_grow_loop 1t 2500g 4096 0
+
+#  - grow 1TB by 2.5TB (grow by > 2TB)
+_grow_loop 1t 3500g 4096 0
+
+#  - grow 1TB by 3.5TB (grow past 4TB)
+_grow_loop 1t 4500g 4096 0
+
+#  - grow 1TB by 4.5TB (grow by > 4TB)
+_grow_loop 1t 5500g 4096 0
+
+#  - grow 1TB by 7.5TB (grow past 8TB)
+_grow_loop 1t 8500g 4096 0
+
+#  - grow 1TB by 8.5TB (grow by > 8TB)
+_grow_loop 1t 9500g 4096 0
+
+#  - grow 1TB by 14.5TB (grow by > 8TB)
+_grow_loop 1t 15500g 4096 0
+
+#  - grow 1TB by 15TB (grow to 16TB)
+_grow_loop 1t 16000g 4096 0
+
+# It would be nice to go on, but this would require a totally new test=
 in order
+# to take care of 64-bit machines.
+
+echo "*** all done"
+status=3D0
+exit
