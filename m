+{
+=09wroteblocks=3D$1
+=09wrotefiles=3D$2
+=09read id exceed blocks bsoft bhard inodes isoft ihard
+=09if [ "$blocks" -lt "$wroteblocks" ]; then
+=09=09echo "Too few blocks used (type=3D$type)"
