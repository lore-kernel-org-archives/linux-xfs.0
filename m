--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+_create_scratch()
+{
+=09echo "*** mkfs"
+=09_scratch_mkfs_xfs $@ | tee -a $seq.full | _filter_mkfs 2>$tmp.mkfs
+=09. $tmp.mkfs
+
+=09echo "*** mount"
+=09if ! _scratch_mount 2>/dev/null
+=09then
+=09=09echo "failed to mount $SCRATCH_DEV"
+=09=09exit 1
+=09fi
+
+=09# fix the reserve block pool to a known size so that the enospc
+=09# calculations work out correctly.
+=09_scratch_resvblks 1024 >  /dev/null 2>&1
+}
+
+_fill_scratch()
+{
+=09$XFS_IO_PROG -f -c "resvsp 0 ${1}" $SCRATCH_MNT/resvfile
+}
+
+_stress_scratch()
+{
+=09procs=3D3
+=09nops=3D1000
+=09# -w ensures that the only ops are ones which cause write I/O
+=09FSSTRESS_ARGS=3D`_scale_fsstress_args -d $SCRATCH_MNT -w -p $procs =
\
+=09    -n $nops $FSSTRESS_AVOID`
+=09$FSSTRESS_PROG $FSSTRESS_ARGS >> $seq.full &
+}
+
+# real QA test starts here
+_supported_fs xfs
+_require_scratch
+_scratch_mkfs_xfs | tee -a $seq.full | _filter_mkfs 2>$tmp.mkfs
+. $tmp.mkfs=09# extract blocksize and data size for scratch device
+
+endsize=3D`expr 550 \* 1048576`=09# stop after growing this big
+incsize=3D`expr  42 \* 1048576`=09# grow in chunks of this size
+modsize=3D`expr   4 \* $incsize`=09# pause after this many increments
+
+[ `expr $endsize / $dbsize` -lt $dblocks ] || _notrun "Scratch device =
too small"
+
+nags=3D4
+size=3D`expr 120 \* 1048576`=09# 120 megabytes initially
+sizeb=3D`expr $size / $dbsize`=09# in data blocks
+echo "*** creating scratch filesystem"
+_create_scratch -dsize=3D${size} -dagcount=3D${nags}
+
+fillsize=3D`expr 110 \* 1048576`=09# 110 megabytes of filling
+echo "*** using some initial space on scratch filesystem"
+_fill_scratch $fillsize
+
+#
+# Grow the filesystem while actively stressing it...
+# Kick off more stress threads on each iteration, grow; repeat.
+#
+while [ $size -le $endsize ]; do
+=09echo "*** stressing a ${size} byte filesystem"
+=09echo "*** stressing a ${sizeb} block filesystem" >> $seq.full
+=09_stress_scratch
+=09sleep 1
+=09size=3D`expr $size + $incsize`
+=09sizeb=3D`expr $size / $dbsize`=09# in data blocks
+=09echo "*** growing to a ${size} byte filesystem"
+=09echo "*** growing to a ${sizeb} block filesystem" >> $seq.full
+=09xfs_growfs -D ${sizeb} $SCRATCH_MNT \
+=09=09| tee -a $seq.full | _filter_mkfs 2>$tmp.growfs
+=09. $tmp.growfs
+=09[ `expr $size % $modsize` -eq 0 ] && wait=09# every 4th iteration
+=09echo AGCOUNT=3D$agcount | tee -a $seq.full
+=09echo && echo >> $seq.full
+done
+wait=09# stop for any remaining stress processes
+
+umount $SCRATCH_DEV
+_check_scratch_fs
+
+status=3D0
+exit
