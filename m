-seq=3D`basename $0`
-echo "QA output created by $seq"
-
-here=3D`pwd`
-tmp=3D/tmp/$$
-status=3D1=09# failure is the default!
-trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
-
-# get standard environment, filters and checks
-. ./common.rc
-. ./common.filter
-. ./common.quota
-
-_supported_fs xfs
-_supported_os Linux #IRIX
-_require_scratch
-_require_xfs_quota
-
-# real QA test starts here
-_scratch_mkfs_xfs | _filter_mkfs 2>$tmp.mkfs
-cat $tmp.mkfs >$seq.full
-. $tmp.mkfs
-
-# setup a default run
-if [ -z "$MOUNT_OPTIONS" ]; then
-=09export MOUNT_OPTIONS=3D"-o pquota,sync"
-else
-=09export MOUNT_OPTIONS=3D"$MOUNT_OPTIONS -o sync"
-fi
-
-_qmount
-_require_prjquota $SCRATCH_DEV
-
-# initial populate
-target=3D$SCRATCH_MNT/target
-$FSSTRESS_PROG -z -s 57069 -m 8 -n 1000 -p 4 \
--f allocsp=3D1 \
--f chown=3D3 \
--f creat=3D4 \
--f dwrite=3D4 \
--f fallocate=3D1 \
--f fdatasync=3D1 \
--f fiemap=3D1 \
--f freesp=3D1 \
--f fsync=3D1 \
--f link=3D1 \
--f mkdir=3D2 \
--f mknod=3D2 \
--f punch=3D1 \
--f rename=3D2 \
--f resvsp=3D1 \
--f rmdir=3D1 \
--f setxattr=3D1 \
--f symlink=3D2 \
--f sync=3D1 \
--f truncate=3D2 \
--f unlink=3D1 \
--f unresvsp=3D1 \
--f write=3D4 \
--d $target
-
-$FSSTRESS_PROG -z -s 57069 -m 8 -n 1000 -p 4 \
--f chown=3D500 \
--f setxattr=3D500 \
--d $target
-
-
-# also use space, to be able to go over/under limits easily
-uid=3D255
-gid=3D254
-prid=3D253
-rm -f $SCRATCH_MNT/resv
-$XFS_IO_PROG -fc "resvsp 0 200m" -c "chproj $prid" $SCRATCH_MNT/resv
-chown $uid $SCRATCH_MNT/resv
-chgrp $gid $SCRATCH_MNT/resv
-
-_qmount
-
-filter_xfs_quota()
-{
-=09perl -ne "
-s,$SCRATCH_MNT,[SCR_MNT],;
-s,$SCRATCH_DEV,[SCR_DEV],;
-s/Inode: \#\d+ \(0 blocks, 0 extents\)/Inode: #[INO] (0 blocks, 0 exte=
nts)/;
-s/Inode: \#\d+ \(\d+ blocks, \d+ extents\)/Inode: #[INO] (X blocks, Y =
extents)/;
-=09print;"
-}
-
-test_quot()
-{
-=09echo "checking quot command (type=3D$type)"  # not deterministic on=
 blks
-=09xfs_quota -x -c "quot -n -$type" $SCRATCH_MNT >>$seq.full 2>&1
-}
-
-test_report()
-{
-=09echo "checking report command (type=3D$type)"
-=09xfs_quota -x -c "report -h -$type -U 256" $SCRATCH_MNT
-}
-
-test_limit1()
-{
-=09echo "checking limit command, pass 1 (type=3D$type)"
-=09xfs_quota -x -c "limit -$type bsoft=3D100m bhard=3D100m ihard=3D2 $=
id" \
-=09=09$SCRATCH_MNT
-=09xfs_quota -x -c "limit -$type isoft=3D1 rtbsoft=3D100m rtbhard=3D11=
0m $id"\
-=09=09$SCRATCH_MNT
-=09sleep 2=09=09# let the timer day transition happen
-=09xfs_quota -x -c "quota -$type -b -hnv $id" $SCRATCH_MNT
-=09xfs_quota -x -c "quota -$type -i -hnv $id" $SCRATCH_MNT
-=09#xfs_quota -x -c "quota -$type -r -hnv $id" $SCRATCH_MNT
-}
-
-test_limit2()
-{
-=09# push limits up high, so that timers are cleared, etc. (for later)
-=09echo "checking limit command, pass2 (type=3D$type)"
-=09xfs_quota -x -c "limit -$type bsoft=3D300m bhard=3D400m ihard=3D880=
0 $id" \
-=09=09$SCRATCH_MNT
-=09xfs_quota -x -c "limit -$type isoft=3D8000 rtbsoft=3D310m rtbhard=
=3D410m $id"\
-=09=09$SCRATCH_MNT
-=09xfs_quota -x -c "quota -$type -b -hnv $id" $SCRATCH_MNT
-=09xfs_quota -x -c "quota -$type -i -hnv $id" $SCRATCH_MNT
-=09#xfs_quota -x -c "quota -$type -r -hnv $id" $SCRATCH_MNT
-}
-
-test_warn()
-{
-=09echo "checking warn command (type=3D$type)"
-=09xfs_quota -x -c "warn -$type -b 4 $id" $SCRATCH_MNT
-=09xfs_quota -x -c "warn -$type -i 3 $id" $SCRATCH_MNT
-=09#xfs_quota -x -c "warn -$type -r 2 $id" $SCRATCH_MNT
-=09xfs_quota -x -c "quota -$type -b -hnv $id" $SCRATCH_MNT
-=09xfs_quota -x -c "quota -$type -i -hnv $id" $SCRATCH_MNT
-=09#xfs_quota -x -c "quota -$type -r -hnv $id" $SCRATCH_MNT
-}
-
-test_timer()
-{
-=09echo "checking timer command (type=3D$type)"
-=09xfs_quota -x -c "timer -$type -b 3days" $SCRATCH_MNT
-=09xfs_quota -x -c "timer -$type -i 2days" $SCRATCH_MNT
-=09#xfs_quota -x -c "timer -$type -r 1day" $SCRATCH_MNT
-}
-
-test_state()
-{
-=09echo "checking state command (type=3D$type)"
-=09xfs_quota -x -c "state -$type" $SCRATCH_MNT
-=09# not yet working properly?
-=09#echo "checking disable command (type=3D$type)"
-=09#xfs_quota -x -c "disable -$type -v" $SCRATCH_MNT
-=09#echo "checking enable command (type=3D$type)"
-=09#xfs_quota -x -c "enable -$type -v" $SCRATCH_MNT
-=09#echo "checking off command (type=3D$type)"
-=09#xfs_quota -x -c "off -$type -v" $SCRATCH_MNT
-=09#echo "checking remove command (type=3D$type)"
-=09#xfs_quota -x -c "remove -$type -v" $SCRATCH_MNT
-}
-
-test_backup()
-{
-=09echo "checking dump command (type=3D$type)"
-=09rm -f $tmp.backup
-=09xfs_quota -x -c "dump -$type -f $tmp.backup -U 256" $SCRATCH_MNT
-=09cat $tmp.backup
-
-=09echo "changing limits (type=3D$type)"
-=09xfs_quota -x -c "limit -$type isoft=3D1000 ihard=3D1100 $id" $SCRAT=
CH_MNT
-=09xfs_quota -x -c "quota -$type -i -hnv $id" $SCRATCH_MNT
-
-=09echo "checking restore command (type=3D$type)"
-=09xfs_quota -x -c "restore -$type -f $tmp.backup" $SCRATCH_MNT
-=09xfs_quota -x -c "quota -$type -i -hnv $id" $SCRATCH_MNT
-=09rm -f $tmp.backup
-}
-
-test_xfs_quota()
-{
-=09test_quot=09; echo
-=09test_report=09; echo
-=09test_timer=09; echo
-=09test_limit1=09; echo
-=09test_warn=09; echo
-=09test_limit2=09; echo
-=09test_backup=09; echo
-=09test_state=09; echo
-=09echo=09=09; echo
-}
-
-# real QA test starts here
-export MOUNT_OPTIONS=3D"-ouquota,sync"
-_qmount
-type=3Du
-id=3D$uid
-test_xfs_quota | filter_xfs_quota
-
-export MOUNT_OPTIONS=3D"-ogquota,sync"
-_qmount
-type=3Dg
-id=3D$gid
-test_xfs_quota | filter_xfs_quota
-
-export MOUNT_OPTIONS=3D"-opquota,sync"
-_qmount
-type=3Dp
-id=3D$prid
-test_xfs_quota | filter_xfs_quota
-
-umount $SCRATCH_DEV
-status=3D0
-exit
