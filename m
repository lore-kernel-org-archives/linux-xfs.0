+=09$XFS_IO_PROG -f -d \
+=09=09  -c 'pwrite -b 52k 0 52k' \
+=09=09  -c "truncate $boundary_minus1" \
+                  -c 'pread -b 200k 0 200k' \
+=09=09  $testfile | _filter_io
+=09$XFS_IO_PROG -c 'bmap -vp' $testfile | _filter_bmap
+=09echo ""
+
