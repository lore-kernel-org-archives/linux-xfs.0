+#! /bin/bash
+# FSQA Test No. 276
+#
+# Run fsstress to create a reasonably strange file system, make a
+# snapshot and run more fsstress. Then select some files from that fs,
+# run filefrag to get the extent mapping and follow the backrefs.
+# We check to end up back at the original file with the correct offset=
.
+#
+#---------------------------------------------------------------------=
--
+# Copyright (C) 2011 STRATO.  All rights reserved.
+#
+# This program is free software; you can redistribute it and/or
+# modify it under the terms of the GNU General Public License as
+# published by the Free Software Foundation.
+#
+# This program is distributed in the hope that it would be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program; if not, write the Free Software Foundation,
+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1
+
+_cleanup()
+{
+=09echo "*** unmount"
+=09umount $SCRATCH_MNT 2>/dev/null
+=09rm -f $tmp.*
+}
+trap "_cleanup; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+
+# real QA test starts here
+_need_to_be_root
+_supported_fs btrfs
+_supported_os Linux
+_require_scratch
+
+_require_nobigloopfs
+_require_btrfs inspect-internal
+_require_command "/usr/sbin/filefrag"
+
+rm -f $seq.full
+
+FILEFRAG_FILTER=3D'if (/, blocksize (\d+)/) {$blocksize =3D $1; next} =
($ext, '\
+'$logical, $physical, $expected, $length, $flags) =3D (/^\s*(\d+)\s+(\=
d+)'\
+'\s+(\d+)\s+(?:(\d+)\s+)?(\d+)\s+(.*)/) or next; $flags =3D~ '\
+'/(?:^|,)inline(?:,|$)/ and next; print $physical * $blocksize, "#", '=
\
+'$length * $blocksize, "#", $logical * $blocksize, " "'
+
+# this makes filefrag output script readable by using a perl helper.
+# output is one extent per line, with three numbers separated by '#'
+# the numbers are: physical, length, logical (all in bytes)
+# sample output: "1234#10#5678" -> physical 1234, length 10, logical 5=
678
+_filter_extents()
+{
+=09tee -a $seq.full | $PERL_PROG -ne "$FILEFRAG_FILTER"
+}
+
+_check_file_extents()
+{
+=09cmd=3D"filefrag -v $1"
+=09echo "# $cmd" >> $seq.full
+=09out=3D`$cmd | _filter_extents`
+=09if [ -z "$out" ]; then
+=09=09return 1
+=09fi
+=09echo "after filter: $out" >> $seq.full
+=09echo $out
+=09return 0
+}
+
+# use a logical address and walk the backrefs back to the inode.
+# compare to the expected result.
+# returns 0 on success, 1 on error (with output made)
+_btrfs_inspect_addr()
+{
+=09mp=3D$1
+=09addr=3D$2
+=09expect_addr=3D$3
+=09expect_inum=3D$4
+=09file=3D$5
+=09cmd=3D"$BTRFS_UTIL_PROG inspect-internal logical-resolve -P $addr $=
mp"
+=09echo "# $cmd" >> $seq.full
+=09out=3D`$cmd`
+=09echo "$out" >> $seq.full
+=09grep_expr=3D"inode $expect_inum offset $expect_addr root"
+=09echo "$out" | grep "^$grep_expr 5$" >/dev/null
+=09ret=3D$?
+=09if [ $ret -eq 0 ]; then
+=09=09# look for a root number that is not 5
+=09=09echo "$out" | grep "^$grep_expr \([0-46-9][0-9]*\|5[0-9]\+\)$" \
+=09=09=09>/dev/null
+=09=09ret=3D$?
+=09fi
+=09if [ $ret -eq 0 ]; then
+=09=09return 0
+=09fi
+=09echo "unexpected output from"
+=09echo "=09$cmd"
+=09echo "expected inum: $expect_inum, expected address: $expect_addr,"=
\
+=09=09"file: $file, got:"
+=09echo "$out"
+=09return 1
+}
+
+# use an inode number and walk the backrefs back to the file name.
+# compare to the expected result.
+# returns 0 on success, 1 on error (with output made)
+_btrfs_inspect_inum()
+{
+=09file=3D$1
+=09inum=3D$2
+=09snap_name=3D$3
+=09mp=3D"$SCRATCH_MNT/$snap_name"
+=09cmd=3D"$BTRFS_UTIL_PROG inspect-internal inode-resolve $inum $mp"
+=09echo "# $cmd" >> $seq.full
+=09out=3D`$cmd`
+=09echo "$out" >> $seq.full
+=09grep_expr=3D"^$file$"
+=09cnt=3D`echo "$out" | grep "$grep_expr" | wc -l`
+=09if [ $cnt -ge "1" ]; then
+=09=09return 0
+=09fi
+=09echo "unexpected output from"
+=09echo "=09$cmd"
+=09echo "expected path: $file, got:"
+=09echo "$out"
+=09return 1
+}
+
+_btrfs_inspect_check()
+{
+=09file=3D$1
+=09physical=3D$2
+=09length=3D$3
+=09logical=3D$4
+=09snap_name=3D$5
+=09cmd=3D"stat -c %i $file"
+=09echo "# $cmd" >> $seq.full
+=09inum=3D`$cmd`
+=09echo "$inum" >> $seq.full
+=09_btrfs_inspect_addr $SCRATCH_MNT $physical $logical $inum $file
+=09ret=3D$?
+=09if [ $ret -eq 0 ]; then
+=09=09_btrfs_inspect_inum $file $inum $snap_name
+=09=09ret=3D$?
+=09fi
+=09return $ret
+}
+
+workout()
+{
+=09fsz=3D$1
+=09nfiles=3D$2
+=09procs=3D$3
+=09snap_name=3D$4
+
+=09umount $SCRATCH_DEV >/dev/null 2>&1
+=09echo "*** mkfs -dsize=3D$fsz"    >>$seq.full
+=09echo ""                                     >>$seq.full
+=09_scratch_mkfs_sized $fsz >>$seq.full 2>&1 \
+=09=09|| _fail "size=3D$fsz mkfs failed"
+=09run_check _scratch_mount
+=09# -w ensures that the only ops are ones which cause write I/O
+=09run_check $FSSTRESS_PROG -d $SCRATCH_MNT -w -p $procs -n 1000 \
+=09=09$FSSTRESS_AVOID
+
+=09run_check $BTRFS_UTIL_PROG subvol snap $SCRATCH_MNT \
+=09=09$SCRATCH_MNT/$snap_name
+
+=09run_check umount $SCRATCH_DEV >/dev/null 2>&1
+=09run_check _scratch_mount "-o compress=3Dlzo"
+
+=09# make some noise but ensure we're not touching existing data
+=09# extents.
+=09run_check $FSSTRESS_PROG -d $SCRATCH_MNT -p $procs -n 2000 \
+=09=09-z -f chown=3D3 -f link=3D1 -f mkdir=3D2 -f mknod=3D2 \
+=09=09-f rename=3D2 -f setxattr=3D1 -f symlink=3D2
+=09clean_dir=3D"$SCRATCH_MNT/next"
+=09mkdir $clean_dir
+=09# now make more files to get a higher tree
+=09run_check $FSSTRESS_PROG -d $clean_dir -w -p $procs -n 2000 \
+=09=09$FSSTRESS_AVOID
+=09run_check umount $SCRATCH_DEV >/dev/null 2>&1
+=09run_check _scratch_mount "-o atime"
+
+=09cnt=3D0
+=09errcnt=3D0
+=09dir=3D"$SCRATCH_MNT/$snap_name/"
+=09for file in `find $dir -name f\* -size +0 | sort -R`; do
+=09=09extents=3D`_check_file_extents $file`
+=09=09ret=3D$?
+=09=09if [ $ret -ne 0 ]; then
+=09=09=09continue;
+=09=09fi
+=09=09for i in $extents; do
+=09=09=09physical=3D$i
+=09=09=09length=3D$i
+=09=09=09logical=3D$i
+=09=09=09physical=3D`echo $physical | sed -e 's/#.*//'`
+=09=09=09length=3D`echo $length | sed -e 's/[^#]+#//'`
+=09=09=09length=3D`echo $length | sed -e 's/#.*//'`
+=09=09=09logical=3D`echo $logical | sed -e 's/.*#//'`
+=09=09=09_btrfs_inspect_check $file $physical $length $logical \
+=09=09=09=09=09=09$snap_name
+=09=09=09ret=3D$?
+=09=09=09if [ $ret -ne 0 ]; then
+=09=09=09=09errcnt=3D`expr $errcnt + 1`
+=09=09=09fi
+=09=09done
+=09=09cnt=3D`expr $cnt + 1`
+=09=09if [ $cnt -ge $nfiles ]; then
+=09=09=09break
+=09=09fi
+=09done
+=09if [ $errcnt -gt 0 ]; then
+=09=09_fail "test failed: $errcnt error(s)"
+=09fi
+}
+
+echo "*** test backref walking"
+
+snap_name=3D"snap1"
+filesize=3D`expr 2000 \* 1024 \* 1024`
+nfiles=3D4
+numprocs=3D1
+
+workout $filesize $nfiles $numprocs $snap_name
+
+echo "*** done"
+status=3D0
+exit
