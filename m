+#! /bin/bash
+# FS QA Test No. 106
+#
+# Exercise basic xfs_quota functionality (user/group/project quota)
+# Use of "sync" mount option here is an attempt to get deterministic
+# allocator behaviour.
+#
+#---------------------------------------------------------------------=
--
