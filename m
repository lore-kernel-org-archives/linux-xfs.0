+_require_prjquota ${SCRATCH_DEV}
+
+dir=3D$SCRATCH_MNT/project
+
+status=3D0
+
+echo "Silence is golden"
+
+# Do testing on filesystem with projid32bit feature disabled
+mkdir $dir
+
+touch $dir/below16bit
+# below 16bit value
+$XFS_QUOTA_PROG -x -c "project -s -p $dir/below16bit 3422" $SCRATCH_DE=
V \
+=09=09>> $seq.full
+projid=3D$($XFS_IO_PROG -r -c "lsproj" $dir/below16bit)
+if [ "projid =3D 3422" !=3D "$projid" ]; then
