+# Inc.,  51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+#
+#---------------------------------------------------------------------=
--
+#
+
+seq=3D`basename $0`
+echo "QA output created by $seq"
+
+here=3D`pwd`
+tmp=3D/tmp/$$
+status=3D1=09# failure is the default!
+trap "rm -f $tmp.*; exit \$status" 0 1 2 3 15
+
+# get standard environment, filters and checks
+. ./common.rc
+. ./common.filter
+. ./common.log
+
+# real QA test starts here
+_supported_fs xfs
+_supported_os IRIX Linux
+
+rm -f $seq.full $tmp.*
+_require_scratch
+_require_v2log
+
+echo "*** init FS"
+umount $SCRATCH_DEV >/dev/null 2>&1
+
+cat >$tmp.seq.params <<EOF
+# mkfs-opt             mount-opt
+# ------------------------------
+  version=3D2            logbsize=3D32k
+  version=3D2,su=3D4096    logbsize=3D32k
+  version=3D2,su=3D32768   logbsize=3D32k
+  version=3D2,su=3D32768   logbsize=3D64k
+  version=3D2            logbsize=3D64k
+  version=3D2,su=3D64k     logbsize=3D64k
+  version=3D2            logbsize=3D128k
+  version=3D2,su=3D128k    logbsize=3D128k
+  version=3D2            logbsize=3D256k
+  version=3D2,su=3D256k    logbsize=3D256k
+EOF
+
+# Do the work for various log params which
+# should not effect the data content of the log
+# Try with and without sync'ing - sync'ing will mean that
+# the log will be written out unfilled and thus the log=20
+# stripe can have an effect.
+#
+for s in sync nosync ; do
+    cat $tmp.seq.params \
+    | while read mkfs mnt restofline
+    do
+=09if [ "$mkfs" =3D "#" ]; then=20
+=09    continue
+=09fi
+
+=09echo "--- mkfs=3D$mkfs, mnt=3D$mnt, sync=3D$s ---"
+=09export MKFS_OPTIONS=3D"-l $mkfs"
+=09export MOUNT_OPTIONS=3D"-o $mnt"
+
+=09# mkfs the FS
+=09_echofull "mkfs"
+=09_scratch_mkfs_xfs >>$seq.full 2>&1
+=09if [ $? -ne 0 ] ; then=20
+=09    _echofull "mkfs failed: $MKFS_OPTIONS"
+=09    continue
+=09fi
+
+=09# mount the FS
+=09_echofull "mount"
+=09if ! _scratch_mount >>$seq.full 2>&1; then
+=09    _echofull "mount failed: $MOUNT_OPTIONS"
+=09    continue
