+=09_notrun "no mkfs support for NFS v4 ACLs"
+fi
+
+_scratch_mount 2>/dev/null
+if [ $? -ne 0 ]
+then
+=09_notrun "no kernel mount support for NFS v4 ACLs"
+fi
+
+set_prog_path nfs4acl >>$seq.full
+if [ $? -ne 0 ]
+then
+=09_notrun "no nfs4acl utility found"
+fi
+
+cd $SCRATCH_MNT
+for file in $here/nfs4acl/*.test
+do
+=09print_file=3D`echo $file | sed 's/.*nfs4acl/nfs4acl/'`
+=09echo ""
+=09echo "*** $print_file ***"
+=09echo ""
+=09$here/nfs4acl/run $file
+done
+
+# success, all done
+status=3D0
+exit
